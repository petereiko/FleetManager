                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tripId" value="@Model.Id" />
                    <input type="hidden" name="isApproved" value="true" id="approveFlag" />
                    <input type="hidden" name="comments" id="approveComments" />
                    <button type="button" class="btn btn-success me-1" id="btnApprove">Approve</button>
                    <button type="button" class="btn btn-danger" id="btnReject">Reject</button>
                </form>
            }

            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this trip?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-danger ms-2">Delete</button>
            </form>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Trip Details</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Vehicle</dt>
                        <dd class="col-sm-9">@Model.VehiclePlateNo (@Model.VehicleMake @Model.VehicleModel)</dd>

                        <dt class="col-sm-3">Driver</dt>
                        <dd class="col-sm-9">@Model.DriverName</dd>

                        <dt class="col-sm-3">Origin</dt>
                        <dd class="col-sm-9">@Model.Origin</dd>

                        <dt class="col-sm-3">Destination</dt>
                        <dd class="col-sm-9">@Model.Destination</dd>

                        <dt class="col-sm-3">Scheduled</dt>
                        <dd class="col-sm-9">@Model.ScheduledStartDate.ToLocalTime() - @Model.ScheduledEndDate.ToLocalTime()</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">@Model.StatusDisplay</dd>

                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9">@Model.Notes</dd>
                    </dl>
                </div>
            </div>

            <!-- Expenses -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Expenses</strong>
                    <small class="text-muted">Total: --</small>
                </div>
                <div class="card-body" id="expensesContainer">
                    <!-- if you have a JSON endpoint to get expenses, you can load here via AJAX.
                         For now, we show a placeholder / call a server-side included partial if available -->
                    <p class="text-muted">Expenses will show here (server-side partial or AJAX load)</p>
                </div>
            </div>

            <!-- Checkpoints -->
            <div class="card mb-3">
                <div class="card-header"><strong>Checkpoints</strong></div>
                <div class="card-body" id="checkpointsContainer">
                    <p class="text-muted">Checkpoints will show here (server-side partial or AJAX load)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>Quick Actions</strong></div>
                <div class="card-body">
                    <p><strong>Trip #</strong><br />@Model.TripNumber</p>
                    <p><strong>Created</strong><br />@Model.CreatedDate.ToLocalTime().ToString("g")</p>

                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this trip?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger w-100 mb-2">Delete</button>
                    </form>

                    @if (Model.RequiresApproval && !Model.IsApproved.GetValueOrDefault(false))
                    {
                        <form method="post" asp-action="Approve" asp-route-tripId="@Model.Id" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isApproved" value="true" />
                            <input type="hidden" name="comments" value="Approved by admin" />
                            <button class="btn btn-success w-100">Approve</button>
                        </form>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><strong>Assignment</strong></div>
                <div class="card-body">
                    <p><strong>Driver:</strong> @Model.DriverName</p>
                    <p><strong>Assigned Date:</strong> @(Model.AssignedDate?.ToLocalTime().ToString("g") ?? "Not assigned")</p>
                    <a class="btn btn-outline-secondary w-100 mb-2" id="openAssignBtn2" data-tripid="@Model.Id">Assign / Reassign</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal used to load the Assign partial -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body" id="assignModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts: jQuery, Bootstrap JS, geolocation helper and AJAX wiring -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Geolocation helper used on Start / Complete pages
    function tryFillGeolocation(latSelector, lonSelector) {
        if (!navigator.geolocation) {
            console.warn('Geolocation not available');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (pos) {
            var lat = pos.coords.latitude;
            var lon = pos.coords.longitude;
            $(latSelector).val(lat);
            $(lonSelector).val(lon);
        }, function (err) {
            console.warn('Geolocation denied or failed', err);
        }, { enableHighAccuracy: true, timeout: 5000 });
    }

    // load assign partial into modal
    $(function () {

        function showAssignLoading() {
            $('#assignModalBody').html('<div class="text-center py-5"><div class="spinner-border" role="status"></div></div>');
        }

        function loadAssignModal(tripId) {
            var url = '@Url.Action("Assign", "AdminTrips")' + '?id=' + tripId;
            

            showAssignLoading();
            $('#assignModal').modal('show');
            $.get(url, function (html) {
                $('#assignModalBody').html(html);
            }).fail(function (xhr) {
                $('#assignModalBody').html('<div class="p-3 text-danger">Failed to load assign form: ' + (xhr.responseText || xhr.statusText) + '</div>');
            });
        }

        $('#openAssignBtn, #openAssignBtn2').on('click', function (e) {
            e.preventDefault();
            var tripId = $(this).data('tripid');
            if (!tripId) return;
            loadAssignModal(tripId);
        });

        // handle assignment submit (partial contains #assignForm)
        $(document).on('submit', '#assignForm', function (e) {
            e.preventDefault();
            var $form = $(this);
            var action = $form.attr('action') || '@Url.Action("Assign", "AdminTrips")';
            var $submit = $form.find('button[type="submit"]').first();
            // remove any previous alert
            $form.find('#assignFormAlert').remove();
            $submit.prop('disabled', true).addClass('disabled');
            $.post(action, $form.serialize())
                .done(function () {
                    // close modal, reload page to reflect assignment
                    $('#assignModal').modal('hide');
                    location.reload();
                })
                .fail(function (xhr) {
                    var err = xhr.responseText || 'Failed to assign';
                    $form.prepend('<div id="assignFormAlert" class="alert alert-danger">' + err + '</div>');
                })
                .always(function () {
                    $submit.prop('disabled', false).removeClass('disabled');
                });
        });

        // APPROVE / REJECT wiring
        // expects a form with id="approveForm" that contains anti-forgery token and hidden inputs:
        // <input type="hidden" name="tripId" value="..." />
        // <input type="hidden" name="isApproved" value="true" id="approveFlag" />
        // <input type="hidden" name="comments" id="approveComments" />
        $(document).on('click', '#btnApprove', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var $form = $('#approveForm');
            if (!$form.length) {
                alert('Approve form not found.');
                return;
            }

            // clear any previous message
            $('#approveAlert').remove();

            // set values
            $('#approveFlag').val('true');
            $('#approveComments').val('Approved by admin');

            $btn.prop('disabled', true);
            $.post('@Url.Action("Approve", "AdminTrips")', $form.serialize())
                .done(function () {
                    location.reload();
                })
                .fail(function (xhr) {
                    var msg = xhr.responseText || 'Failed to approve';
                    $form.prepend('<div id="approveAlert" class="alert alert-danger">' + msg + '</div>');
                })
                .always(function () {
                    $btn.prop('disabled', false);
                });
        });

        $(document).on('click', '#btnReject', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var $form = $('#approveForm');
            if (!$form.length) {
                alert('Approve form not found.');
                return;
            }

            // ask for reason (optional)
            var reason = prompt('Please enter a rejection reason (optional):');
            if (reason === null) {
                // user cancelled prompt
                return;
            }

            // clear previous alert
            $('#approveAlert').remove();

            $('#approveFlag').val('false');
            $('#approveComments').val(reason || '');

            $btn.prop('disabled', true);
            $.post('@Url.Action("Approve", "AdminTrips")', $form.serialize())
                .done(function () {
                    location.reload();
                })
                .fail(function (xhr) {
                    var msg = xhr.responseText || 'Failed to reject';
                    $form.prepend('<div id="approveAlert" class="alert alert-danger">' + msg + '</div>');
                })
                .always(function () {
                    $btn.prop('disabled', false);
                });
        });

    });
</script>
 *@