@using FleetManager.Business.DataObjects.VehicleDto
@using FleetManager.Business.Enums
@model VehicleEditViewModel

@{
    ViewData["Title"] = "Add Vehicle";
    int motorcycleValue = (int)VehicleType.Motorcycle;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@simonwep/pickr/dist/themes/classic.min.css" />

<div class="content">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="page-title">Add Vehicle</h3>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Vehicles</a></li>
                    <li class="breadcrumb-item"><i class="feather-chevron-right"></i></li>
                    <li class="breadcrumb-item active">Add Vehicle</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-12">
                                <div class="form-heading">
                                    <h4>Vehicle Details</h4>
                                </div>
                            </div>

                            <partial name="_ValidationSummary" />

                            <!-- Vehicle Type -->
                            <div class="col-md-4">
                                <div class="input-block local-forms">
                                    <label asp-for="VehicleType">
                                        Vehicle Type <span class="login-danger">*</span>
                                        <small class="text-muted ms-1">(select this first)</small>
                                    </label>
                                    <select asp-for="VehicleType" class="form-control"
                                            asp-items="Model.VehicleTypes" id="vehicleTypeSelect">
                                        <option value="">— Select Type First —</option>
                                    </select>
                                    <span asp-validation-for="VehicleType" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- ── Make/Model section — shown after type selected ── -->
                            <div id="makeModelSection" class="col-12" style="display:none;">

                                <!-- Mode toggle — hidden for motorcycle, shown for all others -->
                                <div id="makeModelToggle" class="col-12 mb-2" style="display:none;">
                                    <div class="d-flex align-items-center gap-3 ps-3">
                                        <span class="text-muted small fw-semibold">Make &amp; Model:</span>
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input" type="radio" name="makeModelMode"
                                                   id="modeDropdown" value="dropdown" checked />
                                            <label class="form-check-label" for="modeDropdown">
                                                Select from list
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input" type="radio" name="makeModelMode"
                                                   id="modeManual" value="manual" />
                                            <label class="form-check-label" for="modeManual">
                                                Enter manually
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dropdown panel (standard vehicles, dropdown mode) -->
                                <div id="standardMakeModelPanel" class="col-12 row g-0 pe-0" style="display:none;">
                                    <div class="col-md-4 ps-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="VehicleMakeId">Make <span class="login-danger">*</span></label>
                                            <select asp-for="VehicleMakeId" asp-items="Model.Makes"
                                                    class="form-control select2" id="vehicleMake">
                                                <option value="">Search Your Vehicle Make</option>
                                            </select>
                                            <span asp-validation-for="VehicleMakeId" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 ps-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="VehicleModelId">Model <span class="login-danger">*</span></label>
                                            <select asp-for="VehicleModelId" asp-items="Model.Models"
                                                    class="form-control select2" id="vehicleModel">
                                                <option value="">Select Model</option>
                                            </select>
                                            <span asp-validation-for="VehicleModelId" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Manual panel (motorcycles always, others when "Enter manually" chosen) -->
                                <div id="manualMakeModelPanel" class="col-12 row g-0 pe-0" style="display:none;">
                                    <div class="col-md-4 ps-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="CustomMakeName">
                                                Make <span class="login-danger">*</span>
                                                <small class="text-muted" id="customMakeHint">(e.g. Toyota, Ford)</small>
                                            </label>
                                            <input asp-for="CustomMakeName" class="form-control"
                                                   placeholder="Enter make name" id="customMakeInput" />
                                            <span asp-validation-for="CustomMakeName" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 ps-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="CustomModelName">
                                                Model <span class="login-danger">*</span>
                                            </label>
                                            <input asp-for="CustomModelName" class="form-control"
                                                   placeholder="Enter model name" id="customModelInput" />
                                            <span asp-validation-for="CustomModelName" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 ps-3 d-flex align-items-center" id="manualInfoBox">
                                        <div class="alert alert-info py-2 px-3 mb-0 w-100" role="alert" style="font-size:.85rem;">
                                            <i class="feather-info me-1"></i>
                                            <span id="manualInfoText">Enter the make and model name exactly as you know them.</span>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- /makeModelSection -->
                            <!-- Rest of form — hidden until vehicle type is selected -->
                            <div id="restOfForm" style="display:none;" class="col-12">
                                <div class="row">

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="Year">Year <span class="login-danger">*</span></label>
                                            <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2022" />
                                            <span asp-validation-for="Year" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="VIN">VIN <span class="login-danger">*</span></label>
                                            <input asp-for="VIN" class="form-control" placeholder="Vehicle Identification Number" />
                                            <span asp-validation-for="VIN" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="PlateNo">Plate No <span class="login-danger">*</span></label>
                                            <input asp-for="PlateNo" class="form-control" placeholder="e.g. ABC-1234" />
                                            <span asp-validation-for="PlateNo" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6 col-xl-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="Color">Color <span class="login-danger">*</span></label>
                                            <div class="d-flex align-items-center gap-2">
                                                <div id="colorPickerContainer"
                                                     style="width:36px;height:36px;border:1px solid #ccc;cursor:pointer;border-radius:4px;"></div>
                                                <span id="colorHexLabel" class="text-muted small">#000000</span>
                                            </div>
                                            <input asp-for="Color" type="hidden" id="colorInput" />
                                            <span asp-validation-for="Color" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="EngineNumber">Engine Number</label>
                                            <input asp-for="EngineNumber" class="form-control" placeholder="Engine number" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="ChassisNumber">Chassis Number</label>
                                            <input asp-for="ChassisNumber" class="form-control" placeholder="Chassis number" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms cal-icon">
                                            <label asp-for="RegistrationDate">Registration Date</label>
                                            <input asp-for="RegistrationDate" class="form-control datetimepicker" placeholder="YYYY-MM-DD" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms cal-icon">
                                            <label asp-for="LastServiceDate">Last Service Date</label>
                                            <input asp-for="LastServiceDate" class="form-control datetimepicker" placeholder="YYYY-MM-DD" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="Mileage">Mileage</label>
                                            <input asp-for="Mileage" type="number" class="form-control" placeholder="e.g. 35000" />
                                            <span asp-validation-for="Mileage" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="FuelType">Fuel Type</label>
                                            <select asp-for="FuelType" class="form-control" asp-items="Model.FuelTypes">
                                                <option value="">Select Fuel</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="TransmissionType">Transmission</label>
                                            <select asp-for="TransmissionType" class="form-control" asp-items="Model.TransmissionTypes">
                                                <option value="">Select Transmission</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="input-block local-forms">
                                            <label asp-for="VehicleStatus">Status</label>
                                            <select asp-for="VehicleStatus" class="form-control" asp-items="Model.Statuses">
                                                <option value="">Select Status</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="CompanyBranchId">Branch <span class="login-danger">*</span></label>
                                            <select asp-for="CompanyBranchId" class="form-control" asp-items="Model.Branches">
                                                <option value="">Select Branch</option>
                                            </select>
                                            <span asp-validation-for="CompanyBranchId" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms">
                                            <label asp-for="InsuranceCompany">Insurance Company</label>
                                            <input asp-for="InsuranceCompany" class="form-control" placeholder="Insurance company" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms cal-icon">
                                            <label asp-for="InsuranceExpiryDate">Insurance Expiry</label>
                                            <input asp-for="InsuranceExpiryDate" class="form-control datetimepicker" placeholder="YYYY-MM-DD" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="input-block local-forms cal-icon">
                                            <label asp-for="RoadWorthyExpiryDate">Road-Worthy Expiry</label>
                                            <input asp-for="RoadWorthyExpiryDate" class="form-control datetimepicker" placeholder="YYYY-MM-DD" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="input-block local-forms">
                                            <label asp-for="PhotoFiles">Upload Photos</label>
                                            <input asp-for="PhotoFiles" type="file" multiple class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="input-block local-forms">
                                            <label asp-for="DocumentFiles">Upload Documents</label>
                                            <input asp-for="DocumentFiles" type="file" multiple class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-12 text-end mt-4">
                                        <button type="submit" class="btn btn-primary submit-form me-2">
                                            <i class="feather-plus me-1"></i> Add Vehicle
                                        </button>
                                        <a asp-action="Index" class="btn btn-secondary cancel-form">
                                            <i class="feather-x me-1"></i> Cancel
                                        </a>
                                    </div>

                                </div>
                            </div><!-- /restOfForm -->
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@simonwep/pickr"></script>

    <script>
        var MOTORCYCLE_VALUE = '@motorcycleValue';

        // ── Returns current mode: 'dropdown' | 'manual' | 'motorcycle' ────────
        function getMode() {
            var val = $('#vehicleTypeSelect').val();
            if (!val) return 'none';
            if (val === MOTORCYCLE_VALUE) return 'motorcycle';
            return $('input[name="makeModelMode"]:checked').val() || 'dropdown';
        }

        // ── Apply correct panels based on type + mode ─────────────────────────
        function applyLayout() {
            var val  = $('#vehicleTypeSelect').val();
            var mode = getMode();

            if (!val) {
                $('#makeModelSection, #restOfForm').hide();
                return;
            }

            $('#makeModelSection, #restOfForm').show();

            if (mode === 'motorcycle') {
                // Hide toggle, show manual only
                $('#makeModelToggle').hide();
                $('#standardMakeModelPanel').hide();
                $('#manualMakeModelPanel').show();
                // Update hint text for motorcycle
                $('#customMakeHint').text('(e.g. Yamaha, Honda)');
                document.getElementById('customMakeInput').placeholder = 'e.g. Yamaha';
                document.getElementById('customModelInput').placeholder = 'e.g. MT-07, CB500';
                document.getElementById('manualInfoText').textContent =
                    'Motorcycle make & model are entered manually — bike catalogues are not in the vehicle database.';
                // Disable dropdown fields so they don't submit
                $('#vehicleMake, #vehicleModel').prop('disabled', true);
                $('#customMakeInput, #customModelInput').prop('disabled', false);

            } else if (mode === 'dropdown') {
                $('#makeModelToggle').show();
                $('#manualMakeModelPanel').hide();
                $('#standardMakeModelPanel').show();
                $('#vehicleMake, #vehicleModel').prop('disabled', false);
                $('#customMakeInput, #customModelInput').prop('disabled', true).val('');

            } else { // manual
                $('#makeModelToggle').show();
                $('#standardMakeModelPanel').hide();
                $('#manualMakeModelPanel').show();
                // Generic hint for non-motorcycle manual entry
                $('#customMakeHint').text('(e.g. Toyota, Ford)');
                document.getElementById('customMakeInput').placeholder = 'Enter make name';
                document.getElementById('customModelInput').placeholder = 'Enter model name';
                document.getElementById('manualInfoText').textContent =
                    'Enter the make and model name exactly as you know them — use this when your vehicle is not in our list.';
                $('#vehicleMake, #vehicleModel').prop('disabled', true);
                $('#customMakeInput, #customModelInput').prop('disabled', false);
            }
        }

        $(document).ready(function () {
            $('#vehicleMake, #vehicleModel').select2({ width: '100%', placeholder: 'Search…', allowClear: true });

            // Type change
            $('#vehicleTypeSelect').on('change', function () {
                var val = $(this).val();
                // Reset mode to dropdown when switching to non-motorcycle
                if (val !== MOTORCYCLE_VALUE) {
                    $('#modeDropdown').prop('checked', true);
                }
                // Clear all make/model inputs on type switch
                $('#vehicleMake').val(null).trigger('change');
                $('#vehicleModel').empty().append('<option value="">Select Model</option>').trigger('change');
                $('#customMakeInput, #customModelInput').val('');
                applyLayout();
            });

            // Mode radio toggle
            $('input[name="makeModelMode"]').on('change', function () {
                // Clear the fields for the mode being left
                if ($(this).val() === 'dropdown') {
                    $('#customMakeInput, #customModelInput').val('');
                } else {
                    $('#vehicleMake').val(null).trigger('change');
                    $('#vehicleModel').empty().append('<option value="">Select Model</option>').trigger('change');
                }
                applyLayout();
            });

            // Make dropdown change → load models
            $('#vehicleMake').on('change', function () {
                var makeId = $(this).val();
                var $model = $('#vehicleModel');
                if (!makeId) {
                    $model.empty().append('<option value="">Select Model</option>').trigger('change');
                    return;
                }
                $model.empty().append('<option value="">Loading…</option>').trigger('change');
                $.ajax({
                    url: '@Url.Action("GetVehicleModels", "AdminVehicle")',
                    data: { makeId: makeId },
                    success: function (data) {
                        $model.empty().append('<option value="">Select Model</option>');
                        $.each(data, function (i, item) {
                            $model.append($('<option>', { value: item.value, text: item.text }));
                        });
                    },
                    error: function () { console.error('Could not load vehicle models.'); },
                    complete: function () { $model.trigger('change'); }
                });
            });

            applyLayout();

            flatpickr('.datetimepicker', { dateFormat: 'Y-m-d' });

            var colorInput = document.getElementById('colorInput');
            var pickr = Pickr.create({
                el: '#colorPickerContainer',
                theme: 'classic',
                default: '#000000',
                components: {
                    preview: true, opacity: true, hue: true,
                    interaction: { hex: true, rgba: true, input: true, save: true }
                }
            });
            function syncColor(color) {
                var hex = color.toHEXA().toString();
                colorInput.value = hex;
                document.getElementById('colorPickerContainer').style.background = hex;
                document.getElementById('colorHexLabel').textContent = hex;
            }
            pickr.on('save',   (c, inst) => { syncColor(c); inst.hide(); });
            pickr.on('change', (c)        => syncColor(c));
            document.querySelector('form').addEventListener('submit', function () {
                var c = pickr.getColor();
                if (c) colorInput.value = c.toHEXA().toString();
            });
        });
    </script>
}

