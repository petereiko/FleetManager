@using FleetManager.Business.DataObjects
@model ContactDirectoryDto

<form id="ratingForm" method="post" action="@Url.Action("SubmitRating", "ContactDirectory")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ContactId" value="@Model.Id" />

    <div class="modal fade" tabindex="-1" id="ratingModal" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-gradient-primary text-white">
                    <div class="d-flex align-items-center">
                        <div class="rating-avatar-circle me-3">
                            @(Model.ContactName?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                        <div>
                            <h5 class="modal-title mb-0">Rate Contact</h5>
                            <small class="opacity-75">@Model.ContactName - @Model.VendorName</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Current Rating Display (if exists) -->
                    @if (Model.AverageRating > 0)
                    {
                        <div class="current-rating-section mb-4">
                            <div class="text-center">
                                <h6 class="text-muted mb-2">Current Rating</h6>
                                <div class="current-rating-display mb-2">
                                    <div class="rating-stars-display" data-rating="@Model.AverageRating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="rating-star-display fas fa-star"></i>
                                        }
                                    </div>
                                    <div class="rating-info mt-2">
                                        <span class="rating-average">@Model.AverageRating.ToString("F1")</span>
                                        <span class="text-muted">(@Model.RatingCount review@(Model.RatingCount != 1 ? "s" : ""))</span>
                                    </div>
                                </div>
                            </div>
                            <hr>
                        </div>
                    }

                    <!-- Your Rating Section -->
                    <div class="your-rating-section">
                        <h6 class="text-center mb-3 text-primary">Your Rating</h6>

                        <div class="star-rating-container">
                            <div class="star-rating" id="starRating">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" id="star-@i" name="Rating" value="@i" class="star-input" />
                                    <label for="star-@i" class="star-label" data-rating="@i">
                                        <i class="fas fa-star"></i>
                                    </label>
                                }
                            </div>

                            <div class="rating-feedback text-center mt-3">
                                <div class="rating-text" id="ratingText"></div>
                                <div class="selected-rating" id="selectedRating"></div>
                            </div>
                        </div>

                        <!-- Comment Section -->
                        <div class="comment-section mt-4">
                            <label for="ratingComment" class="form-label">
                                <i class="fas fa-comment me-2"></i>Comment (Optional)
                            </label>
                            <textarea name="Comment" id="ratingComment" class="form-control"
                                      placeholder="Share your experience with this contact..."
                                      rows="3"></textarea>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Your feedback helps improve our contact directory
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" id="submitRatingBtn">
                        <i class="fas fa-star me-2"></i>Submit Rating
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    }

    .rating-avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1.2rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

    /* Current Rating Display */
    .rating-stars-display {
        display: flex;
        justify-content: center;
        gap: 3px;
        margin-bottom: 8px;
    }

    .rating-star-display {
        font-size: 20px;
        color: #ddd;
        transition: color 0.2s ease;
    }

        .rating-star-display.filled {
            color: #ffc107;
        }

    .rating-average {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
    }

    /* Interactive Star Rating */
    .star-rating-container {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .star-rating-container:hover {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .star-rating {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 15px;
    }

    .star-input {
        display: none;
    }

    .star-label {
        cursor: pointer;
        font-size: 32px;
        color: #ddd;
        transition: all 0.3s ease;
        position: relative;
        display: inline-block;
    }

        .star-label:hover {
            transform: scale(1.2);
            color: #ffc107;
        }

            .star-label:hover::after {
                content: '';
                position: absolute;
                top: -5px;
                left: 50%;
                transform: translateX(-50%);
                width: 40px;
                height: 40px;
                background: rgba(255, 193, 7, 0.2);
                border-radius: 50%;
                z-index: -1;
                animation: pulse 0.6s ease-in-out infinite alternate;
            }

    @@keyframes pulse {
        0%

    {
        transform: translateX(-50%) scale(0.8);
        opacity: 0.5;
    }

    100% {
        transform: translateX(-50%) scale(1.2);
        opacity: 0.8;
    }

    }

    .star-input:checked ~ .star-label,
    .star-label:hover ~ .star-label {
        color: #ffc107;
    }

    .star-input:checked + .star-label {
        color: #ffc107;
        transform: scale(1.1);
    }

    .rating-feedback {
        min-height: 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .rating-text {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
    }

        .rating-text.show {
            opacity: 1;
            transform: translateY(0);
        }

    .selected-rating {
        color: #666;
        font-size: 0.9rem;
        opacity: 0;
        transition: all 0.3s ease;
    }

        .selected-rating.show {
            opacity: 1;
        }

    /* Comment Section */
    .comment-section {
        background: white;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #e9ecef;
    }

        .comment-section .form-control {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .comment-section .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            }

    /* Submit Button Enhancement */
    #submitRatingBtn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    #submitRatingBtn:not(:disabled) {
        animation: glow 2s ease-in-out infinite alternate;
    }

    @@keyframes glow {
        from

    {
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
    }

    to {
        box-shadow: 0 0 20px rgba(0, 123, 255, 0.8), 0 0 30px rgba(0, 123, 255, 0.4);
    }

    }

    /* Modal Enhancements */
    .modal-content {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        border-bottom: none;
        padding: 20px 24px 15px;
    }

    .modal-footer {
        border-top: 1px solid #e9ecef;
        padding: 15px 24px 20px;
    }

    /* Responsive Design */
    @@media (max-width: 576px) {
        .star-label

    {
        font-size: 28px;
    }

    .star-rating {
        gap: 6px;
    }

    .rating-avatar-circle {
        width: 40px;
        height: 40px;
        font-size: 1rem;
    }

    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Rating text feedback
        const ratingTexts = {
            1: { text: "Poor", subtext: "Not satisfied with this contact" },
            2: { text: "Fair", subtext: "Below average experience" },
            3: { text: "Good", subtext: "Average experience" },
            4: { text: "Very Good", subtext: "Above average experience" },
            5: { text: "Excellent", subtext: "Outstanding contact!" }
        };

        const starInputs = document.querySelectorAll('.star-input');
        const starLabels = document.querySelectorAll('.star-label');
        const ratingText = document.getElementById('ratingText');
        const selectedRating = document.getElementById('selectedRating');
        const submitBtn = document.getElementById('submitRatingBtn');

        // Initialize current rating display
        const currentRatingDisplay = document.querySelector('.rating-stars-display');
        if (currentRatingDisplay) {
            const rating = parseFloat(currentRatingDisplay.dataset.rating);
            const stars = currentRatingDisplay.querySelectorAll('.rating-star-display');

            stars.forEach((star, index) => {
                if (index < Math.floor(rating)) {
                    star.classList.add('filled');
                } else if (index < rating) {
                    // Partial star (you can implement this if needed)
                    star.classList.add('filled');
                    star.style.opacity = (rating - Math.floor(rating)).toString();
                }
            });
        }

        // Handle star selection
        starInputs.forEach((input, index) => {
            input.addEventListener('change', function() {
                const rating = parseInt(this.value);
                const feedback = ratingTexts[rating];

                // Update feedback text
                ratingText.textContent = feedback.text;
                ratingText.className = 'rating-text show';
                selectedRating.textContent = feedback.subtext;
                selectedRating.className = 'selected-rating show';

                // Enable submit button
                submitBtn.disabled = false;

                // Add visual feedback
                starLabels.forEach((label, labelIndex) => {
                    if (labelIndex >= (5 - rating)) {
                        label.style.color = '#ffc107';
                        label.style.transform = 'scale(1.1)';
                    } else {
                        label.style.color = '#ddd';
                        label.style.transform = 'scale(1)';
                    }
                });
            });
        });

        // Handle star hover effects
        starLabels.forEach((label, index) => {
            label.addEventListener('mouseenter', function() {
                const rating = parseInt(this.dataset.rating);

                // Preview rating text
                if (!document.querySelector('.star-input:checked')) {
                    const feedback = ratingTexts[rating];
                    ratingText.textContent = feedback.text;
                    ratingText.className = 'rating-text show';
                    selectedRating.textContent = 'Click to select this rating';
                    selectedRating.className = 'selected-rating show';
                }
            });

            label.addEventListener('mouseleave', function() {
                // If no rating selected, hide preview
                if (!document.querySelector('.star-input:checked')) {
                    ratingText.className = 'rating-text';
                    selectedRating.className = 'selected-rating';
                }
            });
        });

        // Form submission with validation
        document.getElementById('ratingForm').addEventListener('submit', function(e) {
            const selectedRating = document.querySelector('.star-input:checked');
            if (!selectedRating) {
                e.preventDefault();
                alert('Please select a rating before submitting.');
                return;
            }

            // Add loading state
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';
        });

        // Reset form when modal is closed
        document.getElementById('ratingModal').addEventListener('hidden.bs.modal', function() {
            // Reset form
            document.getElementById('ratingForm').reset();

            // Reset visual elements
            ratingText.className = 'rating-text';
            selectedRating.className = 'selected-rating';
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-star me-2"></i>Submit Rating';

            // Reset star colors
            starLabels.forEach(label => {
                label.style.color = '#ddd';
                label.style.transform = 'scale(1)';
            });
        });
    });
</script>





















