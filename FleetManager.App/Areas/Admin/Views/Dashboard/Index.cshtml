</head>

<body>
    <div class="dashboard-header">
        <div class="container-fluid">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-area="Admin">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="fas fa-tachometer-alt"></i> Admin Overview
                    </li>
                </ol>
            </nav>

            <div class="row align-items-center">
                <div class="col-lg-8">
                    @* <h1 class="animate__animated animate__fadeInUp">
                        <i class="fas fa-truck me-3"></i>Fleet Manager
                    </h1>
                    <p class="subtitle animate__animated animate__fadeInUp animate__delay-1s">
                        Complete fleet oversight and management dashboard
                    </p> *@

                    <div class="greeting-card animate__animated animate__fadeInUp animate__delay-2s">
                        <div id="greeting-content">
                            <div class="loading-spinner"></div> Loading personalized greeting...
                        </div>
                    </div>
                </div>

                

                <div class="col-lg-4 text-end">
                    <div class="text-white animate__animated animate__fadeInRight">
                        <h5><i class="fas fa-clock"></i> Last Updated</h5>
                        <p class="mb-0">@Model.GeneratedAt.UtcDateTime.ToString("MMMM dd, yyyy")</p>
                        <small>@Model.GeneratedAt.UtcDateTime.ToString("HH:mm 'UTC'")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4">
        <!-- KPI Cards Section -->
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="kpi-card animate__animated animate__fadeInUp">
                    <div class="kpi-icon drivers">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="kpi-label">Total Drivers</div>
                    <div class="kpi-value">@Model.Counts.TotalDrivers</div>
                    <div class="metric-comparison">
                        <span class="metric-trend trend-up">
                            <i class="fas fa-arrow-up"></i> @Model.Counts.ActiveDrivers Active
                        </span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(percent(Model.Counts.ActiveDrivers, Model.Counts.TotalDrivers))%; background: var(--success-gradient);"></div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Index" asp-controller="ManageDriver" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-eye"></i> View All Drivers
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="kpi-card animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="kpi-icon vehicles">
                        <i class="fas fa-car"></i>
                    </div>
                    <div class="kpi-label">Fleet Size</div>
                    <div class="kpi-value">@Model.Counts.TotalVehicles</div>
                    <div class="metric-comparison">
                        <span class="metric-trend trend-up">
                            <i class="fas fa-check-circle"></i> @Model.Counts.ActiveVehicles Operational
                        </span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(percent(Model.Counts.ActiveVehicles, Model.Counts.TotalVehicles))%; background: var(--info-gradient);"></div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Index" asp-controller="AdminVehicle" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-list"></i> Manage Fleet
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="kpi-card animate__animated animate__fadeInUp animate__delay-2s">
                    <div class="kpi-icon maintenance">
                        <i class="fas fa-tools"></i>
                    </div>
                    <div class="kpi-label">Maintenance Status</div>
                    <div class="kpi-value">@Model.Counts.OpenMaintenanceTickets</div>
                    <div class="metric-comparison">
                        @if (Model.Counts.OverdueMaintenanceTickets > 0)
                        {
                            <span class="metric-trend trend-down">
                                <i class="fas fa-exclamation-triangle"></i> @Model.Counts.OverdueMaintenanceTickets Overdue
                            </span>
                        }
                        else
                        {
                            <span class="metric-trend trend-up">
                                <i class="fas fa-check"></i> No Overdue Items
                            </span>
                        }
                    </div>
                    <div class="progress-bar">
                        @{
                            var overduePercent = Model.Counts.OpenMaintenanceTickets > 0 ?
                            percent(Model.Counts.OverdueMaintenanceTickets, Model.Counts.OpenMaintenanceTickets) : 0;
                        }
                        <div class="progress-fill" style="width: @(100 - overduePercent)%; background: var(--warning-gradient);"></div>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Index" asp-controller="ManageMaintenance" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-wrench"></i> View Maintenance
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="kpi-card animate__animated animate__fadeInUp animate__delay-3s">
                    <div class="kpi-icon money">
                        <i class="fas fa-naira-sign"></i>
                    </div>
                    <div class="kpi-label">Total Expenditure</div>
                    <div class="kpi-value" style="font-size: 1.8rem;">@ngn(Model.Money.TotalSpend)</div>
                    <div class="metric-comparison">
                        <small class="text-muted">
                            <strong>Fuel:</strong> @ngn(Model.Money.FuelSpend) |
                            <strong>Maintenance:</strong> @ngn(Model.Money.MaintenanceSpend)
                        </small>
                    </div>
                    <div class="mt-3">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <small class="text-muted d-block">Fuel</small>
                                <strong>@(Math.Round((double)Model.Money.FuelSpend / (double)Model.Money.TotalSpend * 100))%</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Maintenance</small>
                                <strong>@(Math.Round((double)Model.Money.MaintenanceSpend / (double)Model.Money.TotalSpend * 100))%</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Alerts Section -->
        @if (Model.Counts.OverdueMaintenanceTickets > 0)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-card animate__animated animate__pulse animate__infinite">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                            <div>
                                <h5 class="alert-heading mb-1">Attention Required!</h5>
                                <p class="mb-0">You have @Model.Counts.OverdueMaintenanceTickets overdue maintenance ticket(s) that need immediate attention.</p>
                            </div>
                            <a asp-action="Index" asp-controller="ManageMaintenance" class="btn btn-outline-danger ms-auto">
                                View Details <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Charts Section -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInLeft">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-gas-pump me-2"></i>
                            <strong>Fuel Consumption Trends</strong>
                        </div>
                        <div class="text-muted">
                            <small><i class="fas fa-chart-line"></i> Volume (L) & Cost (₦)</small>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center" style="height: 300px;" id="fuelChartLoader">
                            <div class="text-center">
                                <div class="loading-spinner mb-2"></div>
                                <small class="text-muted">Loading fuel data...</small>
                            </div>
                        </div>
                        <canvas id="fuelByMonthChart" height="300" style="display: none;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInRight">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-wrench me-2"></i>
                            <strong>Maintenance Spending</strong>
                        </div>
                        <div class="text-muted">
                            <small><i class="fas fa-naira-sign"></i> Monthly Costs</small>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center" style="height: 300px;" id="maintenanceChartLoader">
                            <div class="text-center">
                                <div class="loading-spinner mb-2"></div>
                                <small class="text-muted">Loading maintenance data...</small>
                            </div>
                        </div>
                        <canvas id="maintenanceByMonthChart" height="300" style="display: none;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInUp">
                    <div class="card-header">
                        <i class="fas fa-clipboard-list me-2"></i>
                        <strong>Maintenance Tickets by Status</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center" style="height: 280px;" id="ticketsChartLoader">
                            <div class="text-center">
                                <div class="loading-spinner mb-2"></div>
                                <small class="text-muted">Loading ticket data...</small>
                            </div>
                        </div>
                        <canvas id="ticketsByStatusChart" height="280" style="display: none;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="card-header">
                        <i class="fas fa-trophy me-2"></i>
                        <strong>Top Fuel Consuming Vehicles</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center" style="height: 280px;" id="topVehiclesChartLoader">
                            <div class="text-center">
                                <div class="loading-spinner mb-2"></div>
                                <small class="text-muted">Loading vehicle data...</small>
                            </div>
                        </div>
                        <canvas id="topVehiclesChart" height="280" style="display: none;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- NEW PIE CHARTS SECTION -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInUp">
                    <div class="card-header">
                        <i class="fas fa-money-bill me-2"></i>
                        <strong>Expense Distribution</strong>
                    </div>
                    <div class="card-body">
                        <canvas id="expenseDistributionChart" height="280"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="chart-card animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="card-header">
                        <i class="fas fa-chart-pie me-2"></i>
                        <strong>Driver & Vehicle Status</strong>
                    </div>
                    <div class="card-body">
                        <canvas id="driverVehicleChart" height="280"></canvas>
                    </div>
                </div>
            </div>
        </div>


        <!-- Data Tables Section -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="table-card animate__animated animate__fadeInUp">
                    <div class="card-header">
                        <i class="fas fa-tools me-2"></i>
                        <strong>Recent Maintenance Tickets</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tblRecentTickets">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> Ticket</th>
                                    <th><i class="fas fa-car"></i> Vehicle</th>
                                    <th><i class="fas fa-flag"></i> Status</th>
                                    <th><i class="fas fa-calendar"></i> Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.RecentMaintenanceTickets)
                                {
                                    <tr>
                                        <td>
                                            @* <a href="@Url.Action("Details", "Maintenance", new { id = t.TicketId })"
                                               class="text-primary fw-bold">
                                                #@t.TicketId
                                            </a> *@
                                            <a asp-action="Details" asp-controller="Maintenance" asp-protect-route-id="t.TicketId"
                                               class="text-primary fw-bold">
                                                #@t.TicketId
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@t.VehiclePlateNo</span>
                                        </td>
                                        <td>
                                            <span class="status-badge status-@t.Status.ToLower().Replace(" ", "-")">
                                                @t.Status
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @t.CreatedDate.ToString("MMM dd")
                                            </small>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentMaintenanceTickets.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                            No recent maintenance tickets
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Index" asp-controller="ManageMaintenance" class="btn btn-outline-primary btn-sm w-100">
                            <i class="fas fa-list me-1"></i>View All Maintenance Tickets
                        </a>
                    </div>
                </div>
            </div>
 
            <div class="col-lg-4">
                <div class="table-card animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="card-header">
                        <i class="fas fa-gas-pump me-2"></i>
                        <strong>Recent Fuel Logs</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tblRecentFuel">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> ID</th>
                                    <th><i class="fas fa-car"></i> Vehicle</th>
                                    <th><i class="fas fa-tint"></i> Volume</th>
                                    <th><i class="fas fa-naira-sign"></i> Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.RecentFuelLogs)
                                {
                                    <tr>
                                        <td><small class="text-muted">#@f.FuelLogId</small></td>
                                        <td>
                                            <span class="badge bg-info text-white">@f.VehiclePlateNo</span>
                                        </td>
                                        <td>
                                            <strong>@f.Volume</strong>
                                            <small class="text-muted">L</small>
                                        </td>
                                        <td>
                                            <strong class="text-success">@ngn(f.Cost)</strong>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentFuelLogs.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            <i class="fas fa-gas-pump fa-2x mb-2 d-block"></i>
                                            No recent fuel logs
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Index" asp-controller="FuelLog" class="btn btn-outline-primary btn-sm w-100">
                            <i class="fas fa-list me-1"></i>View All Fuel Logs
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="table-card animate__animated animate__fadeInUp animate__delay-2s">
                    <div class="card-header">
                        <i class="fas fa-address-book me-2"></i>
                        <strong>Vendor Contacts</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tblRecentContacts">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-user"></i> Name</th>
                                    <th><i class="fas fa-phone"></i> Phone</th>
                                    <th><i class="fas fa-cogs"></i> Services</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.RecentContacts)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle text-white d-flex align-items-center justify-content-center me-2"
                                                     style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    @(c.ContactName?.Substring(0, 1).ToUpper() ?? "?")
                                                </div>
                                                <div>
                                                    <strong>@c.ContactName</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="tel:@c.PhoneNumber" class="text-decoration-none">
                                                <i class="fas fa-phone text-success"></i>
                                                @c.PhoneNumber
                                            </a>
                                        </td>
                                        <td>
                                            <small class="text-muted">@c.Services</small>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentContacts.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="fas fa-address-book fa-2x mb-2 d-block"></i>
                                            No vendor contacts available
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Index" asp-controller="ContactDirectory" class="btn btn-outline-primary btn-sm w-100">
                            <i class="fas fa-address-book me-1"></i>View All Contacts
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Section -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="chart-card">
                    <div class="card-header">
                        <i class="fas fa-bolt me-2"></i>
                        <strong>Quick Actions</strong>
                    </div>
                    <div class="card-body" style="position:relative; height:200px; min-height:100px;">
                        <div class="row g-3">
                            
                            <div class="col-md-3" style="flex: 0 0 auto; width: 20%; padding-top: 10px; margin-left: 45px; padding-left: 5px;">
                                <a asp-action="Create" asp-controller="ManageDriver" class="btn btn-outline-success w-100 py-3">
                                    <i class="fas fa-user-plus fa-2x d-block mb-2"></i>
                                    <strong>Add Driver</strong>
                                    <small class="d-block text-muted">Register new driver</small>
                                </a>
                            </div>
                            <div class="col-md-3" style="flex: 0 0 auto; width: 20%; padding-top: 10px; margin-left: 45px; padding-left: 5px;">
                                <a asp-action="Create" asp-controller="AdminVehicle" class="btn btn-outline-info w-100 py-3">
                                    <i class="fas fa-plus-circle fa-2x d-block mb-2"></i>
                                    <strong>Add Vehicle</strong>
                                    <small class="d-block text-muted">Register new vehicle</small>
                                </a>
                            </div>
                            <div class="col-md-3" style="flex: 0 0 auto; width: 20%; padding-top: 10px; margin-left: 45px; padding-left: 5px;">
                                <a asp-action="Create" asp-controller="ManageMaintenance" class="btn btn-outline-warning w-100 py-3">
                                    <i class="fas fa-tools fa-2x d-block mb-2"></i>
                                    <strong>Schedule Maintenance</strong>
                                    <small class="d-block text-muted">Create maintenance ticket</small>
                                </a>
                            </div>
                            <div class="col-md-3" style="flex: 0 0 auto; width: 20%; padding-top: 10px; margin-left: 45px; padding-left: 5px;">
                                <a asp-action="Reports" asp-controller="Dashboard" asp-area="Admin" class="btn btn-outline-primary w-100 py-3">
                                    <i class="fas fa-chart-bar fa-2x d-block mb-2"></i>
                                    <strong>View Reports</strong>
                                    <small class="d-block text-muted">Detailed analytics</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Information -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="alert alert-light border-0 shadow-sm rounded-3">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle text-primary fa-2x me-3"></i>
                                <div>
                                    <h6 class="mb-1">System Information</h6>
                                    <small class="text-muted">
                                        Charts are loaded asynchronously and cached for 30 minutes.
                                        Data is automatically refreshed every hour.
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
                                <i class="fas fa-sync-alt"></i> Refresh Dashboard
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

    <script>
        $(document).ready(function() {
            // Remove heavy card animations while charts initialize to avoid ResizeObserver thrash
            $('.chart-card').removeClass('animate__animated');

            // Initialize UI pieces that don't require charts
            initializeGreeting();
            initializeProgressBars();
            initializeAnimations();

            // NEW: Initialize the pie charts
            initializePieCharts();

            // Delay chart creation slightly so animations / layout settle
            setTimeout(function() {
                initializeCharts();
                // restore animation class after charts created (keeps the look but avoids thrash)
                $('.chart-card').addClass('animate__animated');
            }, 350);

            // Auto-refresh every 5 minutes (timestamp only)
            setInterval(function() {
                updateTimestamp();
            }, 300000);
        });

        // NEW: Initialize pie charts
        function initializePieCharts() {
            // Expense Distribution Pie Chart
            const expenseCtx = document.getElementById('expenseDistributionChart').getContext('2d');
            new Chart(expenseCtx, {
                type: 'pie',
                data: {
                    labels: ['Fuel', 'Maintenance'],
                    datasets: [{
                        data: [@Model.Money.FuelSpend, @Model.Money.MaintenanceSpend],
                        backgroundColor: [
                            'rgba(54, 162, 235, 0.8)',
                            'rgba(255, 99, 132, 0.8)'
                        ],
                        borderColor: [
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${label}: ₦${value.toLocaleString()} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // Driver & Vehicle Status Pie Chart
            const driverVehicleCtx = document.getElementById('driverVehicleChart').getContext('2d');
            new Chart(driverVehicleCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Active Drivers', 'Inactive Drivers', 'Active Vehicles', 'Inactive Vehicles'],
                    datasets: [{
                        data: [
                            @Model.Counts.ActiveDrivers,
                            @(Model.Counts.TotalDrivers - Model.Counts.ActiveDrivers),
                            @Model.Counts.ActiveVehicles,
                            @(Model.Counts.TotalVehicles - Model.Counts.ActiveVehicles)
                        ],
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.8)',
                            'rgba(255, 159, 64, 0.8)',
                            'rgba(153, 102, 255, 0.8)',
                            'rgba(201, 203, 207, 0.8)'
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(201, 203, 207, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        // GLOBAL CHART HOLDER AND HELPER
        window._charts = window._charts || {};

        // helper to safely create a chart (destroys existing one if present)
        function createOrReplaceChart(key, canvasSelector, createChartFn) {
            try {
                if (window._charts[key]) {
                    window._charts[key].destroy();
                    window._charts[key] = null;
                }
            } catch (e) {
                console.warn('Error destroying chart', e);
            }

            const $canvas = $(canvasSelector);
            const $parent = $canvas.closest('.card-body');

            // ensure parent has explicit height (the CSS change should set this; this is defensive)
            if (!$parent.css('height') || $parent.css('height') === 'auto') {
                $parent.css('height', '300px');
            }

            // ensure canvas is visible and fills parent before Chart creation
            $canvas.css({ display: 'block', width: '100%', height: '100%' });

            const ctx = $canvas[0].getContext('2d');
            window._charts[key] = createChartFn(ctx);
            return window._charts[key];
        }

        function initializeGreeting() {
            const name = "@_authUser.FirstName" || "Admin";
            const hour = new Date().getHours();
            let greeting, subMessage, icon;

            if (hour < 12) {
                greeting = "Good Morning";
                subMessage = "Ready to optimize your fleet operations today?";
                icon = "fas fa-sun";
            } else if (hour < 17) {
                greeting = "Good Afternoon";
                subMessage = "Keep your fleet running smoothly this afternoon.";
                icon = "fas fa-cloud-sun";
            } else {
                greeting = "Good Evening";
                subMessage = "Review today's performance and plan for tomorrow.";
                icon = "fas fa-moon";
            }

            const container = document.getElementById('greeting-content');
            container.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="${icon} fa-2x me-3 text-warning"></i>
                    <div>
                        <h4 class="mb-1">${greeting}, <span class="text-warning">${name}</span>!</h4>
                        <p class="mb-0 opacity-75">${subMessage}</p>
                    </div>
                </div>
            `;
        }

        function initializeProgressBars() {
            // Animate progress bars on load (robust width parsing)
            setTimeout(function() {
                $('.progress-fill').each(function() {
                    const $this = $(this);
                    const style = $this.attr('style') || '';
                    const match = style.match(/width:\s*([\d.]+)%/);
                    const target = match ? (match[1] + '%') : $this.css('width');

                    // start from zero then animate to target
                    $this.css('width', '0%');
                    $this.animate({ width: target }, 1500);
                });
            }, 500);
        }

        function initializeAnimations() {
            // Add stagger delay to KPI cards
            $('.kpi-card').each(function(index) {
                $(this).css('animation-delay', (index * 0.2) + 's');
            });

            // Animate counter numbers
            $('.kpi-value').each(function() {
                const $this = $(this);
                const countTo = parseInt($this.text().replace(/[^\d]/g, ''));
                if (countTo && !isNaN(countTo)) {
                    $({ countNum: 0 }).animate({
                        countNum: countTo
                    }, {
                        duration: 2000,
                        easing: 'swing',
                        step: function() {
                            const formatted = Math.floor(this.countNum).toLocaleString();
                            if ($this.text().includes('₦')) {
                                $this.text('₦' + formatted);
                            } else {
                                $this.text(formatted);
                            }
                        },
                        complete: function() {
                            // ensure final value is displayed correctly
                            const formatted = countTo.toLocaleString();
                            if ($this.text().includes('₦') || $this.attr('data-currency') === 'ngn') {
                                $this.text('₦' + formatted);
                            } else {
                                $this.text(formatted);
                            }
                        }
                    });
                }
            });
        }

        function initializeCharts() {
            const endpoints = {
                fuelByMonth: '@Url.Action("FuelByMonth", "Dashboard", new { area = "Admin" })',
                maintenanceByMonth: '@Url.Action("MaintenanceByMonth", "Dashboard", new { area = "Admin" })',
                ticketsByStatus: '@Url.Action("TicketsByStatus", "Dashboard", new { area = "Admin" })',
                topVehicles: '@Url.Action("TopVehiclesByFuel", "Dashboard", new { area = "Admin" })'
            };

            // Chart.js default configuration
            Chart.defaults.font.family = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
            Chart.defaults.font.size = 12;
            Chart.defaults.color = '#4a5568';

            // Load all charts
            loadFuelChart(endpoints.fuelByMonth);
            loadMaintenanceChart(endpoints.maintenanceByMonth);
            loadTicketsChart(endpoints.ticketsByStatus);
            loadTopVehiclesChart(endpoints.topVehicles);
        }

        function loadFuelChart(endpoint) {
            $.getJSON(endpoint)
                .done(function(data) {
                    const labels = data.map(d => monthLabel(d.year, d.month));
                    const costData = data.map(d => d.value);
                    const volumeData = data.map(d => d.secondaryValue);

                    createOrReplaceChart('fuelByMonthChart', '#fuelByMonthChart', (ctx) => {
                        return new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Cost (₦)',
                                    data: costData,
                                    backgroundColor: 'rgba(102, 126, 234, 0.8)',
                                    borderColor: 'rgba(102, 126, 234, 1)',
                                    borderWidth: 2,
                                    borderRadius: 8,
                                    yAxisID: 'y'
                                }, {
                                    label: 'Volume (L)',
                                    data: volumeData,
                                    type: 'line',
                                    backgroundColor: 'rgba(56, 239, 125, 0.1)',
                                    borderColor: 'rgba(56, 239, 125, 1)',
                                    borderWidth: 3,
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: 'rgba(56, 239, 125, 1)',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2,
                                    pointRadius: 6,
                                    yAxisID: 'y1'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: {
                                    mode: 'index',
                                    intersect: false
                                },
                                plugins: {
                                    legend: {
                                        position: 'top',
                                        labels: {
                                            usePointStyle: true,
                                            padding: 20
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        borderColor: 'rgba(102, 126, 234, 1)',
                                        borderWidth: 1,
                                        cornerRadius: 8
                                    }
                                },
                                scales: {
                                    y: {
                                        type: 'linear',
                                        display: true,
                                        position: 'left',
                                        ticks: {
                                            callback: function(value) {
                                                return '₦' + value.toLocaleString();
                                            }
                                        },
                                        grid: {
                                            color: 'rgba(0, 0, 0, 0.05)'
                                        }
                                    },
                                    y1: {
                                        type: 'linear',
                                        display: true,
                                        position: 'right',
                                        ticks: {
                                            callback: function(value) {
                                                return value + 'L';
                                            }
                                        },
                                        grid: {
                                            drawOnChartArea: false
                                        }
                                    },
                                    x: {
                                        grid: {
                                            color: 'rgba(0, 0, 0, 0.05)'
                                        }
                                    }
                                }
                            }
                        });
                    });

                    $('#fuelChartLoader').hide();
                    $('#fuelByMonthChart').fadeIn();
                })
                .fail(function() {
                    $('#fuelChartLoader').html('<div class="text-center text-muted"><i class="fas fa-exclamation-triangle"></i><br>Failed to load chart</div>');
                });
        }

        function loadMaintenanceChart(endpoint) {
            $.getJSON(endpoint)
                .done(function(data) {
                    const labels = data.map(d => monthLabel(d.year, d.month));
                    const costData = data.map(d => d.value);

                    createOrReplaceChart('maintenanceByMonthChart', '#maintenanceByMonthChart', (ctx) => {
                        return new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Maintenance Cost (₦)',
                                    data: costData,
                                    backgroundColor: 'rgba(245, 87, 108, 0.1)',
                                    borderColor: 'rgba(245, 87, 108, 1)',
                                    borderWidth: 3,
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: 'rgba(245, 87, 108, 1)',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2,
                                    pointRadius: 6,
                                    pointHoverRadius: 8
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        borderColor: 'rgba(245, 87, 108, 1)',
                                        borderWidth: 1,
                                        cornerRadius: 8
                                    }
                                },
                                scales: {
                                    y: {
                                        ticks: {
                                            callback: function(value) {
                                                return '₦' + value.toLocaleString();
                                            }
                                        },
                                        grid: {
                                            color: 'rgba(0, 0, 0, 0.05)'
                                        }
                                    },
                                    x: {
                                        grid: {
                                            color: 'rgba(0, 0, 0, 0.05)'
                                        }
                                    }
                                }
                            }
                        });
                    });

                    $('#maintenanceChartLoader').hide();
                    $('#maintenanceByMonthChart').fadeIn();
                })
                .fail(function() {
                    $('#maintenanceChartLoader').html('<div class="text-center text-muted"><i class="fas fa-exclamation-triangle"></i><br>Failed to load chart</div>');
                });
        }

        function loadTicketsChart(endpoint) {
            $.getJSON(endpoint)
                .done(function(data) {
                    const labels = data.map(d => d.key);
                    const values = data.map(d => d.value);
                    const colors = [
                        'rgba(102, 126, 234, 0.8)',
                        'rgba(56, 239, 125, 0.8)',
                        'rgba(245, 87, 108, 0.8)',
                        'rgba(79, 172, 254, 0.8)',
                        'rgba(240, 147, 251, 0.8)'
                    ];

                    createOrReplaceChart('ticketsByStatusChart', '#ticketsByStatusChart', (ctx) => {
                        return new Chart(ctx, {
                            type: 'doughnut',
                            data: {
                                labels: labels,
                                datasets: [{
                                    data: values,
                                    backgroundColor: colors,
                                    borderColor: colors.map(c => c.replace('0.8', '1')),
                                    borderWidth: 2,
                                    hoverBorderWidth: 3
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            usePointStyle: true,
                                            padding: 15
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        cornerRadius: 8
                                    }
                                },
                                cutout: '60%'
                            }
                        });
                    });

                    $('#ticketsChartLoader').hide();
                    $('#ticketsByStatusChart').fadeIn();
                })
                .fail(function() {
                    $('#ticketsChartLoader').html('<div class="text-center text-muted"><i class="fas fa-exclamation-triangle"></i><br>Failed to load chart</div>');
                });
        }

        function loadTopVehiclesChart(endpoint) {
            $.getJSON(endpoint + '?top=7')
                .done(function(data) {
                    const labels = data.map(d => d.plateNo || 'N/A');
                    const values = data.map(d => d.totalVolume);

                    createOrReplaceChart('topVehiclesChart', '#topVehiclesChart', (ctx) => {
                        return new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Volume (L)',
                                    data: values,
                                    backgroundColor: 'rgba(79, 172, 254, 0.8)',
                                    borderColor: 'rgba(79, 172, 254, 1)',
                                    borderWidth: 2,
                                    borderRadius: 6
                                }]
                            },
                            options: {
                                indexAxis: 'y',
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                        titleColor: '#fff',
                                        bodyColor: '#fff',
                                        borderColor: 'rgba(79, 172, 254, 1)',
                                        borderWidth: 1,
                                        cornerRadius: 8
                                    }
                                },
                                scales: {
                                    x: {
                                        ticks: {
                                            callback: function(value) {
                                                return value + 'L';
                                            }
                                        },
                                        grid: {
                                            color: 'rgba(0, 0, 0, 0.05)'
                                        }
                                    },
                                    y: {
                                        grid: { display: false }
                                    }
                                }
                            }
                        });
                    });

                    $('#topVehiclesChartLoader').hide();
                    $('#topVehiclesChart').fadeIn();
                })
                .fail(function() {
                    $('#topVehiclesChartLoader').html('<div class="text-center text-muted"><i class="fas fa-exclamation-triangle"></i><br>Failed to load chart</div>');
                });
        }

        function monthLabel(year, month) {
            return new Date(year, month - 1, 1).toLocaleString('en-US', {
                month: 'short',
                year: 'numeric'
            });
        }

        function updateTimestamp() {
            console.log('Dashboard refreshed at:', new Date().toLocaleString());
        }

        // UI interactivity
        $(document).on('mouseenter', '.kpi-card', function() {
            $(this).find('.kpi-icon').addClass('animate__animated animate__pulse');
        });

        $(document).on('mouseleave', '.kpi-card', function() {
            $(this).find('.kpi-icon').removeClass('animate__animated animate__pulse');
        });

        // Smooth scrolling for any anchor links
        $('a[href^="#"]').on('click', function(event) {
            var target = $(this.getAttribute('href'));
            if (target.length) {
                event.preventDefault();
                $('html, body').animate({
                    scrollTop: target.offset().top - 100
                }, 1000);
            }
        });
    </script>


</body>
</html>
