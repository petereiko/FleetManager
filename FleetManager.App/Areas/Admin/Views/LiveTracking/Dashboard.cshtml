@using FleetManager.Business.Enums
@using FleetManager.Business.ViewModels.TripsViewModels
@model LiveTrackingDashboardViewModel
@{
    ViewData["Title"] = "Live Tracking Dashboard";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dashboard-container {
        padding: 30px;
        background: #f8f9fa;
        min-height: 100vh;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-header .subtitle {
        color: #6c757d;
        font-size: 16px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .stat-card .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .stat-card.active .stat-icon {
        background: rgba(0, 177, 79, 0.1);
        color: #00b14f;
    }

    .stat-card.total .stat-icon {
        background: rgba(0, 0, 0, 0.1);
        color: #000;
    }

    .stat-card .stat-value {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .stat-card .stat-label {
        color: #6c757d;
        font-size: 14px;
    }

    .trips-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .trips-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .trips-header h2 {
        font-size: 20px;
        font-weight: 600;
        margin: 0;
    }

    .refresh-btn {
        background: #000;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        transition: all 0.2s;
    }

    .refresh-btn:hover {
        background: #2c2c2c;
    }

    .trips-list {
        padding: 0;
    }

    .trip-card {
        padding: 20px 24px;
        border-bottom: 1px solid #e0e0e0;
        transition: background 0.2s;
        cursor: pointer;
    }

    .trip-card:last-child {
        border-bottom: none;
    }

    .trip-card:hover {
        background: #f8f9fa;
    }

    .trip-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .trip-info h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 4px 0;
    }

    .trip-number {
        color: #6c757d;
        font-size: 14px;
    }

    .trip-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .trip-status.in-progress {
        background: rgba(0, 177, 79, 0.1);
        color: #00b14f;
    }

    .trip-status .pulse-dot {
        width: 8px;
        height: 8px;
        background: currentColor;
        border-radius: 50%;
        animation: pulse 1.5s infinite;
    }

    .trip-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 12px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-item i {
        color: #6c757d;
        width: 20px;
    }

    .detail-item span {
        font-size: 14px;
        color: #1a1a1a;
    }

    .trip-actions {
        display: flex;
        gap: 12px;
    }

    .btn-track {
        background: #000;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

    .btn-track:hover {
        background: #2c2c2c;
        transform: translateY(-1px);
    }

    .btn-details {
        background: #f8f9fa;
        color: #1a1a1a;
        border: 1px solid #e0e0e0;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s;
    }

    .btn-details:hover {
        background: #e0e0e0;
    }

    .empty-state {
        padding: 60px 24px;
        text-align: center;
    }

    .empty-state i {
        font-size: 64px;
        color: #e0e0e0;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        font-size: 20px;
        color: #6c757d;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #9ca3af;
        font-size: 14px;
    }
</style>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h1>Live Tracking Dashboard</h1>
        <p class="subtitle">Monitor all active trips in real-time</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card active">
            <div class="stat-icon">
                <i class="fas fa-broadcast-tower fa-2x"></i>
            </div>
            <div class="stat-value">@Model.TotalActiveTrips</div>
            <div class="stat-label">Active Trips</div>
        </div>

        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-route fa-2x"></i>
            </div>
            <div class="stat-value" id="totalDistance">0</div>
            <div class="stat-label">Total Distance (km)</div>
        </div>

        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-clock fa-2x"></i>
            </div>
            <div class="stat-value" id="lastUpdate">--:--</div>
            <div class="stat-label">Last Update</div>
        </div>
    </div>

    <!-- Trips List -->
    <div class="trips-container">
        <div class="trips-header">
            <h2>Active Trips (@Model.TotalActiveTrips)</h2>
            <button class="refresh-btn" onclick="location.reload()">
                <i class="fas fa-sync-alt"></i>
                Refresh
            </button>
        </div>

        <div class="trips-list">
            @if (Model.ActiveTrips.Any())
            {
                foreach (var trip in Model.ActiveTrips)
                {
                    <div class="trip-card">
                        <div class="trip-card-header">
                            <div class="trip-info">
                                <h3>@trip.VehiclePlateNo - @trip.Origin to @trip.Destination</h3>
                                <span class="trip-number">Trip #@trip.TripNumber</span>
                            </div>
                            <span class="trip-status in-progress">
                                <span class="pulse-dot"></span>
                                LIVE
                            </span>
                        </div>

                        <div class="trip-details">
                            <div class="detail-item">
                                <i class="fas fa-user"></i>
                                <span>@trip.DriverName</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-clock"></i>
                                <span>Started: @(trip.ActualStartDate != DateTime.MinValue ? trip.ActualStartDate.ToString("HH:mm") : "N/A")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-route"></i>
                                <span>@(trip.EstimatedDistance.HasValue ? trip.EstimatedDistance.Value.ToString("F1") : "0") km</span>
                            </div>
                            @if (trip.Priority == TripPriority.High || trip.Priority == TripPriority.Urgent)
                            {
                                <div class="detail-item">
                                    <i class="fas fa-exclamation-triangle" style="color: #dc3545;"></i>
                                    <span style="color: #dc3545; font-weight: 600;">@trip.Priority Priority</span>
                                </div>
                            }
                        </div>

                        <div class="trip-actions">
                            <button class="btn-track" onclick="window.location.href='admin/livetracking/trip/@trip.Id'">
                                <i class="fas fa-map-marked-alt"></i>
                                Track Live
                            </button>
                            <button class="btn-details" onclick="window.location.href='admin/livetracking/trips/details/@trip.Id'">
                                <i class="fas fa-info-circle"></i>
                                Details
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-road"></i>
                    <h3>No Active Trips</h3>
                    <p>There are currently no trips in progress to track</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Update last update time
    function updateLastUpdateTime() {
        const updateElement = document.getElementById('lastUpdate');
        const now = new Date();
        updateElement.textContent = now.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    // Calculate total distance
    function updateTotalDistance() {
        @if (Model.ActiveTrips.Any())
        {
            // compute total in server-side C# to avoid Razor lambda parsing issues
            var total = Model.ActiveTrips.Sum(t => t.EstimatedDistance ?? 0m);
            <text>
            document.getElementById('totalDistance').textContent = '@total.ToString("F1")';
            </text>
        }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        updateLastUpdateTime();
        updateTotalDistance();
        setInterval(updateLastUpdateTime, 1000);

        // Auto-refresh every 30 seconds
        setTimeout(() => location.reload(), 30000);
    });
</script>
}
