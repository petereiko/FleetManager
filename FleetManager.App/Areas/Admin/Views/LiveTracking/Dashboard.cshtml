<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h1>Live Tracking Dashboard</h1>
        <p class="subtitle">Monitor all active trips in real-time</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card active">
            <div class="stat-icon">
                <i class="fas fa-broadcast-tower fa-2x"></i>
            </div>
            <div class="stat-value">@Model.TotalActiveTrips</div>
            <div class="stat-label">Active Trips</div>
        </div>

        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-route fa-2x"></i>
            </div>
            <div class="stat-value" id="totalDistance">0</div>
            <div class="stat-label">Total Distance (km)</div>
        </div>

        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-clock fa-2x"></i>
            </div>
            <div class="stat-value" id="lastUpdate">--:--</div>
            <div class="stat-label">Last Update</div>
        </div>
    </div>

    <!-- Trips List -->
    <div class="trips-container">
        <div class="trips-header">
            <h2>Active Trips (@Model.TotalActiveTrips)</h2>
            <button class="refresh-btn" onclick="location.reload()">
                <i class="fas fa-sync-alt"></i>
                Refresh
            </button>
        </div>

        <div class="trips-list">
            @if (Model.ActiveTrips.Any())
            {
                foreach (var trip in Model.ActiveTrips)
                {
                    <div class="trip-card">
                        <div class="trip-card-header">
                            <div class="trip-info">
                                <h3>@trip.VehiclePlateNo - @trip.Origin to @trip.Destination</h3>
                                <span class="trip-number">Trip #@trip.TripNumber</span>
                            </div>
                            <span class="trip-status in-progress">
                                <span class="pulse-dot"></span>
                                LIVE
                            </span>
                        </div>

                        <div class="trip-details">
                            <div class="detail-item">
                                <i class="fas fa-user"></i>
                                <span>@trip.DriverName</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-clock"></i>
                                <span>Started: @(trip.ActualStartDate != DateTime.MinValue ? trip.ActualStartDate.ToString("HH:mm") : "N/A")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-route"></i>
                                <span>@(trip.EstimatedDistance.HasValue ? trip.EstimatedDistance.Value.ToString("F1") : "0") km</span>
                            </div>
                            @if (trip.Priority == TripPriority.High || trip.Priority == TripPriority.Urgent)
                            {
                                <div class="detail-item">
                                    <i class="fas fa-exclamation-triangle" style="color: #dc3545;"></i>
                                    <span style="color: #dc3545; font-weight: 600;">@trip.Priority Priority</span>
                                </div>
                            }
                        </div>

                       <div class="trip-actions">
                            <a asp-area="Admin"
                               asp-controller="LiveTracking"
                               asp-action="TrackTrip"
                               asp-route-id="@trip.Id"
                               class="btn-track">
                                <i class="fas fa-map-marked-alt"></i>
                                Track Live
                            </a>

                            <a asp-area="Admin"
                               asp-controller="LiveTracking"
                               asp-action="Details"
                               asp-route-id="@trip.Id"
                               class="btn-details">
                                <i class="fas fa-info-circle"></i>
                                Details
                            </a>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-road"></i>
                    <h3>No Active Trips</h3>
                    <p>There are currently no trips in progress to track</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Update last update time
    function updateLastUpdateTime() {
        const updateElement = document.getElementById('lastUpdate');
        const now = new Date();
        updateElement.textContent = now.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    // Calculate total distance
    function updateTotalDistance() {
        @if (Model.ActiveTrips.Any())
        {
            // compute total in server-side C# to avoid Razor lambda parsing issues
            var total = Model.ActiveTrips.Sum(t => t.EstimatedDistance ?? 0m);
            <text>
            document.getElementById('totalDistance').textContent = '@total.ToString("F1")';
            </text>
        }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        updateLastUpdateTime();
        updateTotalDistance();
        setInterval(updateLastUpdateTime, 1000);

        // Auto-refresh every 30 seconds
        setTimeout(() => location.reload(), 30000);
    });
</script>
}
 *@