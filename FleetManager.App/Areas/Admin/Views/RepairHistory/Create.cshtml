@using FleetManager.Business.ViewModels.RepairHistoryViewModels
@model RepairCreateViewModel
@{
    ViewData["Title"] = "Create Repair";
}


<style>
    /* Custom Styles */
    .card {
        border-radius: 12px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

    .btn {
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .table th {
        border-top: none;
        font-weight: 600;
    }

    .item-row:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .breadcrumb {
        background: none;
        padding: 0;
        margin: 0;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        color: #6c757d;
    }

    .toast {
        border-radius: 12px;
    }

    .bg-gradient {
        background: linear-gradient(45deg, var(--bs-primary), #0056b3) !important;
    }

    .border-2 {
        border-width: 2px !important;
    }

    .form-select-lg, .form-control-lg {
        padding: 0.75rem 1rem;
        font-size: 1rem;
    }
</style>


<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i>
                <span id="successMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-exclamation-circle me-2"></i>
                <span id="errorMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-gradient rounded-circle p-3 me-3">
                        <i class="fas fa-tools text-white fa-lg"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-1 text-dark fw-bold">Create New Repair</h1>
                        <p class="text-muted mb-0">Add a new repair record to the fleet management system</p>
                    </div>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Repairs</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Create</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-edit text-primary me-2"></i>
                        <h5 class="mb-0 fw-semibold">Repair Information</h5>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="repairForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Basic Information Section -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-car text-primary me-2"></i>Vehicle *
                                </label>
                                <select asp-for="VehicleId" class="form-select form-select-lg border-2" asp-items="Model.Vehicles" required>
                                    <option value="">-- Select Vehicle --</option>
                                </select>
                                <span asp-validation-for="VehicleId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-user text-primary me-2"></i>Driver (Optional)
                                </label>
                                <select asp-for="DriverId" class="form-select form-select-lg border-2" asp-items="Model.Drivers">
                                    <option value="">-- No Driver Assigned --</option>
                                </select>
                                <span asp-validation-for="DriverId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-heading text-primary me-2"></i>Subject *
                                </label>
                                <input asp-for="Subject" class="form-control form-control-lg border-2" placeholder="Enter repair subject or title" required />
                                <span asp-validation-for="Subject" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-flag text-primary me-2"></i>Priority *
                                </label>
                                <select asp-for="Priority" class="form-select form-select-lg border-2" asp-items="Model.Priorities" required>
                                    <option value="">-- Select Priority --</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">
                                <i class="fas fa-sticky-note text-primary me-2"></i>Notes
                            </label>
                            <textarea asp-for="Notes" class="form-control border-2" rows="4" placeholder="Enter detailed notes about the repair..."></textarea>
                            <div class="form-text">Provide detailed information about the repair requirements</div>
                        </div>

                        <!-- Items Section -->
                        <div class="card border border-2 border-light mb-4">
                            <div class="card-header bg-light">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h5 class="mb-0 fw-semibold">
                                        <i class="fas fa-cogs text-primary me-2"></i>Repair Items
                                    </h5>
                                    <button type="button" id="addItem" class="btn btn-success btn-sm">
                                        <i class="fas fa-plus me-1"></i>Add Item
                                    </button>
                                </div>
                            </div>
                            
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0" id="itemsTable">
                                        <thead class="table-dark">
                                            <tr>
                                                <th width="20%" class="fw-semibold">Category</th>
                                                <th width="20%" class="fw-semibold">Part</th>
                                                <th width="25%" class="fw-semibold">Description</th>
                                                <th width="10%" class="fw-semibold">Qty</th>
                                                <th width="15%" class="fw-semibold">Unit Price (₦)</th>
                                                <th width="10%" class="fw-semibold text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Items.Count; i++)
                                            {
                                                <tr class="item-row">
                                                    <td>
                                                        <select name="Items[@i].PartCategoryId" class="form-select part-category" data-index="@i" required>
                                                            <option value="">-- Select Category --</option>
                                                            @foreach (var c in Model.PartCategories)
                                                            {
                                                                <option value="@c.Value">@c.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select name="Items[@i].PartId" class="form-select part-select" data-index="@i">
                                                            <option value="">-- Select Part --</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input name="Items[@i].CustomDescription" class="form-control" placeholder="Custom description" value="@Model.Items[i].CustomDescription" />
                                                    </td>
                                                    <td>
                                                        <input name="Items[@i].Quantity" type="number" min="1" value="@(Model.Items[i].Quantity == 0 ? 1 : Model.Items[i].Quantity)" class="form-control quantity-input" required />
                                                    </td>
                                                    <td>
                                                        <div class="input-group">
                                                            <span class="input-group-text">₦</span>
                                                            <input name="Items[@i].UnitPrice" type="number" step="0.01" min="0" class="form-control price-input" placeholder="0.00" value="@Model.Items[i].UnitPrice" />
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-outline-danger btn-sm remove-item" title="Remove Item">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="4" class="text-end fw-bold">Total Estimated Cost:</td>
                                                <td class="fw-bold text-primary" id="totalCost">₦ 0.00</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button class="btn btn-primary btn-lg px-4" type="submit" id="submitBtn">
                                <i class="fas fa-save me-2"></i>Create Repair
                                <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        (function(){
            let idx = @Model.Items.Count;
            
            // Initialize form
            document.addEventListener('DOMContentLoaded', function() {
                showToastMessages();
                calculateTotal();
                initializeExistingRows();
            });

            // Toast messages
            function showToastMessages() {
                @if(TempData["SuccessMessage"] != null)
                {
                    <text>
                    document.getElementById('successMessage').textContent = '@Html.Raw(TempData["SuccessMessage"])';
                    const successToast = new bootstrap.Toast(document.getElementById('successToast'));
                    successToast.show();
                    </text>
                }
                
                @if(TempData["Error"] != null)
                {
                    <text>
                    document.getElementById('errorMessage').textContent = '@Html.Raw(TempData["Error"])';
                    const errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                    errorToast.show();
                    </text>
                }
            }

            // Add new item
            document.getElementById('addItem').addEventListener('click', async () => {
                const tbody = document.querySelector('#itemsTable tbody');
                const tr = document.createElement('tr');
                tr.className = 'item-row';
                tr.innerHTML = `
                    <td>
                        <select name="Items[${idx}].PartCategoryId" class="form-select part-category" data-index="${idx}" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var c in Model.PartCategories)
                            {
                                <text><option value="@c.Value">@c.Text</option></text>
                            }
                        </select>
                    </td>
                    <td>
                        <select name="Items[${idx}].PartId" class="form-select part-select" data-index="${idx}">
                            <option value="">-- Select Part --</option>
                        </select>
                    </td>
                    <td>
                        <input name="Items[${idx}].CustomDescription" class="form-control" placeholder="Custom description" />
                    </td>
                    <td>
                        <input name="Items[${idx}].Quantity" type="number" min="1" value="1" class="form-control quantity-input" required />
                    </td>
                    <td>
                        <div class="input-group">
                            <span class="input-group-text">₦</span>
                            <input name="Items[${idx}].UnitPrice" type="number" step="0.01" min="0" class="form-control price-input" placeholder="0.00" />
                        </div>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-item" title="Remove Item">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
                idx++;
                
                // Add animation
                tr.style.opacity = '0';
                tr.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    tr.style.transition = 'all 0.3s ease';
                    tr.style.opacity = '1';
                    tr.style.transform = 'translateY(0)';
                }, 10);
            });

            // Remove item
            document.addEventListener('click', function(e){
                if (e.target && (e.target.matches('.remove-item') || e.target.closest('.remove-item'))) {
                    const button = e.target.matches('.remove-item') ? e.target : e.target.closest('.remove-item');
                    const row = button.closest('tr');
                    
                    // Add animation
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(-20px)';
                    
                    setTimeout(() => {
                        row.remove();
                        calculateTotal();
                    }, 300);
                }
            });

            // Handle parts loading
            document.addEventListener('change', async function(e) {
                if (e.target && e.target.matches('.part-category')) {
                    const categoryId = e.target.value;
                    const idx = e.target.getAttribute('data-index');
                    const select = document.querySelector(`.part-select[data-index="${idx}"]`);
                    
                    select.innerHTML = '<option value="">Loading...</option>';
                    
                    if (!categoryId) { 
                        select.innerHTML = '<option value="">-- Select Part --</option>'; 
                        return; 
                    }
                    
                    try {
                        const resp = await fetch('@Url.Action("GetPartsByCategory")?categoryId=' + categoryId);
                        const data = await resp.json();
                        select.innerHTML = '<option value="">-- Select Part --</option>';
                        data.forEach(item => {
                            const opt = document.createElement('option');
                            opt.value = item.value;
                            opt.textContent = item.text;
                            select.appendChild(opt);
                        });
                    } catch (error) {
                        select.innerHTML = '<option value="">Error loading parts</option>';
                        console.error('Error loading parts:', error);
                    }
                }
            });

            // Calculate total on quantity or price change
            document.addEventListener('input', function(e) {
                if (e.target && (e.target.matches('.quantity-input') || e.target.matches('.price-input'))) {
                    calculateTotal();
                }
            });

            // Calculate total cost
            function calculateTotal() {
                let total = 0;
                const rows = document.querySelectorAll('.item-row');
                
                rows.forEach(row => {
                    const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
                    const price = parseFloat(row.querySelector('.price-input').value) || 0;
                    total += quantity * price;
                });
                
                document.getElementById('totalCost').textContent = `₦ ${total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",")}`;
            }

            // Initialize existing rows (for edit scenarios)
            function initializeExistingRows() {
                const categorySelects = document.querySelectorAll('.part-category');
                categorySelects.forEach(async (select) => {
                    if (select.value) {
                        const event = new Event('change');
                        select.dispatchEvent(event);
                    }
                });
            }

            // Form submission with loading state
            document.getElementById('repairForm').addEventListener('submit', function(e) {
                const submitBtn = document.getElementById('submitBtn');
                const spinner = submitBtn.querySelector('.spinner-border');
                
                submitBtn.disabled = true;
                spinner.classList.remove('d-none');
                
                // Re-enable after a timeout in case of client-side validation errors
                setTimeout(() => {
                    if (submitBtn.disabled) {
                        submitBtn.disabled = false;
                        spinner.classList.add('d-none');
                    }
                }, 5000);
            });

            // Form validation
            const form = document.getElementById('repairForm');
            form.addEventListener('submit', function(e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        })();
    </script>
    
    















