                    </div>
                    
                    <!-- Main Content -->
                    <div class="col">
                        <div class="row">
                            <div class="col-md-8">
                                <h5 class="repair-subject mb-2">@repair.Subject</h5>
                                <div class="repair-meta">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <i class="fas fa-user me-1"></i>
                                            <strong>Driver:</strong> @(string.IsNullOrEmpty(repair.DriverName) ? "Not assigned" : repair.DriverName)
                                        </div>
                                        <div class="col-sm-6">
                                            <i class="fas fa-calendar me-1"></i>
                                            <strong>Date:</strong> @repair.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Status and Actions -->
                            <div class="col-md-4 text-md-end">
                                <div class="mb-2">
                                    <span class="priority-badge @(repair.Priority.ToString().ToLower() switch {
                                        "urgent" => "priority-urgent",
                                        "high" => "priority-high",  
                                        "medium" => "priority-medium",
                                        "low" => "priority-low",
                                        _ => "priority-low"
                                    })">@repair.Priority</span>
                                </div>
                                <div class="mb-3">
                                    <span class="status-badge @(repair.Status.ToString().ToLower().Replace(" ", "-") switch {
                                        "pending" => "status-pending",
                                        "inprogress" => "status-progress",
                                        "completed" => "status-completed",
                                        "cancelled" => "status-cancelled",
                                        _ => "status-pending"
                                    })">@repair.Status</span>
                                </div>
                                <div>
                                    @if (repair.Invoice != null)
                                    {
                                        <a class="invoice-btn" asp-action="Details" asp-route-id="@repair.Id">
                                            <i class="fas fa-file-invoice-dollar me-1"></i>
                                            View Detail
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-file-invoice me-1"></i>
                                            No invoice
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Enhanced Pagination -->
    @if (Model.Pagination.TotalItems > Model.Pagination.PageSize)
    {
        <nav aria-label="Repair history pages" class="pagination-modern">
            <ul class="pagination">
                @{
                    var current = Model.Pagination.CurrentPage;
                    var pageSize = Model.Pagination.PageSize;
                    var totalPages = (int)Math.Ceiling((double)Model.Pagination.TotalItems / pageSize);
                    
                    // Previous button
                    if (current > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("VehicleRepairs", new { vehicleId = Model.VehicleId, page = current - 1, pageSize = pageSize })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    
                    // Page numbers
                    var startPage = Math.Max(1, current - 2);
                    var endPage = Math.Min(totalPages, current + 2);
                    
                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("VehicleRepairs", new { vehicleId = Model.VehicleId, page = 1, pageSize = pageSize })">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    
                    for (int p = startPage; p <= endPage; p++)
                    {
                        if (p == current)
                        {
                            <li class="page-item active">
                                <span class="page-link">@p</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VehicleRepairs", new { vehicleId = Model.VehicleId, page = p, pageSize = pageSize })">@p</a>
                            </li>
                        }
                    }
                    
                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("VehicleRepairs", new { vehicleId = Model.VehicleId, page = totalPages, pageSize = pageSize })">@totalPages</a>
                        </li>
                    }
                    
                    // Next button
                    if (current < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("VehicleRepairs", new { vehicleId = Model.VehicleId, page = current + 1, pageSize = pageSize })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                }
            </ul>
        </nav>
    }
} *@