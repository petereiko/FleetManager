@using FleetManager.Business.DataObjects.ReportsCenter
@model DailyFleetActivityReportDto
@{
    ViewBag.Title = "Daily Fleet Activity";
    ViewBag.ExportFileName = "daily_fleet_activity";
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            --purple-color: #8b5cf6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .report-header h2 {
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .report-header p {
                margin: 0.5rem 0 0 0;
                opacity: 0.95;
                font-size: 0.9375rem;
            }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 3rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .date-selector-card {
            background: var(--gray-50);
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

            .date-selector-card h5 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .date-input-wrapper {
            position: relative;
            max-width: 300px;
        }

            .date-input-wrapper input {
                border: 2px solid var(--gray-200);
                border-radius: 10px;
                padding: 0.625rem 1rem;
                font-size: 0.9375rem;
                transition: all 0.2s;
                width: 100%;
                background: white;
            }

                .date-input-wrapper input:focus {
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
                    outline: none;
                }

        .btn-go {
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.625rem 1.75rem;
            font-weight: 600;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: 1rem;
        }

            .btn-go:hover {
                background: var(--primary-dark);
                transform: translateY(-1px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .metric-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            border-left: 4px solid var(--accent-color);
            transition: all 0.2s;
        }

            .metric-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .metric-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .metric-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            background: var(--icon-bg);
            color: var(--icon-color);
        }

        .metric-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            color: var(--gray-600);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .metric-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--gray-900);
            line-height: 1;
        }

            .metric-value small {
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--gray-600);
                margin-left: 0.25rem;
            }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

            .table-header h5 {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .table-responsive {
            border-radius: 0 0 12px 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

            .exportable-table thead {
                background: var(--gray-800);
                color: white;
            }

                .exportable-table thead th {
                    padding: 1rem 1.25rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    border: none;
                    white-space: nowrap;
                }

            .exportable-table tbody tr {
                border-bottom: 1px solid var(--gray-200);
                transition: all 0.2s;
            }

                .exportable-table tbody tr:hover {
                    background-color: var(--gray-50);
                }

            .exportable-table tbody td {
                padding: 1.25rem 1.25rem;
                vertical-align: middle;
                color: var(--gray-700);
            }

            .exportable-table tbody tr:last-child {
                border-bottom: none;
            }

        .vehicle-plate {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray-900);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
            background: var(--gray-100);
            border-radius: 6px;
        }

            .vehicle-plate i {
                color: var(--primary-color);
            }

        .vehicle-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gray-700);
            font-size: 0.9375rem;
        }

            .vehicle-info i {
                color: var(--info-color);
            }

        .distance-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            font-weight: 600;
        }

        .trips-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(59, 130, 246, 0.1);
            color: var(--info-color);
            border-radius: 8px;
            font-weight: 600;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

            .status-badge.active {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success-color);
            }

            .status-badge.idle {
                background: rgba(245, 158, 11, 0.1);
                color: var(--warning-color);
            }

            .status-badge.maintenance {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
            }

            .status-badge.inactive {
                background: rgba(107, 114, 128, 0.1);
                color: var(--gray-600);
            }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

            .empty-state i {
                font-size: 4rem;
                color: var(--gray-400);
                margin-bottom: 1rem;
            }

            .empty-state h4 {
                color: var(--gray-700);
                margin-bottom: 0.5rem;
            }

        @@media (max-width: 768px) {
            .report-header

        {
            padding: 1.5rem 0;
        }

        .report-card-body {
            padding: 1rem;
        }

        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .date-input-wrapper {
            max-width: 100%;
        }

        .btn-go {
            margin-left: 0;
            margin-top: 0.5rem;
            width: 100%;
            justify-content: center;
        }

        .table-responsive {
            font-size: 0.8125rem;
        }

        .exportable-table thead th,
        .exportable-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-calendar-day"></i>
            Daily Fleet Activity
        </h2>
        <p>Real-time fleet operations and vehicle activity overview</p>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            <!-- Date Selector -->
            <div class="date-selector-card">
                <h5>
                    <i class="fas fa-calendar-alt"></i>
                    Select Date
                </h5>
                <form method="get" class="d-flex flex-wrap align-items-center">
                    <div class="date-input-wrapper">
                        <input type="text"
                               id="activityDate"
                               name="date"
                               value="@ViewBag.Date.ToString("yyyy-MM-dd")"
                               class="form-control"
                               readonly />
                    </div>
                    <button type="submit" class="btn btn-go">
                        <i class="fas fa-search"></i>
                        View Activity
                    </button>
                </form>
            </div>

            @await Html.PartialAsync("_ExportControls")

            <!-- Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card" style="--accent-color: #3b82f6; --icon-bg: rgba(59, 130, 246, 0.1); --icon-color: #3b82f6;">
                    <div class="metric-header">
                        <div>
                            <div class="metric-label">Total Vehicles</div>
                            <div class="metric-value">@Model.TotalVehicles</div>
                        </div>
                        <div class="metric-icon">
                            <i class="fas fa-car"></i>
                        </div>
                    </div>
                </div>

                <div class="metric-card" style="--accent-color: #10b981; --icon-bg: rgba(16, 185, 129, 0.1); --icon-color: #10b981;">
                    <div class="metric-header">
                        <div>
                            <div class="metric-label">Active Vehicles</div>
                            <div class="metric-value">@Model.ActiveVehicles</div>
                        </div>
                        <div class="metric-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </div>

                <div class="metric-card" style="--accent-color: #f59e0b; --icon-bg: rgba(245, 158, 11, 0.1); --icon-color: #f59e0b;">
                    <div class="metric-header">
                        <div>
                            <div class="metric-label">Idle Vehicles</div>
                            <div class="metric-value">@Model.IdleVehicles</div>
                        </div>
                        <div class="metric-icon">
                            <i class="fas fa-pause-circle"></i>
                        </div>
                    </div>
                </div>

                <div class="metric-card" style="--accent-color: #8b5cf6; --icon-bg: rgba(139, 92, 246, 0.1); --icon-color: #8b5cf6;">
                    <div class="metric-header">
                        <div>
                            <div class="metric-label">Trips Completed</div>
                            <div class="metric-value">@Model.TripsCompleted</div>
                        </div>
                        <div class="metric-icon">
                            <i class="fas fa-route"></i>
                        </div>
                    </div>
                </div>

                <div class="metric-card" style="--accent-color: #ec4899; --icon-bg: rgba(236, 72, 153, 0.1); --icon-color: #ec4899;">
                    <div class="metric-header">
                        <div>
                            <div class="metric-label">Total Distance</div>
                            <div class="metric-value">@Model.TotalDistanceKm.ToString("N0")<small>km</small></div>
                        </div>
                        <div class="metric-icon">
                            <i class="fas fa-road"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.VehicleActivities != null && Model.VehicleActivities.Any())
            {
                <!-- Vehicle Activity Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h5>
                            <i class="fas fa-list"></i>
                            Vehicle Activity Details
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table exportable-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-hashtag me-2"></i>Vehicle Plate</th>
                                    <th><i class="fas fa-car me-2"></i>Make / Model</th>
                                    <th><i class="fas fa-road me-2"></i>Distance</th>
                                    <th><i class="fas fa-map-marked-alt me-2"></i>Trips</th>
                                    <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.VehicleActivities)
                                {
                                    var statusClass = v.Status?.ToLower() ?? "inactive";
                                    var statusIcon = statusClass switch
                                    {
                                        "active" => "fa-check-circle",
                                        "idle" => "fa-pause-circle",
                                        "maintenance" => "fa-wrench",
                                        _ => "fa-times-circle"
                                    };

                                    <tr>
                                        <td>
                                            <span class="vehicle-plate">
                                                <i class="fas fa-id-card"></i>
                                                @v.PlateNo
                                            </span>
                                        </td>
                                        <td>
                                            <span class="vehicle-info">
                                                <i class="fas fa-car"></i>
                                                @v.VehicleMake @v.VehicleModel
                                            </span>
                                        </td>
                                        <td>
                                            <span class="distance-badge">
                                                <i class="fas fa-route"></i>
                                                @v.DistanceKm.ToString("N2") km
                                            </span>
                                        </td>
                                        <td>
                                            <span class="trips-badge">
                                                <i class="fas fa-map-marked-alt"></i>
                                                @v.TripsCount
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-badge @statusClass">
                                                <i class="fas @statusIcon"></i>
                                                @(v.Status ?? "N/A")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-car-side"></i>
                    <h4>No vehicle activity found</h4>
                    <p>No vehicles were active on the selected date</p>
                </div>
            }
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.getElementById('activityDate');

            if (dateInput && typeof flatpickr !== 'undefined') {
                flatpickr(dateInput, {
                    dateFormat: 'Y-m-d',
                    maxDate: 'today',
                    defaultDate: dateInput.value
                });
            }
        });
    </script>










































