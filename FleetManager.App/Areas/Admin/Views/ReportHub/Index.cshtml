            <div class="card p-3 h-100">
                <h6 class="text-muted mb-2">Active Vehicles</h6>
                <h3 class="mb-0">@Model.ActiveVehicles / @Model.TotalVehicles</h3>
                <small class="text-muted">As of @DateTime.UtcNow.ToString("yyyy-MM-dd")</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <h6 class="text-muted mb-2">Incidents</h6>
                <h3 class="mb-0">@Model.TotalIncidents</h3>
                <small class="text-muted">(@fromDt:yyyy-MM-dd → @toDt:yyyy-MM-dd)</small>
            </div>
        </div>
    </div>

    <div class="mt-2 mb-4">
        <h4>Quick Reports</h4>
        <div class="list-group">
            
            <a asp-area="Admin" asp-controller="ReportHub" asp-action="TripSummary"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Trip Summary</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="DriverPerformance"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Driver Performance</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="FuelConsumption"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Fuel Consumption</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="VehicleUtilization"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Vehicle Utilization</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="IncidentReport"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Incident Report</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="LicenseExpiry"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Driver License Expiry</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="VehicleDocs"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Vehicle Documentation</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="MaintenanceSchedule"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Maintenance Schedule</a>

            <a asp-area="Admin" asp-controller="ReportHub" asp-action="VehicleComparison"
               class="list-group-item list-group-item-action"
               asp-route-from="@fromIso()" asp-route-to="@toIso()">Vehicle Comparison</a>
        </div>
    </div>
</div>




 *@