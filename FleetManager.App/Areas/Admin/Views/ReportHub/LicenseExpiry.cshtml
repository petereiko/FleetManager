@using FleetManager.Business.DataObjects.ReportsCenter
@model List<DriverLicenseExpiryDto>
@{
    ViewBag.Title = "Driver License Expiry";
    ViewBag.ExportFileName = "license_expiry";
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .report-header h2 {
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .report-header p {
                margin: 0.5rem 0 0 0;
                opacity: 0.95;
                font-size: 0.9375rem;
            }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 3rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .date-filter-card {
            background: var(--gray-50);
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

            .date-filter-card h5 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .filter-group {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: 1rem;
        }

        .date-input-wrapper {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .date-input-wrapper label {
                font-size: 0.8125rem;
                font-weight: 600;
                color: var(--gray-700);
                margin-bottom: 0.5rem;
                display: flex;
                align-items: center;
                gap: 0.375rem;
            }

            .date-input-wrapper input {
                border: 2px solid var(--gray-200);
                border-radius: 10px;
                padding: 0.625rem 1rem;
                font-size: 0.9375rem;
                transition: all 0.2s;
                width: 100%;
                background: white;
            }

                .date-input-wrapper input:focus {
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
                    outline: none;
                }

        .btn-filter-apply {
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.625rem 1.75rem;
            font-weight: 600;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            align-self: flex-end;
        }

            .btn-filter-apply:hover {
                background: var(--primary-dark);
                transform: translateY(-1px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            border-left: 4px solid var(--accent-color);
            transition: all 0.2s;
        }

            .summary-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .summary-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .summary-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            background: var(--icon-bg);
            color: var(--icon-color);
        }

        .summary-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            color: var(--gray-600);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .summary-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--gray-900);
            line-height: 1;
        }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

            .table-header h5 {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .table-responsive {
            border-radius: 0 0 12px 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

            .exportable-table thead {
                background: var(--gray-800);
                color: white;
            }

                .exportable-table thead th {
                    padding: 1rem 1.25rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    border: none;
                    white-space: nowrap;
                }

            .exportable-table tbody tr {
                border-bottom: 1px solid var(--gray-200);
                transition: all 0.2s;
            }

                .exportable-table tbody tr:hover {
                    background-color: var(--gray-50);
                }

            .exportable-table tbody td {
                padding: 1.25rem 1.25rem;
                vertical-align: middle;
                color: var(--gray-700);
            }

            .exportable-table tbody tr:last-child {
                border-bottom: none;
            }

        .driver-cell {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .driver-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .driver-name {
            font-weight: 600;
            color: var(--gray-900);
            font-size: 0.9375rem;
        }

        .license-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--gray-100);
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-weight: 600;
            font-size: 0.9375rem;
            color: var(--gray-800);
        }

            .license-badge i {
                color: var(--warning-color);
            }

        .expiry-date {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .expiry-date-main {
            font-weight: 600;
            color: var(--gray-900);
            font-size: 0.9375rem;
        }

        .expiry-countdown {
            font-size: 0.75rem;
            color: var(--gray-600);
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

            .status-badge.expired {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
                border: 2px solid rgba(239, 68, 68, 0.2);
            }

            .status-badge.expiring-soon {
                background: rgba(245, 158, 11, 0.1);
                color: var(--warning-color);
                border: 2px solid rgba(245, 158, 11, 0.2);
            }

            .status-badge.valid {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success-color);
                border: 2px solid rgba(16, 185, 129, 0.2);
            }

            .status-badge.unknown {
                background: rgba(107, 114, 128, 0.1);
                color: var(--gray-600);
                border: 2px solid rgba(107, 114, 128, 0.2);
            }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

            .empty-state i {
                font-size: 4rem;
                color: var(--gray-400);
                margin-bottom: 1rem;
            }

            .empty-state h4 {
                color: var(--gray-700);
                margin-bottom: 0.5rem;
            }

        @@media (max-width: 768px) {
            .report-header

        {
            padding: 1.5rem 0;
        }

        .report-card-body {
            padding: 1rem;
        }

        .filter-group {
            flex-direction: column;
            align-items: stretch;
        }

        .date-input-wrapper {
            min-width: 100%;
        }

        .btn-filter-apply {
            width: 100%;
            justify-content: center;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            font-size: 0.8125rem;
        }

        .exportable-table thead th,
        .exportable-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .driver-cell {
            flex-direction: column;
            align-items: flex-start;
        }

        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-id-card"></i>
            Driver License Expiry Report
        </h2>
        <p>Monitor and manage driver license expiration dates</p>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            <!-- Date Range Filter -->
            <div class="date-filter-card">
                <h5>
                    <i class="fas fa-calendar-alt"></i>
                    Expiry Date Range
                </h5>
                <form method="get">
                    <div class="filter-group">
                        <div class="date-input-wrapper">
                            <label>
                                <i class="fas fa-calendar"></i>
                                From Date
                            </label>
                            <input type="text"
                                   id="filterFrom"
                                   name="from"
                                   class="form-control"
                                   value="@ViewBag.From.ToString("yyyy-MM-dd")"
                                   readonly />
                        </div>
                        <div class="date-input-wrapper">
                            <label>
                                <i class="fas fa-calendar"></i>
                                To Date
                            </label>
                            <input type="text"
                                   id="filterTo"
                                   name="to"
                                   class="form-control"
                                   value="@ViewBag.To.ToString("yyyy-MM-dd")"
                                   readonly />
                        </div>
                        <button type="submit" class="btn btn-filter-apply">
                            <i class="fas fa-search"></i>
                            Apply Filter
                        </button>
                    </div>
                </form>
            </div>

            @await Html.PartialAsync("_ExportControls")

            @if (Model != null && Model.Any())
            {
                <!-- Summary Statistics -->
                <div class="summary-cards">
                    @{
                        var expiredCount = Model.Count(d => d.Status?.ToLower().Contains("expired") == true);
                        var expiringSoonCount = Model.Count(d => d.Status?.ToLower().Contains("expiring") == true || d.Status?.ToLower().Contains("soon") == true);
                        var validCount = Model.Count(d => d.Status?.ToLower().Contains("valid") == true);
                        var totalCount = Model.Count;
                    }

                    <div class="summary-card" style="--accent-color: #ef4444; --icon-bg: rgba(239, 68, 68, 0.1); --icon-color: #ef4444;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Expired</div>
                                <div class="summary-value">@expiredCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-times-circle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #f59e0b; --icon-bg: rgba(245, 158, 11, 0.1); --icon-color: #f59e0b;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Expiring Soon</div>
                                <div class="summary-value">@expiringSoonCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #10b981; --icon-bg: rgba(16, 185, 129, 0.1); --icon-color: #10b981;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Valid</div>
                                <div class="summary-value">@validCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #3b82f6; --icon-bg: rgba(59, 130, 246, 0.1); --icon-color: #3b82f6;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Total Drivers</div>
                                <div class="summary-value">@totalCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- License Expiry Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h5>
                            <i class="fas fa-list-alt"></i>
                            License Details
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table exportable-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-2"></i>Driver</th>
                                    <th><i class="fas fa-id-card me-2"></i>License Number</th>
                                    <th><i class="fas fa-calendar-alt me-2"></i>Expiry Date</th>
                                    <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model)
                                {
                                    var initials = string.IsNullOrEmpty(d.DriverName) ? "?" :
                                    d.DriverName.Split(' ').Take(2)
                                    .Select(n => n.FirstOrDefault())
                                    .Aggregate("", (acc, c) => acc + c);

                                    var statusClass = d.Status?.ToLower().Contains("expired") == true ? "expired" :
                                    d.Status?.ToLower().Contains("expiring") == true || d.Status?.ToLower().Contains("soon") == true ? "expiring-soon" :
                                    d.Status?.ToLower().Contains("valid") == true ? "valid" : "unknown";

                                    var statusIcon = statusClass == "expired" ? "fa-times-circle" :
                                    statusClass == "expiring-soon" ? "fa-exclamation-triangle" :
                                    statusClass == "valid" ? "fa-check-circle" : "fa-question-circle";

                                    // Calculate days until expiry
                                    string countdown = "";
                                    if (d.LicenseExpiryDate.HasValue)
                                    {
                                        var daysUntil = (d.LicenseExpiryDate.Value - DateTime.UtcNow).Days;
                                        if (daysUntil < 0)
                                        {
                                            countdown = $"Expired {Math.Abs(daysUntil)} days ago";
                                        }
                                        else if (daysUntil == 0)
                                        {
                                            countdown = "Expires today";
                                        }
                                        else
                                        {
                                            countdown = $"{daysUntil} days remaining";
                                        }
                                    }

                                    <tr>
                                        <td>
                                            <div class="driver-cell">
                                                <div class="driver-avatar">@initials</div>
                                                <div class="driver-name">@d.DriverName</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="license-badge">
                                                <i class="fas fa-id-card-alt"></i>
                                                @(d.LicenseNumber ?? "N/A")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="expiry-date">
                                                <span class="expiry-date-main">
                                                    @(d.LicenseExpiryDate?.ToString("MMM d, yyyy") ?? "N/A")
                                                </span>
                                                @if (!string.IsNullOrEmpty(countdown))
                                                {
                                                    <span class="expiry-countdown">
                                                        <i class="fas fa-clock"></i>
                                                        @countdown
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-badge @statusClass">
                                                <i class="fas @statusIcon"></i>
                                                @(d.Status ?? "Unknown")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-id-card"></i>
                    <h4>No license expiry records found</h4>
                    <p>Try adjusting your date range to see more results</p>
                </div>
            }
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fromInput = document.getElementById('filterFrom');
            const toInput = document.getElementById('filterTo');

            if (fromInput && typeof flatpickr !== 'undefined') {
                flatpickr(fromInput, {
                    dateFormat: 'Y-m-d',
                    onChange: function(selectedDates, dateStr) {
                        if (toInput._flatpickr) {
                            toInput._flatpickr.set('minDate', dateStr);
                        }
                    }
                });
            }

            if (toInput && typeof flatpickr !== 'undefined') {
                flatpickr(toInput, {
                    dateFormat: 'Y-m-d',
                    minDate: fromInput.value || null
                });
            }
        });
    </script>



























