@using FleetManager.Business.DataObjects.ReportsCenter
@model List<MaintenanceScheduleDto>
@{
    ViewBag.Title = "Maintenance Schedule";
    ViewBag.ExportFileName = "maintenance_schedule";
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            --purple-color: #8b5cf6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .report-header h2 {
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .report-header p {
                margin: 0.5rem 0 0 0;
                opacity: 0.95;
                font-size: 0.9375rem;
            }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 3rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            border-left: 4px solid var(--accent-color);
            transition: all 0.2s;
        }

            .summary-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .summary-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .summary-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            background: var(--icon-bg);
            color: var(--icon-color);
        }

        .summary-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            color: var(--gray-600);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .summary-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--gray-900);
            line-height: 1;
        }

            .summary-value small {
                font-size: 0.875rem;
                color: var(--gray-600);
            }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

            .table-header h5 {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .table-responsive {
            border-radius: 0 0 12px 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

            .exportable-table thead {
                background: var(--gray-800);
                color: white;
            }

                .exportable-table thead th {
                    padding: 1rem 1.25rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    border: none;
                    white-space: nowrap;
                }

            .exportable-table tbody tr {
                border-bottom: 1px solid var(--gray-200);
                transition: all 0.2s;
            }

                .exportable-table tbody tr:hover {
                    background-color: var(--gray-50);
                }

                .exportable-table tbody tr.overdue-row {
                    background: rgba(239, 68, 68, 0.03);
                }

                    .exportable-table tbody tr.overdue-row:hover {
                        background: rgba(239, 68, 68, 0.05);
                    }

            .exportable-table tbody td {
                padding: 1.25rem 1.25rem;
                vertical-align: middle;
                color: var(--gray-700);
            }

            .exportable-table tbody tr:last-child {
                border-bottom: none;
            }

        .vehicle-cell {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .vehicle-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.125rem;
        }

        .vehicle-plate {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray-900);
        }

        .date-cell {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .date-main {
            font-weight: 600;
            color: var(--gray-900);
            font-size: 0.9375rem;
        }

        .date-countdown {
            font-size: 0.75rem;
            color: var(--gray-600);
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

            .date-countdown.overdue {
                color: var(--danger-color);
                font-weight: 600;
            }

            .date-countdown.urgent {
                color: var(--warning-color);
                font-weight: 600;
            }

        .overdue-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

            .overdue-badge.yes {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
                border: 2px solid rgba(239, 68, 68, 0.2);
            }

            .overdue-badge.no {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success-color);
                border: 2px solid rgba(16, 185, 129, 0.2);
            }

        .cost-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.9375rem;
        }

        .priority-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

            .priority-indicator.critical {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
            }

            .priority-indicator.high {
                background: rgba(245, 158, 11, 0.1);
                color: var(--warning-color);
            }

            .priority-indicator.normal {
                background: rgba(59, 130, 246, 0.1);
                color: var(--info-color);
            }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

            .empty-state i {
                font-size: 4rem;
                color: var(--gray-400);
                margin-bottom: 1rem;
            }

            .empty-state h4 {
                color: var(--gray-700);
                margin-bottom: 0.5rem;
            }

        @@media (max-width: 768px) {
            .report-header

        {
            padding: 1.5rem 0;
        }

        .report-card-body {
            padding: 1rem;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            font-size: 0.8125rem;
        }

        .exportable-table thead th,
        .exportable-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .vehicle-cell {
            flex-direction: column;
            align-items: flex-start;
        }

        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-wrench"></i>
            Maintenance Schedule
        </h2>
        <p>Track upcoming and overdue vehicle maintenance</p>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            @await Html.PartialAsync("_ReportFilters", ViewBag.Filter as ReportFilter ?? new ReportFilter())

            @await Html.PartialAsync("_ExportControls")

            @if (Model != null && Model.Any())
            {
                <!-- Summary Statistics -->
                <div class="summary-cards">
                    @{
                        var overdueCount = Model.Count(m => m.IsOverdue);
                        var upcomingCount = Model.Count(m => !m.IsOverdue && m.NextMaintenanceDate.HasValue && (m.NextMaintenanceDate.Value - DateTime.UtcNow).Days <= 30);
                        var totalCost = Model.Sum(m => m.ProjectedCost);
                        var totalVehicles = Model.Count;
                    }

                    <div class="summary-card" style="--accent-color: #ef4444; --icon-bg: rgba(239, 68, 68, 0.1); --icon-color: #ef4444;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Overdue</div>
                                <div class="summary-value">@overdueCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-exclamation-circle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #f59e0b; --icon-bg: rgba(245, 158, 11, 0.1); --icon-color: #f59e0b;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Due Soon (30 days)</div>
                                <div class="summary-value">@upcomingCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #10b981; --icon-bg: rgba(16, 185, 129, 0.1); --icon-color: #10b981;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Projected Cost</div>
                                <div class="summary-value">₦@totalCost.ToString("N0")</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #8b5cf6; --icon-bg: rgba(139, 92, 246, 0.1); --icon-color: #8b5cf6;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Total Vehicles</div>
                                <div class="summary-value">@totalVehicles</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-car"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Maintenance Schedule Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h5>
                            <i class="fas fa-calendar-alt"></i>
                            Maintenance Details
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table exportable-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-car me-2"></i>Vehicle</th>
                                    <th><i class="fas fa-calendar me-2"></i>Next Maintenance</th>
                                    <th><i class="fas fa-exclamation-triangle me-2"></i>Status</th>
                                    <th><i class="fas fa-money-bill-wave me-2"></i>Projected Cost</th>
                                    <th><i class="fas fa-flag me-2"></i>Priority</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.OrderByDescending(x => x.IsOverdue).ThenBy(x => x.NextMaintenanceDate))
                                {
                                    // Calculate days until maintenance
                                    string countdown = "";
                                    string countdownClass = "";
                                    string priority = "Normal";
                                    string priorityClass = "normal";

                                    if (m.NextMaintenanceDate.HasValue)
                                    {
                                        var daysUntil = (m.NextMaintenanceDate.Value - DateTime.UtcNow).Days;

                                        if (m.IsOverdue || daysUntil < 0)
                                        {
                                            countdown = $"{Math.Abs(daysUntil)} days overdue";
                                            countdownClass = "overdue";
                                            priority = "Critical";
                                            priorityClass = "critical";
                                        }
                                        else if (daysUntil <= 7)
                                        {
                                            countdown = $"{daysUntil} days remaining";
                                            countdownClass = "urgent";
                                            priority = "High";
                                            priorityClass = "high";
                                        }
                                        else if (daysUntil <= 30)
                                        {
                                            countdown = $"{daysUntil} days remaining";
                                            countdownClass = "urgent";
                                            priority = "High";
                                            priorityClass = "high";
                                        }
                                        else
                                        {
                                            countdown = $"{daysUntil} days remaining";
                                            priority = "Normal";
                                            priorityClass = "normal";
                                        }
                                    }

                                    <tr class="@(m.IsOverdue ? "overdue-row" : "")">
                                        <td>
                                            <div class="vehicle-cell">
                                                <div class="vehicle-icon">
                                                    <i class="fas fa-car"></i>
                                                </div>
                                                <div class="vehicle-plate">@m.PlateNo</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <span class="date-main">
                                                    @(m.NextMaintenanceDate?.ToString("MMM d, yyyy") ?? "Not scheduled")
                                                </span>
                                                @if (!string.IsNullOrEmpty(countdown))
                                                {
                                                    <span class="date-countdown @countdownClass">
                                                        <i class="fas fa-clock"></i>
                                                        @countdown
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="overdue-badge @(m.IsOverdue ? "yes" : "no")">
                                                <i class="fas @(m.IsOverdue ? "fa-times-circle" : "fa-check-circle")"></i>
                                                @(m.IsOverdue ? "Overdue" : "On Schedule")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="cost-badge">
                                                <i class="fas fa-naira-sign"></i>
                                                ₦@m.ProjectedCost.ToString("N2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="priority-indicator @priorityClass">
                                                <i class="fas @(priorityClass == "critical" ? "fa-exclamation-circle" : priorityClass == "high" ? "fa-exclamation-triangle" : "fa-info-circle")"></i>
                                                @priority
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-wrench"></i>
                    <h4>No maintenance schedule found</h4>
                    <p>No vehicles have scheduled maintenance at this time</p>
                </div>
            }
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>



























