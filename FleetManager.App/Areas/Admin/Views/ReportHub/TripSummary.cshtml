@using FleetManager.Business.DataObjects.ReportsCenter
@using FleetManager.Business.UtilityModels
@model PaginatedResult<TripSummaryDto>
@{
    ViewBag.Title = "Trip Summary";
    ViewBag.ExportFileName = "trip_summary";
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --info-color: #3b82f6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .report-header h2 {
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

            .exportable-table thead {
                background: var(--gray-800);
                color: white;
            }

                .exportable-table thead th {
                    padding: 1rem 0.75rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    border: none;
                    white-space: nowrap;
                }

            .exportable-table tbody tr {
                border-bottom: 1px solid var(--gray-200);
                transition: background-color 0.2s;
            }

                .exportable-table tbody tr:hover {
                    background-color: var(--gray-50);
                }

            .exportable-table tbody td {
                padding: 1rem 0.75rem;
                vertical-align: middle;
                color: var(--gray-700);
            }

            .exportable-table tbody tr:last-child {
                border-bottom: none;
            }

        .trip-number {
            font-weight: 600;
            color: var(--primary-color);
        }

        .driver-name {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gray-800);
        }

            .driver-name i {
                color: var(--info-color);
            }

        .vehicle-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Courier New', monospace;
            font-weight: 600;
            color: var(--gray-800);
        }

            .vehicle-info i {
                color: var(--success-color);
            }

        .location-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            background: var(--gray-100);
            border-radius: 6px;
            font-size: 0.8125rem;
            color: var(--gray-700);
        }

        .distance-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.75rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .fuel-cost {
            font-weight: 600;
            color: var(--success-color);
            font-size: 0.9375rem;
        }

        .pagination-container {
            padding: 1.5rem 2rem;
            background: var(--gray-50);
            border-top: 2px solid var(--gray-200);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .pagination {
            margin: 0;
            display: flex;
            gap: 0.5rem;
        }

        .page-item.disabled .page-link {
            background: var(--gray-100);
            border-color: var(--gray-200);
            color: var(--gray-600);
            cursor: not-allowed;
        }

        .page-link {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            border: 2px solid var(--gray-200);
            color: var(--primary-color);
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            background: white;
        }

            .page-link:hover:not(.disabled) {
                background: var(--primary-color);
                color: white;
                border-color: var(--primary-color);
                transform: translateY(-1px);
            }

        .page-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gray-700);
            font-weight: 600;
            padding: 0.5rem 1rem;
            background: white;
            border-radius: 8px;
            border: 2px solid var(--gray-200);
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

            .empty-state i {
                font-size: 4rem;
                color: var(--gray-400);
                margin-bottom: 1rem;
            }

            .empty-state h4 {
                color: var(--gray-700);
                margin-bottom: 0.5rem;
            }

        @@media (max-width: 768px) {
            .report-header

        {
            padding: 1.5rem 0;
        }

        .report-card-body {
            padding: 1rem;
        }

        .table-responsive {
            font-size: 0.8125rem;
        }

        .exportable-table thead th,
        .exportable-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .pagination-container {
            flex-direction: column;
            align-items: stretch;
        }

        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-map-marked-alt"></i>
            Trip Summary Report
        </h2>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            @await Html.PartialAsync("_ReportFilters", ViewBag.Filter as ReportFilter ?? new ReportFilter())

            @await Html.PartialAsync("_ExportControls")
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-container">
                <div class="table-responsive">
                    <table class="table exportable-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag me-1"></i>Trip #</th>
                                <th><i class="fas fa-user me-1"></i>Driver</th>
                                <th><i class="fas fa-car me-1"></i>Vehicle</th>
                                <th><i class="fas fa-map-marker-alt me-1"></i>Origin</th>
                                <th><i class="fas fa-flag-checkered me-1"></i>Destination</th>
                                <th><i class="fas fa-calendar-check me-1"></i>Scheduled</th>
                                <th><i class="fas fa-play-circle me-1"></i>Start</th>
                                <th><i class="fas fa-stop-circle me-1"></i>End</th>
                                <th><i class="fas fa-road me-1"></i>Distance</th>
                                <th><i class="fas fa-gas-pump me-1"></i>Fuel Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Items)
                            {
                                <tr>
                                    <td><span class="trip-number">#@t.TripNumber</span></td>
                                    <td>
                                        <span class="driver-name">
                                            <i class="fas fa-user-circle"></i>
                                            @t.DriverName
                                        </span>
                                    </td>
                                    <td>
                                        <span class="vehicle-info">
                                            <i class="fas fa-car"></i>
                                            @t.VehiclePlate
                                        </span>
                                    </td>
                                    <td>
                                        <span class="location-badge">
                                            <i class="fas fa-map-marker-alt"></i>
                                            @t.Origin
                                        </span>
                                    </td>
                                    <td>
                                        <span class="location-badge">
                                            <i class="fas fa-flag-checkered"></i>
                                            @t.Destination
                                        </span>
                                    </td>
                                    <td>@t.ScheduledStart.ToString("MMM d, yyyy h:mm tt")</td>
                                    <td>@(t.ActualStart?.ToString("MMM d, h:mm tt") ?? "-")</td>
                                    <td>@(t.ActualEnd?.ToString("MMM d, h:mm tt") ?? "-")</td>
                                    <td>
                                        @if (t.ActualDistance.HasValue)
                                        {
                                            <span class="distance-badge">
                                                <i class="fas fa-route"></i>
                                                @t.ActualDistance.Value.ToString("N2") km
                                            </span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (t.ActualFuelCost.HasValue)
                                        {
                                            <span class="fuel-cost">₦@t.ActualFuelCost.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination-container">
                    <div class="page-info">
                        <i class="fas fa-info-circle"></i>
                        Page @Model.Page of @Model.TotalPages
                        <span class="ms-2 text-muted">•</span>
                        <span class="ms-2">@Model.TotalCount total trips</span>
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @{
                                var current = Model.Page;
                                var total = Model.TotalPages;
                            }
                            <li class="page-item @(current == 1 ? "disabled" : "")">
                                <a class="page-link @(current == 1 ? "disabled" : "")"
                                   href="@(current == 1 ? "#" : Url.Action("TripSummary", new { page = current - 1, from = ViewBag.From, to = ViewBag.To }))">
                                    <i class="fas fa-chevron-left me-1"></i>
                                    Previous
                                </a>
                            </li>
                            <li class="page-item @(current >= total ? "disabled" : "")">
                                <a class="page-link @(current >= total ? "disabled" : "")"
                                   href="@(current >= total ? "#" : Url.Action("TripSummary", new { page = current + 1, from = ViewBag.From, to = ViewBag.To }))">
                                    Next
                                    <i class="fas fa-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h4>No trips found</h4>
                <p>Try adjusting your filters to see more results</p>
            </div>
        }
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>





































