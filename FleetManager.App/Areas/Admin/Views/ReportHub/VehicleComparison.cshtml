@using FleetManager.Business.DataObjects.ReportsCenter
@model List<VehicleComparisonDto>
@{
    ViewBag.Title = "Vehicle Comparison";
    ViewBag.ExportFileName = "vehicle_comparison";
    var filter = ViewBag.Filter as ReportFilter ?? new ReportFilter();
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            --purple-color: #8b5cf6;
            --cyan-color: #06b6d4;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .report-header h2 {
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .report-header p {
                margin: 0.5rem 0 0 0;
                opacity: 0.95;
                font-size: 0.9375rem;
            }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 3rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            border-left: 4px solid var(--accent-color);
            transition: all 0.2s;
        }

            .summary-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .summary-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .summary-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            background: var(--icon-bg);
            color: var(--icon-color);
        }

        .summary-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            color: var(--gray-600);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .summary-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--gray-900);
            line-height: 1;
        }

            .summary-value small {
                font-size: 0.875rem;
                color: var(--gray-600);
                font-weight: 500;
            }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

            .table-header h5 {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                color: var(--gray-800);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .table-responsive {
            border-radius: 0 0 12px 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

            .exportable-table thead {
                background: var(--gray-800);
                color: white;
            }

                .exportable-table thead th {
                    padding: 1rem 1.25rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    border: none;
                    white-space: nowrap;
                }

            .exportable-table tbody tr {
                border-bottom: 1px solid var(--gray-200);
                transition: all 0.2s;
            }

                .exportable-table tbody tr:hover {
                    background-color: var(--gray-50);
                }

                .exportable-table tbody tr.best-performer {
                    background: rgba(16, 185, 129, 0.05);
                }

                    .exportable-table tbody tr.best-performer:hover {
                        background: rgba(16, 185, 129, 0.08);
                    }

                .exportable-table tbody tr.worst-performer {
                    background: rgba(239, 68, 68, 0.03);
                }

                    .exportable-table tbody tr.worst-performer:hover {
                        background: rgba(239, 68, 68, 0.05);
                    }

            .exportable-table tbody td {
                padding: 1.25rem 1.25rem;
                vertical-align: middle;
                color: var(--gray-700);
            }

            .exportable-table tbody tr:last-child {
                border-bottom: none;
            }

        .vehicle-cell {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .vehicle-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.125rem;
        }

            .vehicle-icon.best {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            }

            .vehicle-icon.worst {
                background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            }

        .vehicle-plate {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray-900);
        }

        .performance-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }

            .performance-badge.best {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success-color);
            }

            .performance-badge.worst {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
            }

        .distance-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(139, 92, 246, 0.1);
            color: var(--purple-color);
            border-radius: 8px;
            font-weight: 600;
        }

        .cost-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9375rem;
        }

        .fuel-cost {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .maintenance-cost {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning-color);
        }

        .combined-cost {
            background: rgba(59, 130, 246, 0.1);
            color: var(--info-color);
            font-weight: 700;
        }

        .efficiency-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.9375rem;
        }

            .efficiency-badge.excellent {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success-color);
            }

            .efficiency-badge.good {
                background: rgba(59, 130, 246, 0.1);
                color: var(--info-color);
            }

            .efficiency-badge.average {
                background: rgba(245, 158, 11, 0.1);
                color: var(--warning-color);
            }

            .efficiency-badge.poor {
                background: rgba(239, 68, 68, 0.1);
                color: var(--danger-color);
            }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

            .empty-state i {
                font-size: 4rem;
                color: var(--gray-400);
                margin-bottom: 1rem;
            }

            .empty-state h4 {
                color: var(--gray-700);
                margin-bottom: 0.5rem;
            }

        @@media (max-width: 768px) {
            .report-header

        {
            padding: 1.5rem 0;
        }

        .report-card-body {
            padding: 1rem;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            font-size: 0.8125rem;
        }

        .exportable-table thead th,
        .exportable-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .vehicle-cell {
            flex-direction: column;
            align-items: flex-start;
        }

        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-balance-scale"></i>
            Vehicle Comparison Report
        </h2>
        <p>Compare vehicle performance, costs, and efficiency metrics</p>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            @await Html.PartialAsync("_ReportFilters", filter)

            @await Html.PartialAsync("_ExportControls")

            @if (Model != null && Model.Any())
            {
                <!-- Summary Statistics -->
                <div class="summary-cards">
                    @{
                        var totalDistance = Model.Sum(v => v.TotalDistance);
                        var totalFuelCost = Model.Sum(v => v.FuelCost);
                        var totalMaintenanceCost = Model.Sum(v => v.MaintenanceCost);
                        var totalCombinedCost = totalFuelCost + totalMaintenanceCost;
                        var avgCostPerKm = totalDistance > 0 ? totalCombinedCost / totalDistance : 0;
                        var vehicleCount = Model.Count;
                    }

                    <div class="summary-card" style="--accent-color: #8b5cf6; --icon-bg: rgba(139, 92, 246, 0.1); --icon-color: #8b5cf6;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Total Distance</div>
                                <div class="summary-value">@totalDistance.ToString("N0")<small> km</small></div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-road"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #10b981; --icon-bg: rgba(16, 185, 129, 0.1); --icon-color: #10b981;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Total Fuel Cost</div>
                                <div class="summary-value">₦@totalFuelCost.ToString("N0")</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-gas-pump"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #f59e0b; --icon-bg: rgba(245, 158, 11, 0.1); --icon-color: #f59e0b;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Maintenance Cost</div>
                                <div class="summary-value">₦@totalMaintenanceCost.ToString("N0")</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-wrench"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #3b82f6; --icon-bg: rgba(59, 130, 246, 0.1); --icon-color: #3b82f6;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Avg Cost/Km</div>
                                <div class="summary-value">₦@avgCostPerKm.ToString("N2")</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #06b6d4; --icon-bg: rgba(6, 182, 212, 0.1); --icon-color: #06b6d4;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Vehicles Compared</div>
                                <div class="summary-value">@vehicleCount</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-car"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Vehicle Comparison Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h5>
                            <i class="fas fa-th-list"></i>
                            Detailed Comparison
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table exportable-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-car me-2"></i>Vehicle</th>
                                    <th><i class="fas fa-road me-2"></i>Distance</th>
                                    <th><i class="fas fa-gas-pump me-2"></i>Fuel Cost</th>
                                    <th><i class="fas fa-wrench me-2"></i>Maintenance</th>
                                    <th><i class="fas fa-calculator me-2"></i>Combined Cost</th>
                                    <th><i class="fas fa-chart-bar me-2"></i>Efficiency</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sortedVehicles = Model.OrderBy(v => v.CostPerKm).ToList();
                                    var bestVehicle = sortedVehicles.FirstOrDefault();
                                    var worstVehicle = sortedVehicles.LastOrDefault();
                                }
                                @foreach (var v in sortedVehicles)
                                {
                                    var isBest = v == bestVehicle;
                                    var isWorst = v == worstVehicle && Model.Count > 1;
                                    var rowClass = isBest ? "best-performer" : isWorst ? "worst-performer" : "";
                                    var iconClass = isBest ? "best" : isWorst ? "worst" : "";

                                    // Calculate efficiency rating
                                    var efficiencyClass = v.CostPerKm <= 100 ? "excellent" :
                                    v.CostPerKm <= 150 ? "good" :
                                    v.CostPerKm <= 200 ? "average" : "poor";

                                    var efficiencyIcon = v.CostPerKm <= 100 ? "fa-star" :
                                    v.CostPerKm <= 150 ? "fa-thumbs-up" :
                                    v.CostPerKm <= 200 ? "fa-exclamation-circle" : "fa-exclamation-triangle";

                                    <tr class="@rowClass">
                                        <td>
                                            <div class="vehicle-cell">
                                                <div class="vehicle-icon @iconClass">
                                                    <i class="fas fa-car"></i>
                                                </div>
                                                <div>
                                                    <span class="vehicle-plate">@v.PlateNo</span>
                                                    @if (isBest)
                                                    {
                                                        <span class="performance-badge best">
                                                            <i class="fas fa-trophy"></i>
                                                            Best
                                                        </span>
                                                    }
                                                    else if (isWorst)
                                                    {
                                                        <span class="performance-badge worst">
                                                            <i class="fas fa-arrow-down"></i>
                                                            Highest Cost
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="distance-badge">
                                                <i class="fas fa-route"></i>
                                                @v.TotalDistance.ToString("N2") km
                                            </span>
                                        </td>
                                        <td>
                                            <span class="cost-badge fuel-cost">
                                                <i class="fas fa-gas-pump"></i>
                                                ₦@v.FuelCost.ToString("N2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="cost-badge maintenance-cost">
                                                <i class="fas fa-tools"></i>
                                                ₦@v.MaintenanceCost.ToString("N2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="cost-badge combined-cost">
                                                <i class="fas fa-calculator"></i>
                                                ₦@((v.FuelCost + v.MaintenanceCost).ToString("N2"))
                                            </span>
                                        </td>
                                        <td>
                                            <span class="efficiency-badge @efficiencyClass">
                                                <i class="fas @efficiencyIcon"></i>
                                                ₦@v.CostPerKm.ToString("N2")/km
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-balance-scale"></i>
                    <h4>No vehicle data found</h4>
                    <p>Try adjusting your filters to see comparison results</p>
                </div>
            }
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>



















