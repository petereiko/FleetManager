@using FleetManager.Business.DataObjects.ReportsCenter
@model List<VehicleDocumentationDto>
@{
    ViewBag.Title = "Vehicle Documentation";
    ViewBag.ExportFileName = "vehicle_docs";
}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            --purple-color: #8b5cf6;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
        }

        body {
            background-color: var(--gray-50);
        }

        .report-header {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .report-header h2 {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .report-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.95;
            font-size: 0.9375rem;
        }

        .report-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 3rem;
        }

        .report-card-body {
            padding: 2rem;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            border-left: 4px solid var(--accent-color);
            transition: all 0.2s;
        }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .summary-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .summary-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            background: var(--icon-bg);
            color: var(--icon-color);
        }

        .summary-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            color: var(--gray-600);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .summary-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--gray-900);
            line-height: 1;
        }

        .summary-value small {
            font-size: 0.875rem;
            color: var(--gray-600);
        }

        .alert-banner {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            border-left: 4px solid var(--danger-color);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .alert-banner-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--danger-color);
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .alert-banner-content h5 {
            color: var(--danger-color);
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 0.25rem 0;
        }

        .alert-banner-content p {
            color: #991b1b;
            margin: 0;
            font-size: 0.875rem;
        }

        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .table-header h5 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: var(--gray-800);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .table-responsive {
            border-radius: 0 0 12px 12px;
            overflow-x: auto;
        }

        .exportable-table {
            margin: 0;
            width: 100%;
            font-size: 0.9rem;
        }

        .exportable-table thead {
            background: var(--gray-800);
            color: white;
        }

        .exportable-table thead th {
            padding: 1rem 1.25rem;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            border: none;
            white-space: nowrap;
        }

        .exportable-table tbody tr {
            border-bottom: 1px solid var(--gray-200);
            transition: all 0.2s;
        }

        .exportable-table tbody tr:hover {
            background-color: var(--gray-50);
        }

        .exportable-table tbody tr.critical-row {
            background: rgba(239, 68, 68, 0.03);
        }

        .exportable-table tbody tr.critical-row:hover {
            background: rgba(239, 68, 68, 0.05);
        }

        .exportable-table tbody tr.warning-row {
            background: rgba(245, 158, 11, 0.03);
        }

        .exportable-table tbody tr.warning-row:hover {
            background: rgba(245, 158, 11, 0.05);
        }

        .exportable-table tbody td {
            padding: 1.25rem 1.25rem;
            vertical-align: middle;
            color: var(--gray-700);
        }

        .exportable-table tbody tr:last-child {
            border-bottom: none;
        }

        .vehicle-cell {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .vehicle-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.125rem;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        }

        .vehicle-icon.critical {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }

        .vehicle-icon.warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }

        .vehicle-plate {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray-900);
        }

        .compliance-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.25rem;
        }

        .compliance-indicator.compliant {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .compliance-indicator.non-compliant {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger-color);
        }

        .date-cell {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .date-main {
            font-weight: 600;
            color: var(--gray-900);
            font-size: 0.9375rem;
        }

        .date-countdown {
            font-size: 0.75rem;
            color: var(--gray-600);
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .date-countdown.expired {
            color: var(--danger-color);
            font-weight: 600;
        }

        .date-countdown.urgent {
            color: var(--warning-color);
            font-weight: 600;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .status-badge.valid {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
            border: 2px solid rgba(16, 185, 129, 0.2);
        }

        .status-badge.expired {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger-color);
            border: 2px solid rgba(239, 68, 68, 0.2);
        }

        .status-badge.expiring-soon {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning-color);
            border: 2px solid rgba(245, 158, 11, 0.2);
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray-600);
        }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-400);
            margin-bottom: 1rem;
        }

        .empty-state h4 {
            color: var(--gray-700);
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 768px) {
            .report-header {
                padding: 1.5rem 0;
            }

            .report-card-body {
                padding: 1rem;
            }

            .summary-cards {
                grid-template-columns: 1fr;
            }

            .alert-banner {
                flex-direction: column;
                text-align: center;
            }

            .table-responsive {
                font-size: 0.8125rem;
            }

            .exportable-table thead th,
            .exportable-table tbody td {
                padding: 0.75rem 0.5rem;
            }

            .vehicle-cell {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>

<div class="report-header">
    <div class="container">
        <h2>
            <i class="fas fa-file-contract"></i>
            Vehicle Documentation Report
        </h2>
        <p>Monitor vehicle insurance and roadworthy certificate status</p>
    </div>
</div>

<div class="container">
    <div class="report-card">
        <div class="report-card-body">
            @await Html.PartialAsync("_ExportControls")

            @if (Model != null && Model.Any())
            {
                    var totalVehicles = Model.Count;
                    var insuranceExpired = Model.Count(v => v.InsuranceExpired);
                    var roadworthyExpired = Model.Count(v => v.RoadWorthyExpired);
                    var bothExpired = Model.Count(v => v.InsuranceExpired && v.RoadWorthyExpired);
                    var fullyCompliant = Model.Count(v => !v.InsuranceExpired && !v.RoadWorthyExpired);
                    
                    var insuranceExpiringSoon = Model.Count(v => !v.InsuranceExpired && v.InsuranceExpiryDate.HasValue && (v.InsuranceExpiryDate.Value - DateTime.UtcNow).Days <= 30);
                    var roadworthyExpiringSoon = Model.Count(v => !v.RoadWorthyExpired && v.RoadWorthyExpiryDate.HasValue && (v.RoadWorthyExpiryDate.Value - DateTime.UtcNow).Days <= 30);
                

                <!-- Critical Alert Banner -->
                @if (insuranceExpired > 0 || roadworthyExpired > 0)
                {
                    <div class="alert-banner">
                        <div class="alert-banner-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="alert-banner-content">
                            <h5>⚠️ Critical Compliance Alert</h5>
                            <p>
                                @if (bothExpired > 0)
                                {
                                    <span>@bothExpired vehicle(s) have both documents expired. </span>
                                }
                                @if (insuranceExpired > 0)
                                {
                                    <span>@insuranceExpired insurance expired. </span>
                                }
                                @if (roadworthyExpired > 0)
                                {
                                    <span>@roadworthyExpired roadworthy expired. </span>
                                }
                                Immediate action required to avoid penalties.
                            </p>
                        </div>
                    </div>
                }

                <!-- Summary Statistics -->
                <div class="summary-cards">
                    <div class="summary-card" style="--accent-color: #3b82f6; --icon-bg: rgba(59, 130, 246, 0.1); --icon-color: #3b82f6;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Total Vehicles</div>
                                <div class="summary-value">@totalVehicles</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-car"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #10b981; --icon-bg: rgba(16, 185, 129, 0.1); --icon-color: #10b981;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Fully Compliant</div>
                                <div class="summary-value">@fullyCompliant</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #ef4444; --icon-bg: rgba(239, 68, 68, 0.1); --icon-color: #ef4444;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Insurance Expired</div>
                                <div class="summary-value">@insuranceExpired</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #ef4444; --icon-bg: rgba(239, 68, 68, 0.1); --icon-color: #ef4444;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Roadworthy Expired</div>
                                <div class="summary-value">@roadworthyExpired</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-certificate"></i>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card" style="--accent-color: #f59e0b; --icon-bg: rgba(245, 158, 11, 0.1); --icon-color: #f59e0b;">
                        <div class="summary-card-header">
                            <div>
                                <div class="summary-label">Expiring Soon (30d)</div>
                                <div class="summary-value">@(insuranceExpiringSoon + roadworthyExpiringSoon)</div>
                            </div>
                            <div class="summary-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Vehicle Documentation Table -->
                <div class="table-container">
                    <div class="table-header">
                        <h5>
                            <i class="fas fa-list-alt"></i>
                            Documentation Status
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table exportable-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-car me-2"></i>Vehicle</th>
                                    <th><i class="fas fa-shield-alt me-2"></i>Insurance Expiry</th>
                                    <th><i class="fas fa-certificate me-2"></i>Roadworthy Expiry</th>
                                    <th><i class="fas fa-info-circle me-2"></i>Insurance Status</th>
                                    <th><i class="fas fa-info-circle me-2"></i>Roadworthy Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.OrderByDescending(x => x.InsuranceExpired || x.RoadWorthyExpired).ThenBy(x => x.InsuranceExpiryDate))
                                {
                                    var isCritical = v.InsuranceExpired && v.RoadWorthyExpired;
                                    var hasIssue = v.InsuranceExpired || v.RoadWorthyExpired;
                                    var rowClass = isCritical ? "critical-row" : hasIssue ? "warning-row" : "";
                                    var iconClass = isCritical ? "critical" : hasIssue ? "warning" : "";

                                    // Calculate insurance countdown
                                    string insuranceCountdown = "";
                                    string insuranceCountdownClass = "";
                                    if (v.InsuranceExpiryDate.HasValue)
                                    {
                                        var daysUntil = (v.InsuranceExpiryDate.Value - DateTime.UtcNow).Days;
                                        if (v.InsuranceExpired || daysUntil < 0)
                                        {
                                            insuranceCountdown = $"{Math.Abs(daysUntil)} days overdue";
                                            insuranceCountdownClass = "expired";
                                        }
                                        else if (daysUntil <= 30)
                                        {
                                            insuranceCountdown = $"{daysUntil} days remaining";
                                            insuranceCountdownClass = "urgent";
                                        }
                                        else
                                        {
                                            insuranceCountdown = $"{daysUntil} days remaining";
                                        }
                                    }

                                    // Calculate roadworthy countdown
                                    string roadworthyCountdown = "";
                                    string roadworthyCountdownClass = "";
                                    if (v.RoadWorthyExpiryDate.HasValue)
                                    {
                                        var daysUntil = (v.RoadWorthyExpiryDate.Value - DateTime.UtcNow).Days;
                                        if (v.RoadWorthyExpired || daysUntil < 0)
                                        {
                                            roadworthyCountdown = $"{Math.Abs(daysUntil)} days overdue";
                                            roadworthyCountdownClass = "expired";
                                        }
                                        else if (daysUntil <= 30)
                                        {
                                            roadworthyCountdown = $"{daysUntil} days remaining";
                                            roadworthyCountdownClass = "urgent";
                                        }
                                        else
                                        {
                                            roadworthyCountdown = $"{daysUntil} days remaining";
                                        }
                                    }

                                    <tr class="@rowClass">
                                        <td>
                                            <div class="vehicle-cell">
                                                <div class="vehicle-icon @iconClass">
                                                    <i class="fas fa-car"></i>
                                                </div>
                                                <div>
                                                    <span class="vehicle-plate">@v.PlateNo</span>
                                                    @if (isCritical)
                                                    {
                                                        <div class="compliance-indicator non-compliant">
                                                            <i class="fas fa-ban"></i>
                                                            Non-Compliant
                                                        </div>
                                                    }
                                                    else if (!hasIssue)
                                                    {
                                                        <div class="compliance-indicator compliant">
                                                            <i class="fas fa-check"></i>
                                                            Compliant
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <span class="date-main">
                                                    @(v.InsuranceExpiryDate?.ToString("MMM d, yyyy") ?? "Not set")
                                                </span>
                                                @if (!string.IsNullOrEmpty(insuranceCountdown))
                                                {
                                                    <span class="date-countdown @insuranceCountdownClass">
                                                        <i class="fas fa-clock"></i>
                                                        @insuranceCountdown
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <span class="date-main">
                                                    @(v.RoadWorthyExpiryDate?.ToString("MMM d, yyyy") ?? "Not set")
                                                </span>
                                                @if (!string.IsNullOrEmpty(roadworthyCountdown))
                                                {
                                                    <span class="date-countdown @roadworthyCountdownClass">
                                                        <i class="fas fa-clock"></i>
                                                        @roadworthyCountdown
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-badge @(v.InsuranceExpired ? "expired" : "valid")">
                                                <i class="fas @(v.InsuranceExpired ? "fa-times-circle" : "fa-check-circle")"></i>
                                                @(v.InsuranceExpired ? "Expired" : "Valid")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-badge @(v.RoadWorthyExpired ? "expired" : "valid")">
                                                <i class="fas @(v.RoadWorthyExpired ? "fa-times-circle" : "fa-check-circle")"></i>
                                                @(v.RoadWorthyExpired ? "Expired" : "Valid")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-file-contract"></i>
                    <h4>No vehicle documentation found</h4>
                    <p>No vehicles have documentation records at this time</p>
                </div>
            }
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>












































