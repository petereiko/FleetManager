<div class="review-form-container">
    <div id="form" class="ajax-review-form">
        <!-- Request Meta Information -->
        <div class="request-meta">
            <div class="d-flex align-items-center gap-3">
                <span class="request-id">ID: #@Model.Request.Id</span>
                <span class="days-count">
                    <i class="fas fa-calendar-day"></i>
                    @((Model.Request.EndDate - Model.Request.StartDate).Days + 1) day(s)
                </span>
            </div>
            @{
                var isPastRequest = Model.Request.EndDate < DateTime.Now.Date;
                var isActive = Model.Request.StartDate <= DateTime.Now.Date && Model.Request.EndDate >= DateTime.Now.Date;
                var canModify = Model.Request.StartDate > DateTime.Now.Date;
            }
            <div class="d-flex align-items-center gap-2">
                <span class="status-indicator @(isPastRequest ? "expired" : "")">
                    <i class="fas @(isPastRequest ? "fa-history" : isActive ? "fa-play-circle" : "fa-clock")"></i>
                    @(isPastRequest ? "Expired" : isActive ? "Active" : "Upcoming")
                </span>
            </div>
        </div>

        <!-- Approval Information -->
        @if (Model.Request.ReviewedAt.HasValue)
        {
            <div class="approval-info">
                <div class="approval-details">
                    <div>
                        <div class="approved-by">
                            <i class="fas fa-user-check"></i>
                            Approved by: @Model.Request.ReviewedByName
                        </div>
                        <div class="approved-at">
                            <i class="fas fa-calendar-check"></i>
                            @Model.Request.ReviewedAt?.ToString("d MMM yyyy 'at' HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Request Details Section -->
        <div class="request-details">
            <div class="detail-row">
                <dt class="detail-label">
                    <i class="fas fa-user-circle"></i>
                    Driver
                </dt>
                <dd class="detail-value">
                    <div class="driver-name">
                        <i class="fas fa-id-badge"></i>
                        @Model.Request.RequestedBy
                    </div>
                </dd>
            </div>

            <div class="detail-row">
                <dt class="detail-label">
                    <i class="fas fa-tag"></i>
                    Category
                </dt>
                <dd class="detail-value">
                    <span class="category-tag">
                        <i class="fas fa-folder"></i>
                        @Model.Request.CategoryName
                    </span>
                </dd>
            </div>

            <div class="detail-row">
                <dt class="detail-label">
                    <i class="fas fa-calendar-alt"></i>
                    Period
                </dt>
                <dd class="detail-value">
                    <div class="date-range">
                        <i class="fas fa-calendar-check"></i>
                        @Model.Request.StartDate.ToString("d MMM yyyy") – @Model.Request.EndDate.ToString("d MMM yyyy")
                        <small class="d-block mt-1 text-muted">
                            (@Model.Request.StartDate.ToString("dddd")) to (@Model.Request.EndDate.ToString("dddd"))
                        </small>
                    </div>
                </dd>
            </div>

            <div class="detail-row">
                <dt class="detail-label">
                    <i class="fas fa-comment-alt"></i>
                    Reason
                </dt>
                <dd class="detail-value">
                    <div class="reason-text">
                        <i class="fas fa-quote-left"></i>
                        @Model.Request.Reason
                    </div>
                </dd>
            </div>
        </div>

        <!-- Existing Admin Comment (if any) -->
        @if (!string.IsNullOrEmpty(Model.AdminComment))
        {
            <div class="existing-comment">
                <strong><i class="fas fa-clipboard-list"></i> Previous Admin Comment:</strong><br />
                @Model.AdminComment
            </div>
        }

        <!-- Admin Comment Section -->
        <div class="form-section">
            <div class="form-section-title">
                <i class="fas fa-pen-fancy"></i>
                Administrative Review
            </div>

            @if (canModify)
            {
                <div class="form-group">
                    <label asp-for="AdminComment" class="form-label">
                        <i class="fas fa-clipboard-list"></i>
                        Additional Comments & Notes
                    </label>
                    <textarea asp-for="AdminComment"
                              class="form-control"
                              placeholder="Add additional comments, modifications, or notes about this request...">@Model.AdminComment</textarea>

                    <span class="text-danger" id="adminCommentError" style="display:none;">
                        <i class="fas fa-exclamation-circle"></i> Comment is required to deny a request.
                    </span>
                </div>
            }
            else
            {
                <div class="readonly-notice">
                    <i class="fas fa-info-circle"></i>
                    This request cannot be modified as it has already @(isPastRequest ? "expired" : "started").
                    @if (isPastRequest)
                    {
                        <div class="mt-2">
                            <strong>This record can be safely deleted if no longer needed.</strong>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            @if (canModify)
            {
                <button type="button" onclick="ApproveRequest()" class="btn btn-success approve-btn">
                    <i class="fas fa-check-circle"></i>
                    Update Approval
                </button>
                <button type="button" onclick="DenyRequest()" class="btn btn-danger deny-btn">
                    <i class="fas fa-times-circle"></i>
                    Revoke Approval
                </button>
            }
            else if (isPastRequest)
            {
                <button type="button" onclick="DeleteRequest(@Model.Request.Id)" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i>
                    Delete Record
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled>
                    <i class="fas fa-lock"></i>
                    Request Active - Cannot Modify
                </button>
            }
        </div>
    </div>
</div>

<script>
    function DeleteRequest(id) {
        if (!confirm('Are you sure you want to permanently delete this record? This action cannot be undone.')) {
            return;
        }

        const $btn = $('.btn-danger');
        const originalText = $btn.html();

        // Add loading state
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');

        $.ajax({
            url: `@Url.Action("Delete")?id=${id}`,
            type: 'POST',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            dataType: 'json',
            success: function(resp) {
                if (!resp.success) {
                    throw new Error(resp.message || 'Delete failed');
                }

                Toastify({
                    text: resp.message,
                    duration: 4000,
                    close: true,
                    gravity: 'top',
                    style: { background: "linear-gradient(to right, #48bb78, #38a169)" }
                }).showToast();

                $('#reviewModal').modal('hide');
                setTimeout(() => window.location.reload(), 2000);
            },
            error: function(err) {
                console.error('Error:', err);
                let msg = "Server error occurred";

                if (err.responseJSON && err.responseJSON.message) {
                    msg = err.responseJSON.message;
                } else if (err.responseText) {
                    try {
                        const response = JSON.parse(err.responseText);
                        msg = response.message || msg;
                    } catch (e) {
                        msg = err.responseText;
                    }
                } else if (err.message) {
                    msg = err.message;
                }

                Toastify({
                    text: msg,
                    duration: 5000,
                    close: true,
                    gravity: 'top',
                    style: { background: "linear-gradient(to right, #b71c1c, #f44336)" }
                }).showToast();

                $btn.prop('disabled', false).html(originalText);
            }
        });
    }
</script>