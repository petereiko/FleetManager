@using FleetManager.Business.DataObjects
@model CompanyBranchDto

<style>

    :root {
        --navy: #1B2856;
        --navy-mid: #223068;
        --green: #00664c;
        --green-light: #00875f;
        --green-pale: #6ee7b7;
        --white: #ffffff;
        --surface: #f7f8fa;
        --border: #e2e4e8;
        --border-mid: #d0d4dc;
        --dark: #1a1c20;
        --dark-60: rgba(26,28,32,0.60);
        --dark-35: rgba(26,28,32,0.35);
        --danger: #c0392b;
        --danger-bg: #fdf2f2;
        --warn: #c07800;
        --warn-bg: #fff9ee;
    }

    /* Page header */
    .bc-header {
        background: var(--navy);
        border-radius: 12px;
        padding: 28px 32px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(27,40,86,0.12);
    }

        .bc-header::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(0,102,76,0.1);
            pointer-events: none;
        }

    .bc-header-content {
        position: relative;
        z-index: 2;
    }

    .bc-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        font-size: 13px;
    }

        .bc-breadcrumb a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: color 0.12s;
        }

            .bc-breadcrumb a:hover {
                color: #fff;
            }

    .bc-breadcrumb-sep {
        color: rgba(255,255,255,0.4);
    }

    .bc-title {
        font-size: 24px;
        font-weight: 800;
        color: #fff;
        margin: 0;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 11px;
    }

        .bc-title i {
            font-size: 22px;
            color: var(--green-pale);
        }

    /* Form card */
    .bc-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .bc-card-header {
        background: var(--navy);
        padding: 18px 28px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .bc-card-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .bc-card-title i {
            font-size: 15px;
            color: var(--green-pale);
        }

    .bc-card-body {
        padding: 32px 28px;
    }

    /* Form fields */
    .bc-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .bc-field {
        margin-bottom: 0;
    }

        .bc-field.full {
            grid-column: 1 / -1;
        }

        .bc-field label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 7px;
            letter-spacing: -0.01em;
        }

        .bc-field .req {
            color: var(--danger);
            margin-left: 2px;
        }

        .bc-field input[type="text"],
        .bc-field input[type="email"],
        .bc-field input[type="tel"],
        .bc-field select,
        .bc-field textarea {
            width: 100%;
            height: 46px;
            padding: 0 14px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            color: var(--dark);
            background: var(--white);
            outline: none;
            transition: border-color 0.12s, box-shadow 0.12s;
        }

        .bc-field textarea {
            height: auto;
            padding: 12px 14px;
            resize: vertical;
            min-height: 90px;
        }

            .bc-field input:focus,
            .bc-field select:focus,
            .bc-field textarea:focus {
                border-color: var(--green);
                box-shadow: 0 0 0 3px rgba(0,102,76,0.12);
            }

            .bc-field input::placeholder,
            .bc-field textarea::placeholder {
                color: var(--dark-35);
            }

        .bc-field select {
            cursor: pointer;
        }

            .bc-field select:disabled {
                background: var(--surface);
                cursor: not-allowed;
                opacity: 0.6;
            }

        .bc-field .text-danger {
            font-size: 12px;
            color: var(--danger);
            margin-top: 5px;
            display: block;
        }

    /* Checkbox field */
    .bc-check {
        margin: 24px 0;
        padding: 16px;
        background: rgba(27,40,86,0.03);
        border: 1.5px solid rgba(27,40,86,0.08);
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 11px;
        transition: all 0.15s;
        cursor: pointer;
        user-select: none;
    }

        .bc-check:hover {
            background: rgba(27,40,86,0.05);
            border-color: rgba(27,40,86,0.12);
        }

        .bc-check.checked {
            background: rgba(0,102,76,0.08);
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(0,102,76,0.08);
        }

        .bc-check input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: var(--green);
            cursor: pointer;
            border-radius: 5px;
            flex-shrink: 0;
        }

        .bc-check label {
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
            cursor: pointer;
            margin: 0;
            flex: 1;
        }

    /* Form footer */
    .bc-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        margin-top: 8px;
    }

    .bc-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 46px;
        padding: 0 24px;
        border: none;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.12s, transform 0.12s, box-shadow 0.12s;
        text-decoration: none;
    }

    .bc-btn-primary {
        background: var(--green);
        color: #fff;
        box-shadow: 0 2px 8px rgba(0,102,76,0.2);
    }

        .bc-btn-primary:hover {
            background: var(--green-light);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(0,102,76,0.28);
            color: #fff;
        }

    .bc-btn-secondary {
        background: var(--surface);
        color: var(--dark-60);
        border: 1.5px solid var(--border);
    }

        .bc-btn-secondary:hover {
            background: var(--white);
            color: var(--dark);
            border-color: var(--border-mid);
        }

    .bc-btn i {
        font-size: 14px;
    }

    /* Modal redesign */
    .bc-modal .modal-content {
        border: none;
        border-radius: 14px;
        box-shadow: 0 16px 48px rgba(0,0,0,0.18);
        overflow: hidden;
    }

    .bc-modal .modal-header {
        background: var(--navy);
        padding: 22px 28px;
        border: none;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .bc-modal-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.15);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .bc-modal-icon i {
            font-size: 22px;
            color: #fff;
        }

    .bc-modal-title-wrap {
        flex: 1;
    }

    .bc-modal .modal-title {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 4px;
    }

    .bc-modal-subtitle {
        font-size: 13px;
        color: rgba(255,255,255,0.7);
        margin: 0;
    }

    .bc-modal .modal-body {
        padding: 28px;
        background: var(--white);
    }

    .bc-alert-content {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .bc-warn-icon {
        width: 46px;
        height: 46px;
        background: var(--warn);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .bc-warn-icon i {
            font-size: 20px;
            color: #fff;
        }

    .bc-alert-text {
        flex: 1;
    }

        .bc-alert-text h6 {
            font-size: 15px;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 10px;
        }

        .bc-alert-text p {
            font-size: 13.5px;
            color: var(--dark-60);
            margin-bottom: 12px;
            line-height: 1.6;
        }

    .bc-alert-list {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
    }

        .bc-alert-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 7px 0;
            font-size: 13.5px;
            color: var(--dark-60);
        }

            .bc-alert-list li i {
                color: var(--green);
                font-size: 13px;
                margin-top: 2px;
                flex-shrink: 0;
            }

    .bc-note {
        background: rgba(0,102,76,0.08);
        border-left: 3px solid var(--green);
        padding: 12px 14px;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

        .bc-note i {
            color: var(--green);
            font-size: 15px;
            margin-top: 1px;
            flex-shrink: 0;
        }

        .bc-note span {
            font-size: 13px;
            color: var(--dark);
            font-weight: 500;
            line-height: 1.5;
        }

    .bc-modal .modal-footer {
        padding: 18px 28px;
        border: none;
        background: var(--surface);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .bc-modal-btn {
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 9px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.12s;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .bc-modal-btn-cancel {
        background: var(--white);
        color: var(--dark-60);
        border: 1.5px solid var(--border);
    }

        .bc-modal-btn-cancel:hover {
            background: var(--surface);
            color: var(--dark);
        }

    .bc-modal-btn-confirm {
        background: var(--warn);
        color: #fff;
        box-shadow: 0 2px 8px rgba(192,120,0,0.25);
    }

        .bc-modal-btn-confirm:hover {
            background: #b36a00;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(192,120,0,0.3);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .bc-header {
            padding: 22px 20px;
        }

        .bc-title {
            font-size: 20px;
        }

        .bc-card-body {
            padding: 24px 20px;
        }

        .bc-row {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .bc-footer {
            flex-direction: column;
        }

        .bc-btn {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<!-- Page Header -->
<div class="bc-header">
    <div class="bc-header-content">
        <nav class="bc-breadcrumb">
            <a asp-action="Index">
                <i class="fa-solid fa-location-dot"></i> Branches
            </a>
            <span class="bc-breadcrumb-sep">›</span>
            <span>Add Branch</span>
        </nav>
        <h1 class="bc-title">
            <i class="fa-solid fa-plus-circle"></i>
            Add New Branch
        </h1>
    </div>
</div>

<!-- Form Card -->
<div class="bc-card">
    <div class="bc-card-header">
        <h2 class="bc-card-title">
            <i class="fa-solid fa-building"></i>
            Branch Information
        </h2>
    </div>

    <div class="bc-card-body">
        <form asp-action="Create" method="post">

            <!-- Row 1: Branch Name + Address -->
            <div class="bc-row">
                <div class="bc-field">
                    <label asp-for="Name">Branch Name <span class="req">*</span></label>
                    <input asp-for="Name" type="text" placeholder="e.g., Lagos Main Branch">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="bc-field">
                    <label asp-for="Address">Address <span class="req">*</span></label>
                    <input asp-for="Address" type="text" placeholder="e.g., 123 Main Street, Ikeja">
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2: Phone + Email -->
            <div class="bc-row">
                <div class="bc-field">
                    <label asp-for="Phone">Phone <span class="req">*</span></label>
                    <input asp-for="Phone" type="tel" placeholder="e.g., 0802 345 6789">
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="bc-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="e.g., branch@company.com">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 3: Manager Name + Manager Phone -->
            <div class="bc-row">
                <div class="bc-field">
                    <label asp-for="ManagerName">Manager Name</label>
                    <input asp-for="ManagerName" type="text" placeholder="e.g., John Doe">
                </div>
                <div class="bc-field">
                    <label asp-for="ManagerPhone">Manager Phone</label>
                    <input asp-for="ManagerPhone" type="tel" placeholder="e.g., 0803 456 7890">
                </div>
            </div>

            <!-- Row 4: Manager Email + State -->
            <div class="bc-row">
                <div class="bc-field">
                    <label asp-for="ManagerEmail">Manager Email</label>
                    <input asp-for="ManagerEmail" type="email" placeholder="e.g., manager@company.com">
                </div>
                <div class="bc-field">
                    <label asp-for="StateId">State <span class="req">*</span></label>
                    <select asp-for="StateId" id="StateId" asp-items="ViewBag.States">
                        <option value="">-- Select State --</option>
                    </select>
                    <span asp-validation-for="StateId" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 5: LGA (full width on mobile) -->
            <div class="bc-row">
                <div class="bc-field">
                    <label asp-for="LgaId">LGA <span class="req">*</span></label>
                    <select asp-for="LgaId" id="LgaId" disabled>
                        <option value="">-- Select LGA --</option>
                    </select>
                    <span asp-validation-for="LgaId" class="text-danger"></span>
                </div>
                <div class="bc-field">
                    <!-- Empty column for grid alignment, or put another field here -->
                </div>
            </div>

            <!-- Head Office Checkbox -->
            <div class="bc-check" id="headOfficeCheck">
                <input asp-for="IsHeadOffice" type="checkbox" id="IsHeadOffice">
                <label asp-for="IsHeadOffice">
                    <i class="fa-solid fa-star" style="color:var(--warn);margin-right:5px;"></i>
                    Set as Head Office
                </label>
            </div>

            <!-- Notes (full width) -->
            <div class="bc-row">
                <div class="bc-field full">
                    <label asp-for="Notes">Additional Notes</label>
                    <textarea asp-for="Notes" placeholder="Optional notes or instructions..."></textarea>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="bc-footer">
                <a asp-action="Index" class="bc-btn bc-btn-secondary">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </a>
                <button type="submit" class="bc-btn bc-btn-primary">
                    <i class="fa-solid fa-check"></i>
                    Create Branch
                </button>
            </div>

        </form>
    </div>
</div>

<!-- Head Office Confirmation Modal -->
<div class="modal fade bc-modal" id="headOfficeModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="bc-modal-icon">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div class="bc-modal-title-wrap">
                    <h5 class="modal-title">Set New Head Office</h5>
                    <p class="bc-modal-subtitle">This action will update your organization structure</p>
                </div>
            </div>
            <div class="modal-body">
                <div class="bc-alert-content">
                    <div class="bc-warn-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="bc-alert-text">
                        <h6>Are you sure you want to set this branch as the Head Office?</h6>
                        <p>By selecting "Set as Head Office" for this branch:</p>
                        <ul class="bc-alert-list">
                            <li>
                                <i class="fa-solid fa-arrow-right"></i>
                                Any existing Head Office will be automatically deactivated
                            </li>
                            <li>
                                <i class="fa-solid fa-arrow-right"></i>
                                This branch will become the new primary Head Office
                            </li>
                            <li>
                                <i class="fa-solid fa-arrow-right"></i>
                                All organizational hierarchy will be updated accordingly
                            </li>
                        </ul>
                        <div class="bc-note">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>This change will take effect immediately and cannot be undone from this form.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="bc-modal-btn bc-modal-btn-cancel" id="cancelHeadOffice">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </button>
                <button type="button" class="bc-modal-btn bc-modal-btn-confirm" id="confirmHeadOffice">
                    <i class="fa-solid fa-check"></i>
                    Yes, Set as Head Office
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // LGA loading
        document.getElementById('StateId').addEventListener('change', function () {
            const stateId = this.value;
            const lgaDropdown = document.getElementById('LgaId');

            lgaDropdown.innerHTML = '<option value="">-- Select LGA --</option>';
            lgaDropdown.disabled = true;

            if (stateId) {
                fetch(`/Company/Branch/GetLgasByState?stateId=${stateId}`)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(lga => {
                            const opt = document.createElement('option');
                            opt.value = lga.id;
                            opt.text = lga.name;
                            lgaDropdown.appendChild(opt);
                        });
                        lgaDropdown.disabled = false;
                    })
                    .catch(err => console.error('Error fetching LGAs:', err));
            }
        });

        // Head Office modal logic
        document.addEventListener('DOMContentLoaded', function () {
            const checkbox = document.getElementById('IsHeadOffice');
            const checkWrap = document.getElementById('headOfficeCheck');
            const modal = new bootstrap.Modal(document.getElementById('headOfficeModal'), {
                backdrop: 'static',
                keyboard: false
            });

            let isConfirmed = false;

            // Checkbox visual state
            checkbox.addEventListener('change', function () {
                if (this.checked) {
                    checkWrap.classList.add('checked');
                } else {
                    checkWrap.classList.remove('checked');
                }

                if (this.checked && !isConfirmed) {
                    this.checked = false;
                    checkWrap.classList.remove('checked');
                    modal.show();
                }
            });

            // Confirm
            document.getElementById('confirmHeadOffice').addEventListener('click', function () {
                isConfirmed = true;
                checkbox.checked = true;
                checkWrap.classList.add('checked');
                modal.hide();

                setTimeout(() => { isConfirmed = false; }, 100);
            });

            // Cancel
            document.getElementById('cancelHeadOffice').addEventListener('click', function () {
                checkbox.checked = false;
                checkWrap.classList.remove('checked');
                modal.hide();
            });

            // Modal hidden event
            document.getElementById('headOfficeModal').addEventListener('hidden.bs.modal', function () {
                if (!checkbox.checked) {
                    isConfirmed = false;
                    checkWrap.classList.remove('checked');
                }
            });
        });
    </script>
}
