                                                        <i class="feather-trash-2"></i>Delete Branch
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Branch Cards -->
            <div class="branch-cards" id="branchCards">
                @foreach (var branch in sortedBranches)
                {
                    <div class="branch-card @(branch.IsHeadOffice ? "head-office" : "")" data-state="@branch.StateName" data-type="@(branch.IsHeadOffice ? "head" : "regular")">
