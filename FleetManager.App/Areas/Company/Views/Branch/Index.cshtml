<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize the page
        initializePage();

        // Search functionality
        const searchInput = document.getElementById('branchSearch');
        const locationFilter = document.getElementById('locationFilter');
        const typeFilter = document.getElementById('typeFilter');

        let searchTimeout;

        // Real-time search
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                performSearch();
            }, 300);
        });

        // Filter functionality
        locationFilter.addEventListener('change', performSearch);
        typeFilter.addEventListener('change', performSearch);

        // Refresh button
        document.getElementById('refreshBtn').addEventListener('click', function() {
            showLoading();

            // Reset all filters
            searchInput.value = '';
            locationFilter.value = '';
            typeFilter.value = '';

            // Reset search
            performSearch();

            // Visual feedback
            const btn = this;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="feather-loader spinning"></i> Refreshing...';

            setTimeout(() => {
                btn.innerHTML = originalHTML;
                hideLoading();
            }, 1000);
        });

        // Export functionality
        const exportBtn = document.getElementById('exportBtn');
        const exportDropdown = document.getElementById('exportDropdown');

        exportBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            exportDropdown.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!exportBtn.contains(e.target)) {
                exportDropdown.classList.remove('show');
            }

            // Close all action dropdowns
            document.querySelectorAll('.action-dropdown.show').forEach(dropdown => {
                if (!dropdown.parentElement.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });
        });

        // Handle responsive table/cards view
        handleResponsiveView();
        window.addEventListener('resize', handleResponsiveView);
    });

    function initializePage() {
        // Add any initialization logic here
        console.log('Branch Management page initialized');
    }

    function performSearch() {
        const searchTerm = document.getElementById('branchSearch').value.toLowerCase();
        const locationFilter = document.getElementById('locationFilter').value;
        const typeFilter = document.getElementById('typeFilter').value;

        const tableRows = document.querySelectorAll('#branchesTable tbody tr');
        const branchCards = document.querySelectorAll('.branch-card');

        let visibleCount = 0;

        // Filter table rows
        tableRows.forEach(row => {
            const branchName = row.cells[0].textContent.toLowerCase();
            const location = row.cells[1].textContent.toLowerCase();
            const manager = row.cells[2].textContent.toLowerCase();
            const contact = row.cells[3].textContent.toLowerCase();
            const email = row.cells[4].textContent.toLowerCase();
            const state = row.dataset.state || '';
            const type = row.dataset.type || '';

            const matchesSearch = !searchTerm ||
                branchName.includes(searchTerm) ||
                location.includes(searchTerm) ||
                manager.includes(searchTerm) ||
                contact.includes(searchTerm) ||
                email.includes(searchTerm);

            const matchesLocation = !locationFilter || state === locationFilter;
            const matchesType = !typeFilter || type === typeFilter;

            if (matchesSearch && matchesLocation && matchesType) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Filter branch cards (mobile view)
        branchCards.forEach(card => {
            const cardText = card.textContent.toLowerCase();
            const state = card.dataset.state || '';
            const type = card.dataset.type || '';

            const matchesSearch = !searchTerm || cardText.includes(searchTerm);
            const matchesLocation = !locationFilter || state === locationFilter;
            const matchesType = !typeFilter || type === typeFilter;

            if (matchesSearch && matchesLocation && matchesType) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });

        // Update pagination info
        updatePaginationInfo(visibleCount);
    }

    function handleResponsiveView() {
        const isMobile = window.innerWidth <= 768;
        const table = document.querySelector('.table-wrapper');
        const cards = document.getElementById('branchCards');

        if (isMobile) {
            table.style.display = 'none';
            cards.style.display = 'grid';
        } else {
            table.style.display = 'block';
            cards.style.display = 'none';
        }
    }

    function toggleActionDropdown(button) {
        const dropdown = button.nextElementSibling;
        const isCurrentlyOpen = dropdown.classList.contains('show');

        // Close all dropdowns first
        document.querySelectorAll('.action-dropdown.show').forEach(d => {
            d.classList.remove('show');
        });

        // Toggle current dropdown
        if (!isCurrentlyOpen) {
            dropdown.classList.add('show');
        }
    }

    function viewBranchDetails(branchId) {
        // Implement view details functionality
        console.log('Viewing details for branch:', branchId);

        // Example: You could open a modal or redirect to details page
        // window.location.href = `/Branch/Details/${branchId}`;

        // For now, show an alert
        alert(`View details functionality for branch ${branchId} would be implemented here.`);
    }

    function confirmDelete(branchName) {
        return confirm(`Are you sure you want to delete the branch "${branchName}"?\n\nThis action cannot be undone and will permanently remove all branch data.`);
    }

    function changePage(direction) {
        // Implement pagination functionality
        console.log('Change page:', direction);

        // This would typically involve AJAX calls to load different pages
        // For now, just show feedback
        showLoading();
        setTimeout(hideLoading, 500);
    }

    function updatePaginationInfo(visibleCount) {
        const paginationInfo = document.getElementById('paginationInfo');
        if (paginationInfo) {
            const totalCount = @(Model?.Count ?? 0);
            paginationInfo.textContent = `Showing ${Math.min(visibleCount, 10)} of ${visibleCount} branches${visibleCount !== totalCount ? ` (filtered from ${totalCount} total)` : ''}`;
        }
    }

    function showLoading() {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) {
            overlay.style.display = 'flex';
        }
    }

    function hideLoading() {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    // Add smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });

    // Add keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        // Ctrl/Cmd + F to focus search
        if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
            e.preventDefault();
            document.getElementById('branchSearch').focus();
        }

        // Escape to close dropdowns
        if (e.key === 'Escape') {
            document.querySelectorAll('.action-dropdown.show, .export-dropdown.show').forEach(dropdown => {
                dropdown.classList.remove('show');
            });
        }
    });

    // Add visual feedback for form submissions
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function() {
            showLoading();
        });
    });
</script>

@section Scripts {
    <!-- Include Feather Icons -->
    <script src="https://unpkg.com/feather-icons@4.28.0/dist/feather.min.js"></script>
    <script>
        // Initialize Feather icons
        feather.replace();

        // Reinitialize icons after dynamic content changes
        const observer = new MutationObserver(function() {
            feather.replace();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    </script>
}






















