                            {
                                <div class="contact-item">
                                    <i class="feather-phone contact-icon"></i>
                                    <span>@branch.ManagerPhone</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(branch.ManagerEmail))
                            {
                                <div class="contact-item">
                                    <i class="feather-mail contact-icon"></i>
                                    <span>@branch.ManagerEmail</span>
                                </div>
                            }
                            <div class="contact-item">
                                <i class="feather-navigation contact-icon"></i>
                                <span>@(string.IsNullOrWhiteSpace(branch.StateName) ? "Unknown State" : branch.StateName)@(!string.IsNullOrWhiteSpace(branch.LgaName) ? $", {branch.LgaName}" : "")</span>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div class="location-badge">
                                @(string.IsNullOrWhiteSpace(branch.StateName) ? "Unknown" : branch.StateName)
                            </div>
                            <div class="action-menu">
                                <button class="action-btn" onclick="toggleActionDropdown(this)">
                                    <i class="feather-more-vertical"></i>
                                </button>
                                <div class="action-dropdown">
                                    <a asp-action="Edit" asp-protect-route-id="@branch.Id" class="dropdown-item">
                                        <i class="feather-edit"></i>Edit Branch
                                    </a>
                                    <button class="dropdown-item" onclick="viewBranchDetails('@branch.Id')">
                                        <i class="feather-eye"></i>View Details
                                    </button>
                                    @if (!branch.IsHeadOffice)
                                    {
                                        <hr style="margin: 8px 0; border: none; border-top: 1px solid #e9ecef;">
                                        <form asp-action="Delete" method="post" style="margin: 0;" onsubmit="return confirmDelete('@branch.Name')">
                                            <input type="hidden" name="id" value="@branch.Id" />
                                            <button type="submit" class="dropdown-item danger">
                                                <i class="feather-trash-2"></i>Delete Branch
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="pagination-wrapper">
                <div class="pagination-info" id="paginationInfo">
                    Showing 1-10 of @Model.Count branches
                </div>
                <div class="pagination" id="pagination">
                    <button onclick="changePage(-1)" id="prevBtn">
                        <i class="feather-chevron-left"></i> Previous
                    </button>
                    <button onclick="changePage(1)" class="active">1</button>
                    <button onclick="changePage(1)" id="nextBtn">
                        Next <i class="feather-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="feather-map-pin"></i>
                </div>
                <h3>No Branches Found</h3>
                <p>You haven't created any branches yet. Start by adding your first branch location to begin managing your company's presence across different regions.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="feather-plus"></i> Create Your First Branch
                </a>
            </div>
        }
    </div>
</div>

