                                    @branch.ManagerName.Split(' ').Select(n => n.FirstOrDefault()).Take(2).Aggregate("", (acc, c) => acc + c)
                                }
                                else
                                {
                                    <span>?</span>
                                }
                            </div>
                            <div class="manager-info">
                                <h4>@(!string.IsNullOrEmpty(branch.ManagerName) ? branch.ManagerName : "No Manager Assigned")</h4>
