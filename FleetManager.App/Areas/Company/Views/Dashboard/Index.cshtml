      //       }
      //     });

      //     hideLoading('branchRevenue');
      //   } catch (error) {
      //     console.error('Error initializing branch revenue chart:', error);
      //     showError('branchRevenue');
      //   }
      // }


      function initBranchRevenueChart(branches) {
        showLoading('branchRevenue');

        try {
          const branchLabels = branches.map(b => get(b, 'branchName') || 'Branch');
          const branchExpenses = branches.map(b => get(b, 'totalSpend') || 0);

          const ctx = document.getElementById('branchRevenueChart')?.getContext('2d');
          if (!ctx) {
            showError('branchRevenue');
            return;
          }

          if (charts.branchRevenue) {
            charts.branchRevenue.destroy();
          }

          charts.branchRevenue = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: branchLabels,
              datasets: [{
                label: 'Expenses (₦)',
                data: branchExpenses,
                backgroundColor: [
                  '#007bff', '#28a745', '#dc3545', '#ffc107',
                  '#17a2b8', '#6f42c1', '#fd7e14', '#20c997'
                ],
                borderRadius: 5,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return formatCurrency(context.parsed.y);
                    }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: {
                    callback: function(value) {
                      return formatCurrency(value);
                    }
                  }
                }
              }
            }
          });

          hideLoading('branchRevenue');
        } catch (error) {
          console.error('Error initializing branch revenue chart:', error);
          showError('branchRevenue');
        }
      }


      // FIXED: Use actual vehicle status distribution data
      function initStatusChart(dashboardData) {
        showLoading('status');

        try {
          const statusDistribution = dashboardData.vehicleStatusDistribution || {};

          // Get actual status counts
          const labels = [];
          const data = [];
          const colors = [];
          const colorMap = {
            'Active': '#28a745',
            'Inactive': '#dc3545',
            'Maintenance': '#ffc107',
            'UnderMaintenance': '#ffc107',
            'Unassigned': '#6c757d',
            'Available': '#17a2b8',
            'OutOfService': '#e74c3c'
          };

          for (const [status, count] of Object.entries(statusDistribution)) {
            if (count > 0) {
              labels.push(status);
              data.push(count);
              colors.push(colorMap[status] || '#6c757d');
            }
          }

          // If no data, show placeholder
          if (data.length === 0) {
            labels.push('No Data');
            data.push(1);
            colors.push('#e9ecef');
          }

          const ctx = document.getElementById('statusChart')?.getContext('2d');
          if (!ctx) {
            showError('status');
            return;
          }

          if (charts.status) {
            charts.status.destroy();
          }

          charts.status = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: labels,
              datasets: [{
                data: data,
                backgroundColor: colors,
                borderWidth: 2,
                borderColor: '#fff'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    padding: 15,
                    usePointStyle: true
                  }
                }
              }
            }
          });

          hideLoading('status');
        } catch (error) {
          console.error('Error initializing status chart:', error);
          showError('status');
        }
      }

      function initUtilizationChart() {
        showLoading('utilization');

        try {
          const ctx = document.getElementById('utilizationChart')?.getContext('2d');
          if (!ctx) return;

          if (charts.utilization) {
            charts.utilization.destroy();
          }

          charts.utilization = new Chart(ctx, {
            type: 'line',
            data: {
              labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
              datasets: [{
                label: 'Utilization %',
                data: [85, 90, 87, 92, 88, 75, 70],
                borderColor: '#28a745',
                backgroundColor: 'rgba(40,167,69,0.1)',
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#28a745',
                pointBorderColor: '#fff',
                pointBorderWidth: 2
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  max: 100,
                  ticks: {
                    callback: function(value) {
                      return value + '%';
                    }
                  }
                }
              },
              plugins: {
                legend: { display: false }
              }
            }
          });

          hideLoading('utilization');
        } catch (error) {
          console.error('Error initializing utilization chart:', error);
        }
      }

      // Load performance chart from server
      async function loadPerformanceChart() {
        showLoading('performance');

        try {
          const response = await fetch('/Company/Dashboard/ExpensesByMonth');
          if (!response.ok) {
            throw new Error(`Server returned ${response.status}`);
          }

          const expenses = await response.json();
          const labels = (expenses || []).map(m => {
            const year = get(m, 'year') || get(m, 'Year') || new Date().getFullYear();
            const month = get(m, 'month') || get(m, 'Month') || 1;
            const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            return `${monthNames[month]} ${year}`;
          });
          const values = (expenses || []).map(m => get(m, 'value') || get(m, 'Value') || 0);

          const ctx = document.getElementById('performanceChart')?.getContext('2d');
          if (!ctx) {
            throw new Error('Chart canvas not found');
          }

          if (charts.performance) {
            charts.performance.destroy();
          }

          charts.performance = new Chart(ctx, {
            type: 'line',
            data: {
              labels: labels.length ? labels : ['No Data'],
              datasets: [{
                label: 'Monthly Expenses (₦)',
                data: values.length ? values : [0],
                borderColor: '#dc3545',
                backgroundColor: 'rgba(220,53,69,0.08)',
                fill: true,
                tension: 0.3,
                pointBackgroundColor: '#dc3545',
                pointBorderColor: '#fff',
                pointBorderWidth: 2
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: {
                    callback: function(value) {
                      return formatCurrency(value);
                    }
                  }
                }
              },
              plugins: {
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return `Expenses: ${formatCurrency(context.parsed.y)}`;
                    }
                  }
                }
              }
            }
          });

          hideLoading('performance');
        } catch (error) {
          console.error('Error loading performance chart:', error);
          showError('performance');
        }
      }

      // Load recent activities
      async function loadRecentActivities() {
        const tbody = document.querySelector('#recentActivitiesTable tbody');
        const errorDiv = document.getElementById('activitiesError');

        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center text-muted">
              <div class="loading-spinner me-2"></div>
              Loading recent activities...
            </td>
          </tr>
        `;
        errorDiv.classList.add('d-none');

        try {
          const response = await fetch('/Company/Dashboard/RecentActivities');
          if (!response.ok) {
            throw new Error(`Server returned ${response.status}`);
          }

          const data = await response.json();
          const activities = data.recentFuel || data.recentTickets || [];

          populateRecentActivities(activities);
        } catch (error) {
          console.error('Error loading recent activities:', error);
          tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No recent activities available</td></tr>';
          errorDiv.classList.remove('d-none');
        }
      }

      function populateRecentActivities(rows) {
        const tbody = document.querySelector('#recentActivitiesTable tbody');

        if (!rows || rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No recent activities available</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        for (const r of rows.slice(0, 10)) {
          const vehicleId = get(r, 'vehiclePlateNo') || `#${get(r, 'vehicleId') || ''}`;
          const driver = get(r, 'driverName') || (get(r, 'driverId') ? ('Driver ' + get(r, 'driverId')) : '—');
          const status = get(r, 'status') || get(r, 'Status') || (get(r, 'invoiceAmount') ? 'Invoiced' : 'Active');
          const location = get(r, 'location') || get(r, 'branchName') || '—';
          const lastUpdated = new Date(get(r, 'date') || get(r, 'createdDate') || Date.now()).toLocaleString();

          tbody.innerHTML += `
            <tr>
              <td>${vehicleId}</td>
              <td>${driver}</td>
              <td><span class="status-indicator status-active"></span>${status}</td>
              <td>${location}</td>
              <td>${lastUpdated}</td>
              <td>
                <button class="btn btn-sm btn-outline-primary track-btn" data-vehicle="${get(r, 'vehicleId') || ''}">Track</button>
                <button class="btn btn-sm btn-outline-secondary view-branch" data-branch="${get(r, 'branchId') || get(r, 'companyBranchId') || ''}">View</button>
              </td>
            </tr>
          `;
        }
      }

      // Branch detail modal functions
      document.addEventListener('click', async (ev) => {
        const btn = ev.target.closest('.view-branch');
        if (!btn) return;

        const branchId = btn.getAttribute('data-branch');
        if (!branchId) return;

        try {
          const modal = new bootstrap.Modal(document.getElementById('branchDetailModal'));
          modal.show();

          const response = await fetch(`/Company/Dashboard/BranchDetails?branchId=${encodeURIComponent(branchId)}`);
          if (!response.ok) {
            throw new Error('Failed to load branch details');
          }

          const data = await response.json();
          showBranchModal(data);
        } catch (error) {
          console.error('Error fetching branch details:', error);
          document.getElementById('branchDetailBody').innerHTML = `
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Failed to load branch details. Please try again.
            </div>
          `;
        }
      });

      function showBranchModal(data) {
        const title = document.getElementById('branchDetailTitle');
        const body = document.getElementById('branchDetailBody');

        title.textContent = `${get(data, 'branchName') || 'Branch'} — Details`;

        const summary = get(data, 'summary') || {};
        const recentTickets = get(data, 'recentMaintenanceTickets') || [];
        const recentFuel = get(data, 'recentFuelLogs') || [];
        const topVehicles = get(data, 'topVehiclesByFuel') || [];

        body.innerHTML = `
          <div class="row">
            <div class="col-md-6">
              <h6>Summary</h6>
              <p><strong>Manager:</strong> ${get(data, 'managerName') || '—'}</p>
              <p><strong>Drivers:</strong> ${get(summary, 'totalDrivers') || 0} (active: ${get(summary, 'activeDrivers') || 0})</p>
              <p><strong>Vehicles:</strong> ${get(summary, 'totalVehicles') || 0} (active: ${get(summary, 'activeVehicles') || 0})</p>
              <p><strong>Assigned Vehicles:</strong> ${get(summary, 'assignedVehicleCount') || 0}</p>
              <p><strong>Total Spend:</strong> ${formatCurrency(get(summary, 'totalSpend') || 0)}</p>
            </div>
            <div class="col-md-6">
              <h6>Top Vehicles by Fuel</h6>
              <ul class="list-unstyled">
                ${topVehicles.length
                  ? topVehicles.slice(0, 5).map(v =>
                      `<li class="mb-1">
                         <span class="badge bg-light text-dark me-2">${get(v, 'plateNo') || get(v, 'PlateNo') || 'N/A'}</span>
                         ${get(v, 'totalVolume') || 0}L
                       </li>`
                    ).join('')
                  : '<li class="text-muted">No data available</li>'
                }
              </ul>
            </div>
          </div>
          <hr/>
          <div class="row">
            <div class="col-md-6">
              <h6>Recent Maintenance Tickets</h6>
              <div class="list-group list-group-flush">
                ${recentTickets.length
                  ? recentTickets.slice(0, 5).map(t =>
                      `<div class="list-group-item px-0">
                         <div class="d-flex justify-content-between">
                           <strong>${get(t, 'subject') || get(t, 'Subject') || '—'}</strong>
                           <span class="badge bg-${get(t, 'status') === 'Completed' ? 'success' : 'warning'}">${get(t, 'status') || get(t, 'Status')}</span>
                         </div>
                         <small class="text-muted">${new Date(get(t, 'createdDate') || get(t, 'CreatedDate')).toLocaleDateString()}</small>
                       </div>`
                    ).join('')
                  : '<div class="text-muted">No recent tickets</div>'
                }
              </div>
            </div>
            <div class="col-md-6">
              <h6>Recent Fuel Logs</h6>
              <div class="list-group list-group-flush">
                ${recentFuel.length
                  ? recentFuel.slice(0, 5).map(f =>
                      `<div class="list-group-item px-0">
                         <div class="d-flex justify-content-between">
                           <strong>${get(f, 'vehiclePlateNo') || '—'}</strong>
                           <span>${formatCurrency(get(f, 'cost') || 0)}</span>
                         </div>
                         <small class="text-muted">${get(f, 'volume') || 0}L • ${new Date(get(f, 'date') || get(f, 'Date')).toLocaleDateString()}</small>
                       </div>`
                    ).join('')
                  : '<div class="text-muted">No recent fuel logs</div>'
                }
              </div>
            </div>
          </div>
        `;
      }

      // Retry functions for failed charts
      window.retryChart = function(chartType) {
        const dashboardData = @Html.Raw(JsonSerializer.Serialize(Model ?? new CompanyOwnerDashboardDto()));

        switch(chartType) {
          case 'performance':
            loadPerformanceChart();
            break;
          case 'branchRevenue':
            const branches = dashboardData.branches || [];
            initBranchRevenueChart(branches);
            break;
          case 'status':
            initStatusChart(dashboardData);
            break;
        }
      };

      // Refresh all data
      async function refreshAllData() {
        if (isRefreshing) return;

        setRefreshLoading(true);

        try {
          // Reload the entire page to get fresh data
          window.location.reload();
        } catch (error) {
          console.error('Error during refresh:', error);
        } finally {
          setRefreshLoading(false);
        }
      }

      // Global function for activities retry
      window.loadRecentActivities = loadRecentActivities;

      // Event listeners
      document.getElementById('refreshDashboardBtn')?.addEventListener('click', refreshAllData);

      // Initialize everything
      setGreeting();
      initializeCharts();

      // Load dynamic data after a short delay
      setTimeout(() => {
        loadPerformanceChart();
        loadRecentActivities();
      }, 500);
    })();
</script>








