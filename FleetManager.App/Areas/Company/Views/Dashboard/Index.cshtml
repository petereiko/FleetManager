<!-- Chart.js CDN (keep if not already present) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<script>
    (function () {
      // Server-provided initial dashboard DTO (used to seed charts quickly)
      const initialDashboard = @Html.Raw(JsonSerializer.Serialize(Model ?? new CompanyOwnerDashboardDto()));
      const currentUserFirstName = '@(_authUser?.FirstName ?? "")';

      // Global state
      let charts = {
        performance: null,
        branchRevenue: null,
        status: null,
        utilization: null
      };

      let currentBranchId = null;
      let isRefreshing = false;

      // Helpers
      function formatCurrency(v) {
        try {
          return new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(v || 0);
        } catch (e) {
          return '₦' + (v || 0);
        }
      }

      function get(obj, key) {
        if (!obj) return undefined;
        if (Object.prototype.hasOwnProperty.call(obj, key)) return obj[key];
        const camel = key.charAt(0).toLowerCase() + key.slice(1);
        if (Object.prototype.hasOwnProperty.call(obj, camel)) return obj[camel];
        const pascal = key.charAt(0).toUpperCase() + key.slice(1);
        if (Object.prototype.hasOwnProperty.call(obj, pascal)) return obj[pascal];
        return undefined;
      }

      // Loading UI helpers
      function showLoading(name) {
        document.getElementById(`${name}Loading`)?.classList.remove('d-none');
        document.getElementById(`${name}Chart`)?.classList.add('d-none');
        document.getElementById(`${name}Error`)?.classList.add('d-none');
      }
      function hideLoading(name) {
        document.getElementById(`${name}Loading`)?.classList.add('d-none');
        document.getElementById(`${name}Chart`)?.classList.remove('d-none');
      }
      function showError(name) {
        document.getElementById(`${name}Loading`)?.classList.add('d-none');
        document.getElementById(`${name}Chart`)?.classList.add('d-none');
        document.getElementById(`${name}Error`)?.classList.remove('d-none');
      }
      function setRefreshLoading(loading) {
        const btn = document.getElementById('refreshDashboardBtn');
        if (!btn) return;
        const text = btn.querySelector('.refresh-text');
        const spinner = btn.querySelector('.loading-spinner');
        if (loading) {
          text.classList.add('d-none');
          spinner.classList.remove('d-none');
          btn.disabled = true;
          isRefreshing = true;
        } else {
          text.classList.remove('d-none');
          spinner.classList.add('d-none');
          btn.disabled = false;
          isRefreshing = false;
        }
      }

      // Greeting
      function setGreeting() {
        const name = currentUserFirstName || '';
        const hour = new Date().getHours();
        let greeting, subMessage;

        if (hour < 12) {
          greeting = "Good Morning";
          subMessage = "Ready to lead us to new heights today?";
        } else if (hour < 17) {
          greeting = "Good Afternoon";
          subMessage = "Hope your strategic vision is coming together smoothly!";
        } else {
          greeting = "Good Evening";
          subMessage = "Take a moment to celebrate today's achievements, visionary leader.";
        }

        const container = document.querySelector('.morning-user');
        if (container) {
          container.innerHTML = `
            <h2>${greeting}${name ? ', ' + name : ''}</h2>
            <p>${subMessage}</p>
          `;
        }
      }

      // -------- Chart inits (reusable) --------
      function initBranchRevenueChart(branches) {
        showLoading('branchRevenue');

        try {
          const branchLabels = (branches || []).map(b => get(b, 'branchName') || 'Branch');
          const branchExpenses = (branches || []).map(b => get(b, 'totalSpend') || get(b, 'TotalSpend') || 0);

          const ctx = document.getElementById('branchRevenueChart')?.getContext('2d');
          if (!ctx) { showError('branchRevenue'); return; }

          if (charts.branchRevenue) charts.branchRevenue.destroy();

          charts.branchRevenue = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: branchLabels,
              datasets: [{
                label: 'Expenses (₦)',
                data: branchExpenses,
                borderRadius: 5,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: function(context) { return formatCurrency(context.parsed.y); }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { callback: function(value) { return formatCurrency(value); } }
                }
              }
            }
          });

          hideLoading('branchRevenue');
        } catch (err) {
          console.error(err);
          showError('branchRevenue');
        }
      }

      function initStatusChart(dashboardData) {
        showLoading('status');

        try {
          const statusDistribution = dashboardData?.vehicleStatusDistribution || {};
          const labels = [];
          const data = [];
          const colors = [];
          const colorMap = {
            'Active': '#28a745',
            'Inactive': '#dc3545',
            'Maintenance': '#ffc107',
            'UnderMaintenance': '#ffc107',
            'Unassigned': '#6c757d',
            'Available': '#17a2b8',
            'OutOfService': '#e74c3c'
          };

          for (const [status, count] of Object.entries(statusDistribution)) {
            if (count > 0) {
              labels.push(status);
              data.push(count);
              colors.push(colorMap[status] || '#6c757d');
            }
          }

          if (data.length === 0) {
            labels.push('No Data');
            data.push(1);
            colors.push('#e9ecef');
          }

          const ctx = document.getElementById('statusChart')?.getContext('2d');
          if (!ctx) { showError('status'); return; }

          if (charts.status) charts.status.destroy();

          charts.status = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels,
              datasets: [{
                data,
                backgroundColor: colors,
                borderWidth: 2,
                borderColor: '#fff'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { position: 'bottom', labels: { padding: 10, usePointStyle: true } }
              }
            }
          });

          hideLoading('status');
        } catch (err) {
          console.error(err);
          showError('status');
        }
      }

      function initUtilizationChart(sampleData) {
        showLoading('utilization');

        try {
          const ctx = document.getElementById('utilizationChart')?.getContext('2d');
          if (!ctx) return;

          if (charts.utilization) charts.utilization.destroy();

          charts.utilization = new Chart(ctx, {
            type: 'line',
            data: {
              labels: sampleData?.labels || ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
              datasets: [{
                label: 'Utilization %',
                data: sampleData?.data || [85,90,87,92,88,75,70],
                fill: true,
                tension: 0.4
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  max: 100,
                  ticks: { callback: (v) => `${v}%` }
                }
              },
              plugins: { legend: { display: false } }
            }
          });

          hideLoading('utilization');
        } catch (err) {
          console.error(err);
        }
      }

      // -------- Data loaders --------
      async function loadPerformanceChart(branchId) {
        showLoading('performance');
        try {
          const url = `/Company/Dashboard/ExpensesByMonth?branchId=${encodeURIComponent(branchId || '')}`;
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Server returned ${response.status}`);

          const expenses = await response.json();
          const labels = (expenses || []).map(m => {
            const year = get(m, 'year') || get(m, 'Year') || new Date().getFullYear();
            const month = get(m, 'month') || get(m, 'Month') || 1;
            const monthNames = ['', 'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return `${monthNames[month]} ${year}`;
          });
          const values = (expenses || []).map(m => get(m, 'value') || get(m, 'Value') || 0);

          const ctx = document.getElementById('performanceChart')?.getContext('2d');
          if (!ctx) throw new Error('Chart canvas not found');

          if (charts.performance) charts.performance.destroy();

          charts.performance = new Chart(ctx, {
            type: 'line',
            data: {
              labels: labels.length ? labels : ['No Data'],
              datasets: [{
                label: 'Monthly Expenses (₦)',
                data: values.length ? values : [0],
                fill: true,
                tension: 0.3
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: { beginAtZero: true, ticks: { callback: (v) => formatCurrency(v) } }
              },
              plugins: {
                tooltip: {
                  callbacks: {
                    label: (context) => `Expenses: ${formatCurrency(context.parsed.y)}`
                  }
                }
              }
            }
          });

          hideLoading('performance');
        } catch (err) {
          console.error('Error loading performance chart:', err);
          showError('performance');
        }
      }

      // Load Recent Activities (optionally branch-scoped)
      async function loadRecentActivitiesForBranch(branchId) {
        const tbody = document.querySelector('#recentActivitiesTable tbody');
        const errorDiv = document.getElementById('activitiesError');

        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted"><div class="loading-spinner me-2"></div>Loading recent activities...</td></tr>`;
        errorDiv.classList.add('d-none');

        try {
          const url = `/Company/Dashboard/RecentActivities?branchId=${encodeURIComponent(branchId || '')}&size=10`;
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Server returned ${response.status}`);

          const data = await response.json();
          const activities = (data.recentFuel && data.recentFuel.length) ? data.recentFuel : (data.recentTickets || []);
          populateRecentActivities(activities);
        } catch (err) {
          console.error('Error loading recent activities:', err);
          tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No recent activities available</td></tr>';
          errorDiv.classList.remove('d-none');
        }
      }

      function populateRecentActivities(rows) {
        const tbody = document.querySelector('#recentActivitiesTable tbody');
        if (!rows || rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No recent activities available</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        for (const r of rows.slice(0, 10)) {
          const vehicleId = get(r, 'vehiclePlateNo') || `#${get(r, 'vehicleId') || ''}`;
          const driver = get(r, 'driverName') || (get(r, 'driverId') ? ('Driver ' + get(r, 'driverId')) : '—');
          const status = get(r, 'status') || get(r, 'Status') || (get(r, 'invoiceAmount') ? 'Invoiced' : 'Active');
          const location = get(r, 'location') || get(r, 'branchName') || '—';
          const lastUpdated = new Date(get(r, 'date') || get(r, 'createdDate') || Date.now()).toLocaleString();

          tbody.innerHTML += `
            <tr>
              <td>${vehicleId}</td>
              <td>${driver}</td>
              <td><span class="status-indicator status-active"></span>${status}</td>
              <td>${location}</td>
              <td>${lastUpdated}</td>
              <td>
                <button class="btn btn-sm btn-outline-primary track-btn" data-vehicle="${get(r, 'vehicleId') || ''}">Track</button>
                <button class="btn btn-sm btn-outline-secondary view-branch" data-branch="${get(r, 'branchId') || get(r, 'companyBranchId') || ''}">View</button>
              </td>
            </tr>`;
        }
      }

      // Apply DTO to UI (update counts, totals, branch list area)
      function applyDtoToUi(dto) {
        if (!dto) return;
        document.getElementById('branchCount').textContent = dto.branchCount ?? 0;
        document.getElementById('adminCount').textContent = dto.adminCount ?? 0;
        document.getElementById('vehicleCount').textContent = dto.vehicleCount ?? 0;
        document.getElementById('driverCount').textContent = dto.driverCount ?? 0;

        document.getElementById('monthlyExpenditure').textContent = formatCurrency(dto?.totals?.totalSpend ?? 0);
        document.getElementById('monthlyExpenses').textContent = formatCurrency(dto?.totals?.fuelSpend ?? 0);
        document.getElementById('monthlyRecurrent').textContent = formatCurrency(dto?.totals?.maintenanceSpend ?? 0);

        // branch performance list: build from dto.branches (which, when scoped, contains only the selected branch)
        const list = document.getElementById('branchPerformanceList');
        if (list) {
          if (!dto.branches || dto.branches.length === 0) {
            list.innerHTML = '<div class="text-muted">No branches to display.</div>';
          } else {
            list.innerHTML = dto.branches.slice(0, 6).map(b => {
              const perf = Math.round(get(b, 'performancePercentage') || 0);
              const assigned = get(b, 'assignedVehicleCount') || 0;
              const totalVeh = get(b, 'totalVehicles') || 0;
              const spend = get(b, 'totalSpend') || get(b, 'TotalSpend') || 0;
              const selectedClass = (currentBranchId && +currentBranchId === +get(b, 'branchId')) ? 'border-primary' : '';
              return `
                <div class="mb-3 ${selectedClass}">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="fw-bold">${get(b, 'branchName')}</span>
                    <span class="text-muted">${perf}%</span>
                  </div>
                  <div class="progress-bar-custom"><div class="progress-fill" style="width: ${perf}%"></div></div>
                  <div class="mt-2 d-flex justify-content-between align-items-center">
                    <small class="text-muted">${assigned}/${totalVeh} vehicles • ${formatCurrency(spend)} spent</small>
                    <button class="btn btn-sm btn-outline-secondary view-branch" data-branch="${get(b, 'branchId')}">View Details</button>
                  </div>
                </div>`;
            }).join('');
          }
        }
      }

      // Load scoped dashboard DTO and refresh parts of the UI
      async function loadScopedDashboard(branchId) {
        if (isRefreshing) return;
        setRefreshLoading(true);
        currentBranchId = branchId || null;

        try {
          const url = `/Company/Dashboard/Scoped?branchId=${encodeURIComponent(branchId || '')}&recentSize=10`;
          const res = await fetch(url);
          if (!res.ok) throw new Error('Failed to load scoped dashboard');

          const dto = await res.json();
          applyDtoToUi(dto);

          // charts: pass branchId to performance
          await loadPerformanceChart(currentBranchId);
          initBranchRevenueChart(dto.branches || []);
          initStatusChart(dto);

          // recent activities for branch
          await loadRecentActivitiesForBranch(currentBranchId);
        } catch (err) {
          console.error('Error loading scoped dashboard:', err);
          // show toast or error UI as needed
        } finally {
          setRefreshLoading(false);
        }
      }

      // Branch detail modal click handler (delegated)
      document.addEventListener('click', async (ev) => {
        const btn = ev.target.closest('.view-branch');
        if (!btn) return;

        const branchId = btn.getAttribute('data-branch');
        if (!branchId) return;

        try {
          const modalEl = document.getElementById('branchDetailModal');
          const modal = new bootstrap.Modal(modalEl);
          modal.show();

          const response = await fetch(`/Company/Dashboard/BranchDetails?branchId=${encodeURIComponent(branchId)}`);
          if (!response.ok) throw new Error('Failed to load branch details');

          const data = await response.json();
          showBranchModal(data);
        } catch (err) {
          console.error('Error fetching branch details:', err);
          document.getElementById('branchDetailBody').innerHTML = `<div class="alert alert-danger">Failed to load branch details. Please try again.</div>`;
        }
      });

      function showBranchModal(data) {
        const title = document.getElementById('branchDetailTitle');
        const body = document.getElementById('branchDetailBody');

        title.textContent = `${get(data, 'branchName') || 'Branch'} — Details`;

        const summary = get(data, 'summary') || {};
        const recentTickets = get(data, 'recentMaintenanceTickets') || [];
        const recentFuel = get(data, 'recentFuelLogs') || [];
        const topVehicles = get(data, 'topVehiclesByFuel') || [];

        body.innerHTML = `
          <div class="row">
            <div class="col-md-6">
              <h6>Summary</h6>
              <p><strong>Manager:</strong> ${get(data, 'managerName') || '—'}</p>
              <p><strong>Drivers:</strong> ${get(summary, 'totalDrivers') || 0} (active: ${get(summary, 'activeDrivers') || 0})</p>
              <p><strong>Vehicles:</strong> ${get(summary, 'totalVehicles') || 0} (active: ${get(summary, 'activeVehicles') || 0})</p>
              <p><strong>Assigned Vehicles:</strong> ${get(summary, 'assignedVehicleCount') || 0}</p>
              <p><strong>Total Spend:</strong> ${formatCurrency(get(summary, 'totalSpend') || 0)}</p>
            </div>
            <div class="col-md-6">
              <h6>Top Vehicles by Fuel</h6>
              <ul class="list-unstyled">
                ${topVehicles.length
                  ? topVehicles.slice(0, 5).map(v =>
                      `<li class="mb-1"><span class="badge bg-light text-dark me-2">${get(v, 'plateNo') || get(v, 'PlateNo') || 'N/A'}</span>${get(v, 'totalVolume') || 0}L</li>`
                    ).join('')
                  : '<li class="text-muted">No data available</li>'
                }
              </ul>
            </div>
          </div>
          <hr/>
          <div class="row">
            <div class="col-md-6">
              <h6>Recent Maintenance Tickets</h6>
              <div class="list-group list-group-flush">
                ${recentTickets.length
                  ? recentTickets.slice(0, 5).map(t =>
                      `<div class="list-group-item px-0">
                         <div class="d-flex justify-content-between">
                           <strong>${get(t, 'subject') || get(t, 'Subject') || '—'}</strong>
                           <span class="badge bg-${get(t, 'status') === 'Completed' ? 'success' : 'warning'}">${get(t, 'status') || get(t, 'Status')}</span>
                         </div>
                         <small class="text-muted">${new Date(get(t, 'createdDate') || get(t, 'CreatedDate')).toLocaleDateString()}</small>
                       </div>`
                    ).join('')
                  : '<div class="text-muted">No recent tickets</div>'
                }
              </div>
            </div>
            <div class="col-md-6">
              <h6>Recent Fuel Logs</h6>
              <div class="list-group list-group-flush">
                ${recentFuel.length
                  ? recentFuel.slice(0, 5).map(f =>
                      `<div class="list-group-item px-0">
                         <div class="d-flex justify-content-between">
                           <strong>${get(f, 'vehiclePlateNo') || '—'}</strong>
                           <span>${formatCurrency(get(f, 'cost') || 0)}</span>
                         </div>
                         <small class="text-muted">${get(f, 'volume') || 0}L • ${new Date(get(f, 'date') || get(f, 'Date')).toLocaleDateString()}</small>
                       </div>`
                    ).join('')
                  : '<div class="text-muted">No recent fuel logs</div>'
                }
              </div>
            </div>
          </div>
        `;
      }

      // Retry functions used by Retry buttons on error UI
      window.retryChart = function(chartType) {
        switch(chartType) {
          case 'performance':
            loadPerformanceChart(currentBranchId);
            break;
          case 'branchRevenue':
            // use server-initial data branches if available
            initBranchRevenueChart(initialDashboard?.branches || []);
            break;
          case 'status':
            initStatusChart(initialDashboard || {});
            break;
        }
      };

      // Refresh whole dashboard (keeps currentBranchId)
      async function refreshAllData() {
        if (isRefreshing) return;
        setRefreshLoading(true);
        try {
          await loadScopedDashboard(currentBranchId);
        } catch (err) {
          console.error(err);
        } finally {
          setRefreshLoading(false);
        }
      }

      // Wire dropdown: branch selection
      document.getElementById('branchSelect')?.addEventListener('change', function() {
        const val = this.value;
        if (!val) {
          loadScopedDashboard(null);
        } else {
          loadScopedDashboard(val);
        }
      });

      // Wire refresh button
      document.getElementById('refreshDashboardBtn')?.addEventListener('click', refreshAllData);

