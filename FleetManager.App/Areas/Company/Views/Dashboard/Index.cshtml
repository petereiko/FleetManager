<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<script>

     (function(){
      const name = '@_authUser.FirstName'
      const hour = new Date().getHours();
      let greeting, subMessage;

      if (hour < 12) {
        greeting   = "Good Morning";
        subMessage = "Ready to lead us to new heights today?";
      } else if (hour < 17) {
        greeting   = "Good Afternoon";
        subMessage = "Hope your strategic vision is coming together smoothly!";
      } else {
        greeting   = "Good Evening";
        subMessage = "Take a moment to celebrate today’s achievements, visionary leader.";
      }

      const container = document.querySelector('.morning-user');
      container.innerHTML = `
        <h2>${greeting}, Mr <span>${name}</span></h2>
        <p>${subMessage}</p>
      `;
    })();


    // Performance Chart
    const performanceCtx = document.getElementById('performanceChart').getContext('2d');
    new Chart(performanceCtx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [{
                label: 'Revenue ($000)',
                data: [85, 92, 78, 89, 95, 102, 88, 94, 97, 105, 112, 125],
                borderColor: '#007bff',
                backgroundColor: 'rgba(0, 123, 255, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Expenses ($000)',
                data: [65, 70, 68, 72, 74, 78, 75, 79, 82, 85, 88, 89],
                borderColor: '#dc3545',
                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            plugins: {
                legend: {
                    position: 'top'
                }
            }
        }
    });

    // Vehicle Status Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: ['Active', 'Maintenance', 'Inactive'],
            datasets: [{
                data: [75, 15, 10],
                backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
                borderWidth: 2,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });

    // Branch Revenue Chart
    const branchRevenueCtx = document.getElementById('branchRevenueChart').getContext('2d');
    new Chart(branchRevenueCtx, {
        type: 'bar',
        data: {
            labels: ['Downtown', 'North', 'South', 'East'],
            datasets: [{
                label: 'Revenue ($000)',
                data: [35, 28, 42, 25],
                backgroundColor: ['#007bff', '#28a745', '#ffc107', '#17a2b8'],
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });

    // Fleet Utilization Chart
    const utilizationCtx = document.getElementById('utilizationChart').getContext('2d');
    new Chart(utilizationCtx, {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
                label: 'Utilization %',
                data: [85, 90, 87, 92, 88, 75, 70],
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#28a745',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    ticks: {
                        callback: function(value) {
                            return value + '%';
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });

    // Counter animation
    document.querySelectorAll('.counter-up').forEach(counter => {
        const target = parseInt(counter.textContent);
        const increment = target / 100;
        let count = 0;
        const timer = setInterval(() => {
            count += increment;
            if (count >= target) {
                counter.textContent = target;
                clearInterval(timer);
            } else {
                counter.textContent = Math.floor(count);
            }
        }, 20);
    });
</script>  *@