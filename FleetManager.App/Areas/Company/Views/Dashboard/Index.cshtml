      //       data: {
      //         labels: branchLabels,
      //         datasets: [{
      //           label: 'Expenses (₦)',
      //           data: branchExpenses,
      //           backgroundColor: [
      //             '#007bff', '#28a745', '#dc3545', '#ffc107',
      //             '#17a2b8', '#6f42c1', '#fd7e14', '#20c997'
      //           ],
      //           borderRadius: 5,
      //           borderSkipped: false
      //         }]
      //       },
      //       options: {
      //         responsive: true,
      //         maintainAspectRatio: false,
      //         plugins: {
      //           legend: { display: false },
      //           tooltip: {
      //             callbacks: {
      //               label: function(context) {
      //                 return formatCurrency(context.parsed.y);
      //               }
      //             }
