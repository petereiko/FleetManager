@using FleetManager.Business.DataObjects.CompanyOwnerDashboardDto
@using FleetManager.Business.Database.IdentityModels
@using FleetManager.Business.Interfaces.UserModule
@using FleetManager.Business.ViewModels
@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@inject IAuthUser _authUser;
@model CompanyOwnerDashboardDto
@{
    ViewData["Title"] = "Fleetalia Manager - Company Owner Dashboard";
    // Currency formatting helper
    Func<decimal, string> ngn = (amt) => string.Format(new System.Globalization.CultureInfo("en-NG"), "₦{0:N0}", amt);
    // Percentage calculation helper
    Func<int, int, double> percent = (value, total) => total > 0 ? Math.Round((double)value / total * 100, 1) : 0;
    // Safe null check for model properties
    var branches = Model?.Branches ?? new List<BranchSummaryDto>();
    var totals = Model?.Totals ?? new TotalsDto();
    var allBranches = Model?.AllBranches ?? new List<BranchListItemDto>();
}

<style>
    /* ══════════════════════════════════════════════════════
       OWNER DASHBOARD — Fleetalia v4 Theme
       Clean navy+green, professional, minimal gradients
    ══════════════════════════════════════════════════════ */

    :root {
        --navy:       #1B2856;
        --navy-mid:   #223068;
        --green:      #00664c;
        --green-light:#00875f;
        --green-pale: #6ee7b7;
        --white:      #ffffff;
        --surface:    #f7f8fa;
        --border:     #e2e4e8;
        --border-mid: #d0d4dc;
        --dark:       #1a1c20;
        --dark-60:    rgba(26,28,32,0.60);
        --dark-35:    rgba(26,28,32,0.35);
        --danger:     #c0392b;
        --danger-bg:  #fdf2f2;
        --warn:       #c07800;
        --warn-bg:    #fff9ee;
        --success:    #00664c;
        --info:       #1B2856;
    }

    /* Page header */
    .dashboard-header {
        background: var(--navy);
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(27,40,86,0.12);
    }

    .dashboard-header::before {
        content: '';
        position: absolute;
        top: -40px;
        right: -40px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(0,102,76,0.08);
        pointer-events: none;
    }

    .dashboard-header-content {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .dh-left h1 {
        font-size: 22px;
        font-weight: 800;
        color: #fff;
        margin: 0 0 4px;
        letter-spacing: -0.02em;
    }

    .dh-left p {
        font-size: 13px;
        color: rgba(255,255,255,0.65);
        margin: 0;
    }

    .dh-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dh-btn {
        height: 40px;
        padding: 0 16px;
        border: none;
        border-radius: 8px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.12s;
        display: flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
    }

    .dh-btn-primary {
        background: var(--green);
        color: #fff;
        box-shadow: 0 2px 6px rgba(0,102,76,0.2);
    }

    .dh-btn-primary:hover {
        background: var(--green-light);
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0,102,76,0.28);
        color: #fff;
    }

    .dh-btn-secondary {
        background: rgba(255,255,255,0.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .dh-btn-secondary:hover {
        background: rgba(255,255,255,0.25);
        color: #fff;
    }

    .dh-select {
        height: 40px;
        padding: 0 12px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 8px;
        background: rgba(255,255,255,0.1);
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        min-width: 160px;
        cursor: pointer;
        outline: none;
    }

    .dh-select option { background: var(--navy); color: #fff; }

    /* Stats cards */
    .dash-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
        margin-bottom: 20px;
    }

    .dash-stat {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        position: relative;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        transition: box-shadow 0.15s, transform 0.15s;
    }

    .dash-stat::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--green);
        border-radius: 12px 12px 0 0;
    }

    .dash-stat:hover {
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        transform: translateY(-2px);
    }

    .dash-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: rgba(27,40,86,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

    .dash-stat-icon img {
        width: 24px;
        height: 24px;
    }

    .dash-stat h6 {
        font-size: 13px;
        font-weight: 600;
        color: var(--dark-60);
        margin: 0 0 8px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .dash-stat-num {
        font-size: 2rem;
        font-weight: 800;
        color: var(--dark);
        line-height: 1;
        margin-bottom: 6px;
        font-family: 'DM Mono', monospace;
    }

    .dash-stat-sub {
        font-size: 12px;
        color: var(--dark-60);
    }

    .dash-stat-manage {
        position: absolute;
        top: 14px;
        right: 14px;
        font-size: 11px;
        font-weight: 600;
        color: var(--green);
        text-decoration: none;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(0,102,76,0.08);
        transition: all 0.12s;
    }

    .dash-stat-manage:hover {
        background: rgba(0,102,76,0.15);
        color: var(--green-light);
    }

    /* Financial cards */
    .fin-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
        margin-bottom: 20px;
    }

    .fin-card {
        background: var(--navy);
        color: #fff;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        box-shadow: 0 2px 10px rgba(27,40,86,0.15);
        position: relative;
        overflow: hidden;
    }

    .fin-card.fuel { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%); }
    .fin-card.maint { background: linear-gradient(135deg, var(--green) 0%, var(--green-light) 100%); }
    .fin-card.total { background: linear-gradient(135deg, #1B2856 0%, #00664c 100%); }

    .fin-card::before {
        content: '';
        position: absolute;
        top: -30px;
        right: -30px;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        pointer-events: none;
    }

    .fin-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        opacity: 0.85;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .fin-value {
        font-size: 2rem;
        font-weight: 800;
        font-family: 'DM Mono', monospace;
        margin-bottom: 8px;
        line-height: 1;
    }

    .fin-sub {
        font-size: 12px;
        opacity: 0.75;
    }

    /* Dashboard cards */
    .dash-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .dash-card-header {
        background: var(--navy);
        padding: 16px 22px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .dash-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .dash-card-body {
        padding: 22px;
    }

    /* Branch performance list */
    .branch-perf-item {
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
    }

    .branch-perf-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .bp-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .bp-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--dark);
    }

    .bp-perc {
        font-size: 13px;
        color: var(--dark-60);
    }

    .bp-bar {
        height: 8px;
        background: var(--surface);
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .bp-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--green), var(--green-light));
        border-radius: 99px;
        transition: width 0.3s ease;
    }

    .bp-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        font-size: 12px;
        color: var(--dark-60);
    }

    .bp-meta-item {
        display: flex;
        justify-content: space-between;
    }

    .bp-btn {
        margin-top: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--green);
        background: rgba(0,102,76,0.08);
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.12s;
    }

    .bp-btn:hover {
        background: rgba(0,102,76,0.15);
        color: var(--green-light);
    }

    /* Tables */
    .dash-table-wrap {
        overflow-x: auto;
    }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .dash-table thead th {
        background: var(--surface);
        padding: 12px 14px;
        font-size: 11px;
        font-weight: 700;
        color: var(--dark-60);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-align: left;
        border-bottom: 2px solid var(--border);
    }

    .dash-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background 0.12s;
    }

    .dash-table tbody tr:hover {
        background: rgba(27,40,86,0.02);
    }

    .dash-table tbody td {
        padding: 14px;
        color: var(--dark);
        vertical-align: middle;
    }

    .dash-table .progress-mini {
        width: 60px;
        height: 6px;
        background: var(--surface);
        border-radius: 99px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }

    .dash-table .progress-mini-fill {
        height: 100%;
        background: var(--green);
        border-radius: 99px;
    }

    /* Notifications */
    .notif-indicator {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .notif-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .notif-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(27,40,86,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--navy);
        font-size: 16px;
    }

    .notif-text {
        font-size: 13px;
        font-weight: 600;
        color: var(--dark);
    }

    .notif-btn {
        height: 36px;
        padding: 0 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--white);
        font-size: 13px;
        font-weight: 600;
        color: var(--navy);
        cursor: pointer;
        transition: all 0.12s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .notif-btn:hover {
        background: var(--surface);
        border-color: var(--border-mid);
    }

    .notif-badge {
        background: var(--danger);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 99px;
        margin-left: 4px;
    }

    /* Chart containers */
    .chart-wrap {
        position: relative;
        height: 320px;
    }

    .chart-loading, .chart-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--dark-60);
    }

    .chart-loading i, .chart-error i {
        font-size: 2rem;
        margin-bottom: 12px;
        opacity: 0.3;
    }

    .chart-error {
        color: var(--danger);
    }

    .chart-error button {
        margin-top: 12px;
        padding: 8px 16px;
        border: 1px solid var(--danger);
        border-radius: 6px;
        background: var(--danger-bg);
        color: var(--danger);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    /* Badges */
    .badge-sm {
        font-size: 10px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 99px;
    }

    .badge.bg-danger {
        background: var(--danger) !important;
    }

    .badge.bg-primary {
        background: var(--navy) !important;
    }

    .badge.bg-warning {
        background: var(--warn) !important;
    }

    /* Loading spinner */
    .loading-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid var(--border);
        border-top-color: var(--green);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-header-content {
            flex-direction: column;
            align-items: flex-start;
        }
        .dh-right {
            width: 100%;
            flex-direction: column;
        }
        .dh-btn, .dh-select {
            width: 100%;
            justify-content: center;
        }
        .dash-stats {
            grid-template-columns: 1fr;
        }
        .fin-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Page Header -->
<div class="dashboard-header">
    <div class="dashboard-header-content">
        <div class="dh-left">
            <h1>Company Owner Dashboard</h1>
            <p>
                Company ID: @Model.CompanyId |
                Generated: @Model.GeneratedAt.ToString("MMM dd, yyyy HH:mm") |
                Showing: <span id="viewingScope">@(Model.IsFiltered == true ? "Single Branch" : "All Branches")</span>
            </p>
        </div>
        <div class="dh-right">
            <button id="refreshDashboardBtn" class="dh-btn dh-btn-secondary">
                <i class="fa-solid fa-arrows-rotate"></i>
                <span class="refresh-text">Refresh</span>
                <span class="loading-spinner d-none"></span>
            </button>
            <select id="branchSelect" class="dh-select">
                <option value="">All branches</option>
                @foreach (var branch in allBranches)
                {
                    <option value="@branch.BranchId">@branch.BranchName</option>
                }
            </select>
            <a asp-action="Index" asp-controller="Branch" class="dh-btn dh-btn-primary">
                <i class="fa-solid fa-building"></i>
                Manage Branches
            </a>
        </div>
    </div>
</div>

<!-- Notification Indicator -->
<div class="notif-indicator">
    <div class="notif-left">
        <div class="notif-icon">
            <i class="fa-solid fa-bell"></i>
        </div>
        <span class="notif-text" id="notificationSummary">All systems operational</span>
    </div>
    <button id="viewNotificationsBtn" class="notif-btn" data-bs-toggle="modal" data-bs-target="#notificationsModal">
        View Details
        <span id="notificationBadge" class="notif-badge d-none">0</span>
    </button>
</div>

<!-- Stats Grid -->
<div class="dash-stats">
    <div class="dash-stat">
        <a asp-action="Index" asp-controller="Branch" class="dash-stat-manage">Manage</a>
        <div class="dash-stat-icon">
            <img src="~/assets/img/icons/profile-add.svg" alt="">
        </div>
        <h6>Branches</h6>
        <div class="dash-stat-num" id="branchCount">@(Model?.BranchCount ?? 0)</div>
        <div class="dash-stat-sub"><span id="visibleBranches">@(branches.Count())</span> visible</div>
    </div>

    <div class="dash-stat">
        <a asp-action="Index" asp-controller="OnboardAdmin" class="dash-stat-manage">Manage</a>
        <div class="dash-stat-icon">
            <img src="~/assets/img/icons/profile-add.svg" alt="">
        </div>
        <h6>Company Admins</h6>
        <div class="dash-stat-num" id="adminCount">@(Model?.AdminCount ?? 0)</div>
        <div class="dash-stat-sub">Active administrators</div>
    </div>

    <div class="dash-stat">
        <div class="dash-stat-icon">
            <img src="~/assets/img/icons/scissor.svg" alt="">
        </div>
        <h6>Vehicles</h6>
        <div class="dash-stat-num" id="vehicleCount">@(Model?.VehicleCount ?? 0)</div>
        <div class="dash-stat-sub"><span id="assignedVehiclesCount">@totals.AssignedVehicles</span> assigned</div>
    </div>

    <div class="dash-stat">
        <div class="dash-stat-icon">
            <img src="~/assets/img/icons/empty-wallet.svg" alt="">
        </div>
        <h6>Drivers</h6>
        <div class="dash-stat-num" id="driverCount">@(Model?.DriverCount ?? 0)</div>
        <div class="dash-stat-sub">Total drivers</div>
    </div>
</div>

<!-- Financial Cards -->
<div class="fin-cards">
    <div class="fin-card total">
        <div class="fin-label">Total Spend</div>
        <div class="fin-value" id="monthlyExpenditure">@ngn(totals.TotalSpend)</div>
        <div class="fin-sub" id="monthlyExpenditureDelta">
            Fuel: <span id="fuelSpendBreakdown">@ngn(totals.FuelSpend)</span> |
            Maint: <span id="maintenanceSpendBreakdown">@ngn(totals.MaintenanceSpend)</span> |
            Fines: <span id="finesSpendBreakdown">@ngn(totals.FinesSpend)</span>
        </div>
    </div>

    <div class="fin-card fuel">
        <div class="fin-label">Fuel Expenses</div>
        <div class="fin-value" id="monthlyExpenses">@ngn(totals.FuelSpend)</div>
        <div class="fin-sub" id="monthlyExpensesDelta">
            <span id="fuelPercentage">
                @{
                    var fuelPercent = totals.TotalSpend > 0 ? Math.Round((totals.FuelSpend / totals.TotalSpend) * 100, 1) : 0;
                }
                @fuelPercent%
            </span> of total spend
        </div>
    </div>

    <div class="fin-card maint">
        <div class="fin-label">Maintenance Expenses</div>
        <div class="fin-value" id="monthlyRecurrent">@ngn(totals.MaintenanceSpend)</div>
        <div class="fin-sub" id="monthlyRecurrentDelta">
            <span id="maintenancePercentage">
                @{
                    var maintPercent = totals.TotalSpend > 0 ? Math.Round((totals.MaintenanceSpend / totals.TotalSpend) * 100, 1) : 0;
                }
                @maintPercent%
            </span> of total spend
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row">
    <div class="col-md-8">
        <div class="dash-card">
            <div class="dash-card-header">
                <h5 class="dash-card-title">Monthly Expenses Trend</h5>
            </div>
            <div class="dash-card-body">
                <div class="chart-wrap" id="performanceChartContainer">
                    <div class="chart-loading" id="performanceLoading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <p>Loading expense data...</p>
                    </div>
                    <div class="chart-error d-none" id="performanceError">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <p>Failed to load expense data</p>
                        <button onclick="retryChart('performance')">Retry</button>
                    </div>
                    <canvas id="performanceChart" class="d-none"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card">
            <div class="dash-card-header">
                <h5 class="dash-card-title">Vehicle Status Distribution</h5>
            </div>
            <div class="dash-card-body">
                <div class="chart-wrap" id="statusChartContainer">
                    <div class="chart-loading" id="statusLoading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <p>Loading status data...</p>
                    </div>
                    <div class="chart-error d-none" id="statusError">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <p>Failed to load status data</p>
                        <button onclick="retryChart('status')">Retry</button>
                    </div>
                    <canvas id="statusChart" class="d-none"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Branch Performance & Revenue -->
<div class="row">
    <div class="col-md-6">
        <div class="dash-card">
            <div class="dash-card-header">
                <h5 class="dash-card-title">Branch Performance Metrics</h5>
            </div>
            <div class="dash-card-body" id="branchPerformanceList">
                @if (branches.Any())
                {
                    @foreach (var branch in branches.Take(6))
                    {
                        var perfPercent = (int)Math.Round(branch.PerformancePercentage);
                        var utilizationRate = branch.TotalVehicles > 0 ? Math.Round(((double)branch.AssignedVehicleCount / branch.TotalVehicles) * 100, 1) : 0;
                        <div class="branch-perf-item">
                            <div class="bp-top">
                                <span class="bp-name">@branch.BranchName</span>
                                <span class="bp-perc">@perfPercent% performance</span>
                            </div>
                            <div class="bp-bar">
                                <div class="bp-bar-fill" style="width: @perfPercent%"></div>
                            </div>
                            <div class="bp-meta">
                                <div class="bp-meta-item">
                                    <strong>Utilization:</strong>
                                    <span>@branch.AssignedVehicleCount/@branch.TotalVehicles (@utilizationRate%)</span>
                                </div>
                                <div class="bp-meta-item">
                                    <strong>Total Spend:</strong>
                                    <span>@ngn(branch.TotalSpend)</span>
                                </div>
                                <div class="bp-meta-item">
                                    <strong>Manager:</strong>
                                    <span>@(branch.ManagerName ?? "Not assigned")</span>
                                </div>
                                <div class="bp-meta-item">
                                    <strong>Open Tickets:</strong>
                                    <span>
                                        @branch.OpenMaintenanceTickets
                                        @if (branch.OverdueMaintenanceTickets > 0)
                                        {
                                            <span style="color:var(--danger);">(@branch.OverdueMaintenanceTickets overdue)</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <button class="bp-btn view-branch" data-branch="@branch.BranchId">View Details</button>
                        </div>
                    }
                }
                else
                {
                    <div style="color:var(--dark-60);text-align:center;padding:40px 20px;">No branches to display.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="dash-card">
            <div class="dash-card-header">
                <h5 class="dash-card-title">Expenses by Branch</h5>
            </div>
            <div class="dash-card-body">
                <div class="chart-wrap" id="branchRevenueContainer">
                    <div class="chart-loading" id="branchRevenueLoading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <p>Loading branch data...</p>
                    </div>
                    <div class="chart-error d-none" id="branchRevenueError">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <p>Failed to load branch data</p>
                        <button onclick="retryChart('branchRevenue')">Retry</button>
                    </div>
                    <canvas id="branchRevenueChart" class="d-none"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Branch Summary Table -->
@if (branches.Any())
{
    <div class="dash-card">
        <div class="dash-card-header">
            <h5 class="dash-card-title">Branch Summary Table</h5>
        </div>
        <div class="dash-card-body">
            <div class="dash-table-wrap">
                <table class="dash-table" id="branchSummaryTable">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Manager</th>
                            <th>Admin</th>
                            <th>Drivers</th>
                            <th>Vehicles</th>
                            <th>Utilization</th>
                            <th>Open Tickets</th>
                            <th>Total Spend</th>
                            <th>Performance</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in branches)
                        {
                            var utilizationRate = branch.TotalVehicles > 0 ? Math.Round(((double)branch.AssignedVehicleCount / branch.TotalVehicles) * 100, 1) : 0;
                            var perfPercent = (int)Math.Round(branch.PerformancePercentage);
                            <tr>
                                <td><strong>@branch.BranchName</strong></td>
                                <td>@(branch.ManagerName ?? "—")</td>
                                <td>@(branch.CompanyAdminName ?? "—")</td>
                                <td>@branch.ActiveDrivers/@branch.TotalDrivers</td>
                                <td>@branch.AssignedVehicleCount/@branch.TotalVehicles</td>
                                <td>
                                    <div class="progress-mini">
                                        <div class="progress-mini-fill" style="width: @utilizationRate%"></div>
                                    </div>
                                    <small>@utilizationRate%</small>
                                </td>
                                <td>
                                    @branch.OpenMaintenanceTickets
                                    @if (branch.OverdueMaintenanceTickets > 0)
                                    {
                                        <span class="badge bg-danger badge-sm">@branch.OverdueMaintenanceTickets overdue</span>
                                    }
                                </td>
                                <td>@ngn(branch.TotalSpend)</td>
                                <td>
                                    <div class="progress-mini">
                                        <div class="progress-mini-fill" style="width: @perfPercent%"></div>
                                    </div>
                                    <small>@perfPercent%</small>
                                </td>
                                <td>
                                    <button class="bp-btn view-branch" data-branch="@branch.BranchId">Details</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

