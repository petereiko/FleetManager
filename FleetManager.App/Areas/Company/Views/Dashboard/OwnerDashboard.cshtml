      // Retry functions
      window.retryChart = function(chartType) {
        switch(chartType) {
          case 'performance':
            loadPerformanceChart(currentBranchId);
            break;
          case 'branchRevenue':
            initBranchRevenueChart(currentDashboardData?.branches || []);
            break;
          case 'status':
            initStatusChart(currentDashboardData || {});
            break;
        }
      };

      // Refresh all data
      async function refreshAllData() {
        if (isRefreshing) return;
        await loadScopedDashboard(currentBranchId);
      }

      // Event handlers
      document.getElementById('branchSelect')?.addEventListener('change', function() {
        const val = this.value;
        loadScopedDashboard(val || null);
      });

      document.getElementById('refreshDashboardBtn')?.addEventListener('click', refreshAllData);

      // Global function for retry
      window.loadRecentActivities = function() { loadRecentActivitiesForBranch(currentBranchId); };

      // Alerts collapse functionality
      document.getElementById('alertsContainer')?.addEventListener('hidden.bs.collapse', function() {
        document.getElementById('alertsToggleIcon').className = 'fas fa-plus';
      });

      document.getElementById('alertsContainer')?.addEventListener('shown.bs.collapse', function() {
        document.getElementById('alertsToggleIcon').className = 'fas fa-minus';
      });

      // Initialize
      setGreeting();

      // Seed charts with initial data
      if (initialDashboard) {
        applyDtoToUi(initialDashboard);
        initBranchRevenueChart(initialDashboard.branches || []);
        initStatusChart(initialDashboard);
      }

      // Load performance chart and recent activities
      loadPerformanceChart(currentBranchId);
      loadRecentActivitiesForBranch(currentBranchId);

      // Initialize branch select value
      const branchSelect = document.getElementById('branchSelect');
      if (branchSelect && initialDashboard?.isFiltered && initialDashboard.branchId) {
        branchSelect.value = initialDashboard.branchId;
        currentBranchId = initialDashboard.branchId;
      }




          // Event Listeners for notifications
    document.addEventListener('DOMContentLoaded', function() {
        // Show notifications in modal when opened
        const notificationsModal = document.getElementById('notificationsModal');
        notificationsModal?.addEventListener('show.bs.modal', function() {
            populateNotificationsModal(window.currentAlerts || []);
        });

        // Refresh notifications
        document.getElementById('refreshNotificationsBtn')?.addEventListener('click', function() {
            const alerts = generateAlerts(currentDashboardData);
            updateNotificationIndicator(alerts);
            populateNotificationsModal(alerts);
        });

        // Optional: Click indicator to open modal
        document.querySelector('.notification-indicator .alert')?.addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('notificationsModal'));
            modal.show();
        });
    });

    })();
</script>

