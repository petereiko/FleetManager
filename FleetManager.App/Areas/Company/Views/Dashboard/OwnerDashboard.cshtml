        if (!branchId) return;

        try {
          const modalEl = document.getElementById('branchDetailModal');
          const modal = new bootstrap.Modal(modalEl);
          modal.show();

          document.getElementById('branchDetailTitle').textContent = 'Loading Branch Details...';
          document.getElementById('branchDetailBody').innerHTML = `
            <div class="text-center">
