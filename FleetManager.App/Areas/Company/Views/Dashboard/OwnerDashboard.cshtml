      // Load Recent Activities
      async function loadRecentActivitiesForBranch(branchId) {
        const tbody = document.querySelector('#recentActivitiesTable tbody');
        const errorDiv = document.getElementById('activitiesError');

        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted"><div class="loading-spinner me-2"></div>Loading recent activities...</td></tr>`;
        errorDiv.classList.add('d-none');

        try {
          const url = `/Company/Dashboard/RecentActivities?branchId=${encodeURIComponent(branchId || '')}&size=10`;
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Server returned ${response.status}`);

          const result = await response.json();
          if (!result.success) throw new Error(result.error || 'Failed to load activities');

          const data = result.data;
          const activities = [];

          // Combine fuel logs and maintenance tickets
          if (data.recentFuel && Array.isArray(data.recentFuel)) {
            data.recentFuel.forEach(f => {
              activities.push({
                ...f,
                activityType: 'Fuel',
                amount: get(f, 'cost') || 0,
                volume: get(f, 'volume') || 0
              });
            });
          }

          if (data.recentTickets && Array.isArray(data.recentTickets)) {
            data.recentTickets.forEach(t => {
              activities.push({
                ...t,
                activityType: 'Maintenance',
                amount: get(t, 'estimatedCost') || get(t, 'invoiceAmount') || 0,
                volume: null
              });
            });
          }

          // Sort by date (most recent first)
          activities.sort((a, b) => {
            const dateA = new Date(get(a, 'date') || get(a, 'createdDate') || 0);
            const dateB = new Date(get(b, 'date') || get(b, 'createdDate') || 0);
            return dateB - dateA;
          });

          populateRecentActivities(activities);
        } catch (err) {
          console.error('Error loading recent activities:', err);
          tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No recent activities available</td></tr>';
          errorDiv.classList.remove('d-none');
        }
      }

      function populateRecentActivities(rows) {
        const tbody = document.querySelector('#recentActivitiesTable tbody');
        if (!rows || rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No recent activities available</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        for (const r of rows.slice(0, 15)) {
          const vehicleId = get(r, 'vehiclePlateNo') || `#${get(r, 'vehicleId') || ''}`;
          const driver = get(r, 'driverName') || (get(r, 'driverId') ? ('Driver ' + get(r, 'driverId')) : '—');
          const activityType = get(r, 'activityType') || 'Activity';
          const amount = get(r, 'amount') || 0;
          const volume = get(r, 'volume');
          const date = new Date(get(r, 'date') || get(r, 'createdDate') || Date.now()).toLocaleDateString();
          const branch = get(r, 'branchName') || '—';

          let amountDisplay = '';
          if (activityType === 'Fuel') {
            amountDisplay = volume ? `${volume}L / ${formatCurrency(amount)}` : formatCurrency(amount);
          } else {
            amountDisplay = formatCurrency(amount);
          }

          tbody.innerHTML += `
            <tr>
              <td><strong>${vehicleId}</strong></td>
              <td>${driver}</td>
              <td><span class="badge bg-${activityType === 'Fuel' ? 'primary' : 'warning'}">${activityType}</span></td>
              <td>${amountDisplay}</td>
              <td>${date}</td>
              <td>${branch}</td>
              <td>
                <button class="btn btn-sm btn-outline-primary view-branch" data-branch="${get(r, 'branchId') || get(r, 'companyBranchId') || ''}">View Branch</button>
              </td>
            </tr>`;
        }
      }

      // Load scoped dashboard
      async function loadScopedDashboard(branchId) {
        if (isRefreshing) return;
        setRefreshLoading(true);
        currentBranchId = branchId || null;

        try {
          const url = `/Company/Dashboard/Scoped?branchId=${encodeURIComponent(branchId || '')}&recentSize=10`;
          const res = await fetch(url);
          if (!res.ok) throw new Error('Failed to load scoped dashboard');

          const result = await res.json();
          if (!result.success) throw new Error(result.error || 'Failed to load dashboard data');

          const dto = result.data;
          applyDtoToUi(dto);

          // Update charts with new data
          await loadPerformanceChart(currentBranchId);
          initBranchRevenueChart(dto.branches || []);
          initStatusChart(dto);

          // Load recent activities
          await loadRecentActivitiesForBranch(currentBranchId);
        } catch (err) {
          console.error('Error loading scoped dashboard:', err);
        } finally {
          setRefreshLoading(false);
        }
      }

