<!-- Chart.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<script>
    (function () {
      // Server-provided initial dashboard DTO
      const initialDashboard = @Html.Raw(JsonSerializer.Serialize(Model ?? new CompanyOwnerDashboardDto()));
      const currentUserFirstName = '@(_authUser?.FirstName ?? "")';

      // Global state
      let charts = {
        performance: null,
        branchRevenue: null,
        status: null,
        utilization: null
      };

      let currentBranchId = null;
      let isRefreshing = false;
      let currentDashboardData = initialDashboard;

      // Helpers
      function formatCurrency(v) {
        try {
          return new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(v || 0);
        } catch (e) {
          return '₦' + (v || 0).toLocaleString();
        }
      }

      function get(obj, key) {
        if (!obj) return undefined;
        if (Object.prototype.hasOwnProperty.call(obj, key)) return obj[key];
        const camel = key.charAt(0).toLowerCase() + key.slice(1);
        if (Object.prototype.hasOwnProperty.call(obj, camel)) return obj[camel];
        const pascal = key.charAt(0).toUpperCase() + key.slice(1);
        if (Object.prototype.hasOwnProperty.call(obj, pascal)) return obj[pascal];
        return undefined;
      }

      // Loading UI helpers
      function showLoading(name) {
        document.getElementById(`${name}Loading`)?.classList.remove('d-none');
        document.getElementById(`${name}Chart`)?.classList.add('d-none');
        document.getElementById(`${name}Error`)?.classList.add('d-none');
      }
      function hideLoading(name) {
        document.getElementById(`${name}Loading`)?.classList.add('d-none');
        document.getElementById(`${name}Chart`)?.classList.remove('d-none');
      }
      function showError(name) {
        document.getElementById(`${name}Loading`)?.classList.add('d-none');
        document.getElementById(`${name}Chart`)?.classList.add('d-none');
        document.getElementById(`${name}Error`)?.classList.remove('d-none');
      }
      function setRefreshLoading(loading) {
        const btn = document.getElementById('refreshDashboardBtn');
        if (!btn) return;
        const text = btn.querySelector('.refresh-text');
        const spinner = btn.querySelector('.loading-spinner');
        if (loading) {
          text.classList.add('d-none');
          spinner.classList.remove('d-none');
          btn.disabled = true;
          isRefreshing = true;
        } else {
          text.classList.remove('d-none');
          spinner.classList.add('d-none');
          btn.disabled = false;
          isRefreshing = false;
        }
      }

      // Greeting
      function setGreeting() {
        const name = currentUserFirstName || '';
        const hour = new Date().getHours();
        let greeting, subMessage;

        if (hour < 12) {
          greeting = "Good Morning";
          subMessage = "Ready to lead your fleet to new heights today?";
        } else if (hour < 17) {
          greeting = "Good Afternoon";
          subMessage = "Hope your strategic vision is coming together smoothly!";
        } else {
          greeting = "Good Evening";
          subMessage = "Take a moment to review today's fleet achievements.";
        }

        const container = document.querySelector('.morning-user');
        if (container) {
          container.innerHTML = `
            <h2>${greeting}${name ? ', ' + name : ''}</h2>
            <p>${subMessage}</p>
          `;
        }
      }

      // Enhanced Alerts Generation
      function generateAlerts(dashboardData) {
        const alerts = [];
        const branches = dashboardData?.branches || [];
        const totals = dashboardData?.totals || {};

        // Critical Alerts (High Priority)
        branches.forEach(branch => {
          if (get(branch, 'overdueMaintenanceTickets') > 0) {
            alerts.push({
              type: 'high',
              priority: 'critical',
              icon: 'fas fa-exclamation-circle',
              title: 'Critical Maintenance Overdue',
              message: `${get(branch, 'branchName')} has ${get(branch, 'overdueMaintenanceTickets')} overdue maintenance ticket(s)`,
              subtext: 'Immediate attention required - Safety risk',
              branchId: get(branch, 'branchId'),
              action: 'View Branch'
            });
          }

          // Vehicles with no assigned drivers
          const unassignedVehicles = (get(branch, 'totalVehicles') || 0) - (get(branch, 'assignedVehicleCount') || 0);
          if (unassignedVehicles > 0) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-car',
              title: 'Unassigned Vehicles',
              message: `${get(branch, 'branchName')} has ${unassignedVehicles} unassigned vehicle(s)`,
              subtext: 'Revenue opportunity being missed',
              branchId: get(branch, 'branchId'),
              action: 'Assign Drivers'
            });
          }

          // Driver shortage
          const driverShortage = (get(branch, 'totalVehicles') || 0) - (get(branch, 'totalDrivers') || 0);
          if (driverShortage > 0) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-user-tie',
              title: 'Driver Shortage',
              message: `${get(branch, 'branchName')} needs ${driverShortage} more driver(s)`,
              subtext: 'Consider recruitment or transfers',
              branchId: get(branch, 'branchId'),
              action: 'Recruit Drivers'
            });
          }

          // Low utilization
          const totalVehicles = get(branch, 'totalVehicles') || 0;
          const assignedVehicles = get(branch, 'assignedVehicleCount') || 0;
          const utilization = totalVehicles > 0 ? (assignedVehicles / totalVehicles) : 0;
          if (totalVehicles > 0 && utilization < 0.6) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-chart-line',
              title: 'Low Vehicle Utilization',
              message: `${get(branch, 'branchName')} utilization: ${Math.round(utilization * 100)}%`,
              subtext: 'Review vehicle assignments and driver allocation',
              branchId: get(branch, 'branchId'),
              action: 'Optimize'
            });
          }

          // High maintenance frequency
          const openTickets = get(branch, 'openMaintenanceTickets') || 0;
          if (openTickets > 5) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-wrench',
              title: 'High Maintenance Activity',
              message: `${get(branch, 'branchName')} has ${openTickets} open maintenance tickets`,
              subtext: 'Monitor for recurring issues or aging fleet',
              branchId: get(branch, 'branchId'),
              action: 'Review Maintenance'
            });
          }

          // Missing manager or admin
          if (!get(branch, 'managerName')) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-user-crown',
              title: 'Manager Not Assigned',
              message: `${get(branch, 'branchName')} has no assigned manager`,
              subtext: 'Branch operations may be affected',
              branchId: get(branch, 'branchId'),
              action: 'Assign Manager'
            });
          }

          if (!get(branch, 'companyAdminName')) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-user-shield',
              title: 'Admin Not Assigned',
              message: `${get(branch, 'branchName')} has no company admin`,
              subtext: 'Administrative oversight needed',
              branchId: get(branch, 'branchId'),
              action: 'Assign Admin'
            });
          }
        });

        // Financial Alerts
        const totalSpend = get(totals, 'totalSpend') || 0;
        const fuelSpend = get(totals, 'fuelSpend') || 0;
        const maintenanceSpend = get(totals, 'maintenanceSpend') || 0;
        const finesSpend = get(totals, 'finesSpend') || 0;

        if (totalSpend > 0) {
          const fuelPercent = (fuelSpend / totalSpend) * 100;
          const maintenancePercent = (maintenanceSpend / totalSpend) * 100;

          if (fuelPercent > 70) {
            alerts.push({
              type: 'medium',
              priority: 'financial',
              icon: 'fas fa-gas-pump',
              title: 'High Fuel Costs',
              message: `Fuel expenses account for ${Math.round(fuelPercent)}% of total spend`,
              subtext: 'Consider fuel efficiency programs or route optimization',
              action: 'Analyze Fuel Usage'
            });
          }

          if (maintenancePercent > 25) {
            alerts.push({
              type: 'medium',
              priority: 'financial',
              icon: 'fas fa-tools',
              title: 'High Maintenance Costs',
              message: `Maintenance costs are ${Math.round(maintenancePercent)}% of total spend`,
              subtext: 'Review maintenance practices and vendor contracts',
              action: 'Review Maintenance'
            });
          }

          if (finesSpend > (totalSpend * 0.1)) {
            alerts.push({
              type: 'high',
              priority: 'critical',
              icon: 'fas fa-exclamation-triangle',
              title: 'High Fine Costs',
              message: `Fines account for ${Math.round((finesSpend / totalSpend) * 100)}% of total spend`,
              subtext: 'Driver training or policy enforcement needed',
              action: 'Review Violations'
            });
          }
        }

        // Fleet Utilization Alerts
        const totalVehicles = dashboardData?.vehicleCount || 0;
        const assignedVehicles = get(totals, 'assignedVehicles') || 0;
        if (totalVehicles > 0) {
          const overallUtilization = (assignedVehicles / totalVehicles) * 100;
          if (overallUtilization < 60) {
            alerts.push({
              type: 'medium',
              priority: 'warning',
              icon: 'fas fa-car-side',
              title: 'Low Fleet Utilization',
              message: `Only ${Math.round(overallUtilization)}% of vehicles are assigned`,
              subtext: `${totalVehicles - assignedVehicles} vehicles are idle`,
              action: 'Optimize Fleet'
            });
          }
        }

        // Positive Alerts
        const highPerformingBranches = branches.filter(b => (get(b, 'performancePercentage') || 0) > 85);
        if (highPerformingBranches.length > 0) {
          alerts.push({
            type: 'low',
            priority: 'success',
            icon: 'fas fa-trophy',
            title: 'High Performance Branches',
            message: `${highPerformingBranches.length} branch(es) performing above 85%`,
            subtext: `Top performer: ${get(highPerformingBranches[0], 'branchName')} (${Math.round(get(highPerformingBranches[0], 'performancePercentage') || 0)}%)`,
            action: 'View Details'
          });
        }

        // Default message if no alerts
        if (alerts.length === 0) {
          alerts.push({
            type: 'low',
            priority: 'info',
            icon: 'fas fa-check-circle',
            title: 'All Systems Operational',
            message: 'No critical issues detected across your fleet operations',
            subtext: 'Continue monitoring for optimal performance',
            action: null
          });
        }

        return alerts.sort((a, b) => {
          const priorityOrder = { critical: 0, warning: 1, financial: 2, success: 3, info: 4 };
          return priorityOrder[a.priority] - priorityOrder[b.priority];
        });
      }


          function updateNotificationIndicator(alerts) {
        const summary = document.getElementById('notificationSummary');
        const badge = document.getElementById('notificationBadge');
        const indicator = document.querySelector('.notification-indicator .alert');

        const criticalAlerts = alerts.filter(a => a.priority === 'critical');
        const warningAlerts = alerts.filter(a => a.priority === 'warning');
        const totalActionable = criticalAlerts.length + warningAlerts.length;

        // Reset classes
        indicator.classList.remove('notification-pulse', 'notification-critical', 'notification-warning');

        if (criticalAlerts.length > 0) {
            summary.textContent = `${criticalAlerts.length} critical issue${criticalAlerts.length > 1 ? 's' : ''} require attention`;
            indicator.classList.add('notification-critical');
            badge.textContent = criticalAlerts.length;
            badge.classList.remove('d-none');
            badge.className = badge.className.replace(/bg-\w+/, 'bg-danger');
        } else if (warningAlerts.length > 0) {
            summary.textContent = `${warningAlerts.length} item${warningAlerts.length > 1 ? 's' : ''} need attention`;
            indicator.classList.add('notification-warning');
            badge.textContent = warningAlerts.length;
            badge.classList.remove('d-none');
            badge.className = badge.className.replace(/bg-\w+/, 'bg-warning');
        } else if (totalActionable > 0) {
            summary.textContent = `You may have some actions to attend to`;
            indicator.classList.add('notification-pulse');
            badge.textContent = totalActionable;
            badge.classList.remove('d-none');
            badge.className = badge.className.replace(/bg-\w+/, 'bg-info');
        } else {
            summary.textContent = 'All systems operational';
            badge.classList.add('d-none');
        }

        // Store alerts for modal display
        window.currentAlerts = alerts;
    }

    function populateNotificationsModal(alerts) {
        const modalBody = document.getElementById('notificationsModalBody');

        if (!alerts || alerts.length === 0) {
            modalBody.innerHTML = `
                <div class="text-center text-muted py-5">
                    <i class="fas fa-check-circle fa-3x mb-3 text-success"></i>
                    <h5>All Clear!</h5>
                    <p>No notifications or alerts at this time. Your fleet operations are running smoothly.</p>
                </div>
            `;
            return;
        }

        // Group alerts by priority
        const criticalAlerts = alerts.filter(a => a.priority === 'critical');
        const warningAlerts = alerts.filter(a => a.priority === 'warning');
        const infoAlerts = alerts.filter(a => ['success', 'info', 'financial'].includes(a.priority));

        let html = '';

        // Critical Alerts Section
        if (criticalAlerts.length > 0) {
            html += `
                <div class="mb-4">
                    <h6 class="text-danger mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Critical Issues (${criticalAlerts.length})
                    </h6>
                    ${criticalAlerts.map(alert => createModalAlertHtml(alert, 'high')).join('')}
                </div>
            `;
        }

        // Warning Alerts Section
        if (warningAlerts.length > 0) {
            html += `
                <div class="mb-4">
                    <h6 class="text-warning mb-3">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Attention Required (${warningAlerts.length})
                    </h6>
                    ${warningAlerts.map(alert => createModalAlertHtml(alert, 'medium')).join('')}
                </div>
            `;
        }

        // Info Alerts Section
        if (infoAlerts.length > 0) {
            html += `
                <div class="mb-4">
                    <h6 class="text-info mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Information & Updates (${infoAlerts.length})
                    </h6>
                    ${infoAlerts.map(alert => createModalAlertHtml(alert, 'low')).join('')}
                </div>
            `;
        }

        modalBody.innerHTML = html;
    }

    function createModalAlertHtml(alert, type) {
        const iconMap = {
            'critical': 'fas fa-exclamation-circle priority-critical',
            'warning': 'fas fa-exclamation-triangle priority-warning',
            'financial': 'fas fa-chart-line priority-warning',
            'success': 'fas fa-check-circle priority-success',
            'info': 'fas fa-info-circle priority-info'
        };

        const iconClass = iconMap[alert.priority] || 'fas fa-info-circle priority-info';

        return `
            <div class="modal-alert-item modal-alert-${type}">
                <div class="d-flex align-items-start">
                    <i class="${iconClass} priority-icon"></i>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">${alert.title}</h6>
                        <p class="mb-2">${alert.message}</p>
                        <small class="text-muted">${alert.subtext}</small>
                    </div>
                    <div class="ms-3">
                        ${alert.action ? `
                            <button class="btn btn-sm btn-outline-primary ${alert.branchId ? 'view-branch' : ''}"
                                    ${alert.branchId ? `data-branch="${alert.branchId}"` : ''}>
                                ${alert.action}
                            </button>
                        ` : ''}
                    </div>
                </div>
            </div>
        `;
    }

      // Chart initialization functions with proper data handling
      function initBranchRevenueChart(branches) {
        showLoading('branchRevenue');

        try {
          if (!branches || branches.length === 0) {
            showError('branchRevenue');
            return;
          }

          const branchLabels = branches.map(b => get(b, 'branchName') || 'Branch');
          const branchExpenses = branches.map(b => get(b, 'totalSpend') || 0);

          const ctx = document.getElementById('branchRevenueChart')?.getContext('2d');
          if (!ctx) { showError('branchRevenue'); return; }

          if (charts.branchRevenue) charts.branchRevenue.destroy();

          charts.branchRevenue = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: branchLabels,
              datasets: [{
                label: 'Total Expenses (₦)',
                data: branchExpenses,
                backgroundColor: 'rgba(54, 162, 235, 0.8)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1,
                borderRadius: 5,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: function(context) { return `Expenses: ${formatCurrency(context.parsed.y)}`; }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { callback: function(value) { return formatCurrency(value); } }
                },
                x: {
                  ticks: {
                    maxRotation: 45,
                    minRotation: 0
                  }
                }
              }
            }
          });

          hideLoading('branchRevenue');
        } catch (err) {
          console.error('Branch revenue chart error:', err);
          showError('branchRevenue');
        }
      }

      function initStatusChart(dashboardData) {
        showLoading('status');

        try {
          // Create meaningful vehicle status distribution
          const branches = dashboardData?.branches || [];
          const totals = dashboardData?.totals || {};

          let assigned = get(totals, 'assignedVehicles') || 0;
          let totalVehicles = dashboardData?.vehicleCount || 0;
          let unassigned = Math.max(0, totalVehicles - assigned);

          // Calculate active vs inactive drivers for comparison
          let totalDrivers = dashboardData?.driverCount || 0;
          let activeDrivers = branches.reduce((sum, b) => sum + (get(b, 'activeDrivers') || 0), 0);
          let inactiveDrivers = Math.max(0, totalDrivers - activeDrivers);

          // Calculate maintenance vehicles
          let maintenanceVehicles = branches.reduce((sum, b) => sum + (get(b, 'openMaintenanceTickets') || 0), 0);

          const labels = [];
          const data = [];
          const colors = [];

          if (assigned > 0) {
            labels.push(`Assigned Vehicles`);
            data.push(assigned);
            colors.push('#28a745');
          }

          if (unassigned > 0) {
            labels.push(`Unassigned Vehicles`);
            data.push(unassigned);
            colors.push('#6c757d');
          }

          if (maintenanceVehicles > 0) {
            labels.push(`Under Maintenance`);
            data.push(maintenanceVehicles);
            colors.push('#ffc107');
          }

          if (activeDrivers > 0) {
            labels.push(`Active Drivers`);
            data.push(activeDrivers);
            colors.push('#17a2b8');
          }

          if (inactiveDrivers > 0) {
            labels.push(`Inactive Drivers`);
            data.push(inactiveDrivers);
            colors.push('#dc3545');
          }

          if (data.length === 0) {
            labels.push('No Data Available');
            data.push(1);
            colors.push('#e9ecef');
          }

          const ctx = document.getElementById('statusChart')?.getContext('2d');
          if (!ctx) { showError('status'); return; }

          if (charts.status) charts.status.destroy();

          charts.status = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels,
              datasets: [{
                data,
                backgroundColor: colors,
                borderWidth: 2,
                borderColor: '#fff'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    padding: 10,
                    usePointStyle: true,
                    generateLabels: function(chart) {
                      const data = chart.data;
                      if (data.labels.length && data.datasets.length) {
                        return data.labels.map((label, i) => {
                          const dataset = data.datasets[0];
                          const value = dataset.data[i];
                          return {
                            text: `${label}: ${value}`,
                            fillStyle: dataset.backgroundColor[i],
                            strokeStyle: dataset.backgroundColor[i],
                            lineWidth: 0,
                            pointStyle: 'circle',
                            hidden: false,
                            index: i
                          };
                        });
                      }
                      return [];
                    }
                  }
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      const label = context.label || '';
                      const value = context.parsed;
                      const total = context.dataset.data.reduce((a, b) => a + b, 0);
                      const percentage = ((value / total) * 100).toFixed(1);
                      return `${label}: ${value} (${percentage}%)`;
                    }
                  }
                }
              }
            }
          });

          hideLoading('status');
        } catch (err) {
          console.error('Status chart error:', err);
          showError('status');
        }
      }

      // Performance Chart with proper data handling
      async function loadPerformanceChart(branchId) {
        showLoading('performance');
        try {
          const url = `/Company/Dashboard/ExpensesByMonth?branchId=${encodeURIComponent(branchId || '')}`;
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Server returned ${response.status}`);

          const result = await response.json();
          if (!result.success) throw new Error(result.error || 'Failed to load data');

          const expenses = result.data || [];
          const labels = expenses.map(m => {
            const year = get(m, 'year') || get(m, 'Year') || new Date().getFullYear();
            const month = get(m, 'month') || get(m, 'Month') || 1;
            const monthNames = ['', 'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return `${monthNames[month]} ${year}`;
          });
          const values = expenses.map(m => get(m, 'value') || get(m, 'Value') || 0);
          const secondaryValues = expenses.map(m => get(m, 'secondaryValue') || get(m, 'SecondaryValue') || 0);

          const ctx = document.getElementById('performanceChart')?.getContext('2d');
          if (!ctx) throw new Error('Chart canvas not found');

          if (charts.performance) charts.performance.destroy();

          charts.performance = new Chart(ctx, {
            type: 'line',
            data: {
              labels: labels.length ? labels : ['No Data'],
              datasets: [{
                label: 'Total Expenses (₦)',
                data: values.length ? values : [0],
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                fill: true,
                tension: 0.3
              }, {
                label: 'Fuel Expenses (₦)',
                data: secondaryValues.length ? secondaryValues : [0],
                borderColor: 'rgba(255, 99, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                fill: false,
                tension: 0.3
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { callback: (v) => formatCurrency(v) }
                }
              },
              plugins: {
                tooltip: {
                  callbacks: {
                    label: (context) => `${context.dataset.label}: ${formatCurrency(context.parsed.y)}`
                  }
                }
              }
            }
          });

          hideLoading('performance');
        } catch (err) {
          console.error('Error loading performance chart:', err);
          showError('performance');
        }
      }

      // Enhanced Apply DTO to UI with proper financial calculations
      function applyDtoToUi(dto) {
        if (!dto) return;

        currentDashboardData = dto;
        const totals = dto.totals || {};
        const branches = dto.branches || [];

        // Update counters
        document.getElementById('branchCount').textContent = dto.branchCount ?? 0;
        document.getElementById('adminCount').textContent = dto.adminCount ?? 0;
        document.getElementById('vehicleCount').textContent = dto.vehicleCount ?? 0;
        document.getElementById('driverCount').textContent = dto.driverCount ?? 0;

        // Update header counters
        document.getElementById('headerBranchCount').textContent = dto.branchCount ?? 0;
        document.getElementById('headerVehicleCount').textContent = dto.vehicleCount ?? 0;
        document.getElementById('headerAssignedVehicles').textContent = totals.assignedVehicles ?? 0;

        // Update visible branches count
        document.getElementById('visibleBranches').textContent = branches.length;
        document.getElementById('assignedVehiclesCount').textContent = totals.assignedVehicles ?? 0;

        // Update viewing scope
        const viewingScope = document.getElementById('viewingScope');
        const performanceViewIndicator = document.getElementById('performanceViewIndicator');
        if (dto.isFiltered) {
          viewingScope.textContent = "Single Branch View";
          performanceViewIndicator.innerHTML = '<span>(Filtered View)</span>';
        } else {
          viewingScope.textContent = "All Branches";
          performanceViewIndicator.innerHTML = '';
        }

        // Calculate and update financial metrics with proper percentages
        const totalSpend = totals.totalSpend || 0;
        const fuelSpend = totals.fuelSpend || 0;
        const maintenanceSpend = totals.maintenanceSpend || 0;
        const finesSpend = totals.finesSpend || 0;

        document.getElementById('monthlyExpenditure').textContent = formatCurrency(totalSpend);
        document.getElementById('monthlyExpenses').textContent = formatCurrency(fuelSpend);
        document.getElementById('monthlyRecurrent').textContent = formatCurrency(maintenanceSpend);

        // Update breakdown in total spend card
        document.getElementById('fuelSpendBreakdown').textContent = formatCurrency(fuelSpend);
        document.getElementById('maintenanceSpendBreakdown').textContent = formatCurrency(maintenanceSpend);
        document.getElementById('finesSpendBreakdown').textContent = formatCurrency(finesSpend);

        // Calculate and update percentages
        const fuelPercent = totalSpend > 0 ? Math.round((fuelSpend / totalSpend) * 100 * 10) / 10 : 0;
        const maintenancePercent = totalSpend > 0 ? Math.round((maintenanceSpend / totalSpend) * 100 * 10) / 10 : 0;

        document.getElementById('fuelPercentage').textContent = fuelPercent + '%';
        document.getElementById('maintenancePercentage').textContent = maintenancePercent + '%';

        // Update branch performance list
        updateBranchPerformanceList(branches);

        // Update branch summary table
        updateBranchSummaryTable(branches);

        // Update alerts
        const alerts = generateAlerts(dto);
    updateNotificationIndicator(alerts);
      }

