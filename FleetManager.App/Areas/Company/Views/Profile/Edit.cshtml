@using FleetManager.Business.ViewModels
@model EditCompanyViewModel

<div class="content">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row">
            <div class="col-sm-12">
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Profile </a></li>
                    <li class="breadcrumb-item"><i class="feather-chevron-right"></i></li>
                    <li class="breadcrumb-item active">Edit Profile</li>
                </ul>
            </div>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div class="card-box">
            <h3 class="card-title">Basic Informations</h3>
            <div class="row">
                <div class="col-md-12">
                    <div class="profile-img-wrap">
                        <img id="logoPreview" class="inline-block"
                             src="@(string.IsNullOrWhiteSpace(Model.LogoUrl)
                                                              ? Url.Content("~/images/company_avatar.png")
                                                              : (Model.LogoUrl.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)
                                                                  ? Model.LogoUrl
                                                                  : Url.Content(Model.LogoUrl)))"
                             alt="Company Logo"
                             style="max-width:160px; max-height:160px; object-fit:contain;" />

                        <div class="fileupload btn">
                            <span class="btn-text">edit</span>
                            <input class="upload" type="file" name="LogoFile" accept=".jpg,.jpeg,.png,.gif,.svg" />
                        </div>
                    </div>

                    <!-- hidden field to persist existing logo between postbacks -->
                    <input type="hidden" name="ExistingLogoUrl" value="@(Model.LogoUrl ?? string.Empty)" />

                    <div class="profile-basic">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-block local-forms">
                                    <label asp-for="Name" class="focus-label"></label>
                                    <input asp-for="Name" class="form-control floating" disabled />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-block local-forms">
                                    <label asp-for="RegistrationNumber" class="focus-label">Company's Registration Number</label>
                                    <input asp-for="RegistrationNumber" class="form-control floating" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-block local-forms">
                                    <label asp-for="DateOfIncorporation" class="focus-label">Date of Incorporation</label>
                                    <div class="cal-icon">
                                        <input asp-for="DateOfIncorporation" class="form-control flatpickr floating" placeholder="Select Date" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-block local-forms">
                                    <label asp-for="StateId" class="focus-label">State</label>
                                    <select asp-for="StateId" asp-items="ViewBag.States" class="form-control select select2-hidden-accessible">
                                        <option value="">-- Select State --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-box">
            <h3 class="card-title">Contact Informations</h3>
            <div class="row">
                <div class="col-md-12">
                    <div class="input-block local-forms">
                        <label asp-for="Address" class="focus-label">Address</label>
                        <input asp-for="Address" class="form-control floating" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="PhoneNumber" class="focus-label">Company's Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control floating" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="Email" class="focus-label">Company's' Email</label>
                        <input asp-for="Email" class="form-control floating" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="ContactPersonName" class="focus-label">Contact Person's Name</label>
                        <input asp-for="ContactPersonName" class="form-control floating" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="ContactPersonPhone" class="focus-label">Contact Person's Phone</label>
                        <input asp-for="ContactPersonPhone" class="form-control floating" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="ContactPersonEmail" class="focus-label">Contact Person's Email</label>
                        <input asp-for="ContactPersonEmail" class="form-control floating" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label asp-for="Website" class="focus-label"></label>
                        <input asp-for="Website" class="form-control floating" />
                    </div>
                </div>

                <!-- External logo URL input -->
                <div class="col-md-12 mt-3">
                    <div class="input-block local-forms">
                        <label class="focus-label">Or paste a logo URL</label>
                        <input type="url"
                               name="LogoUrlInput"
                               value="@(Model.LogoUrl != null && Model.LogoUrl.StartsWith("http", System.StringComparison.OrdinalIgnoreCase) ? Model.LogoUrl : string.Empty)"
                               class="form-control floating"
                               placeholder="https://example.com/logo.png" />
                        <small class="form-text text-muted">If you paste a URL it will be used instead of uploading a file.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Education/Experience blocks retained visually -->
        <div class="card-box">
            <h3 class="card-title">Education Informations</h3>
            <div class="row">
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label class="focus-label">Institution</label>
                        <input type="text" class="form-control floating" placeholder="Oxford University" />
                    </div>
                </div>
                <!-- Other education fields... -->
            </div>
        </div>

        <div class="card-box">
            <h3 class="card-title">Experience Informations</h3>
            <div class="row">
                <div class="col-md-6">
                    <div class="input-block local-forms">
                        <label class="focus-label">Company Name</label>
                        <input type="text" class="form-control floating" placeholder="Digital Devlopment Inc" />
                    </div>
                </div>
                <!-- Other experience fields... -->
            </div>
        </div>

        <div class="text-center">
            <button class="btn btn-primary submit-btn mb-4" type="submit">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        flatpickr(".flatpickr", {
            dateFormat: "Y-m-d",
            allowInput: true
        });

        (function () {
            const fileInput = document.querySelector('input[type="file"][name="LogoFile"]');
            const urlInput = document.querySelector('input[type="url"][name="LogoUrlInput"]');
            const preview = document.getElementById('logoPreview');

            if (fileInput) {
                fileInput.addEventListener('change', function (ev) {
                    const f = ev.target.files && ev.target.files[0];
                    if (!f) return;
                    const objectUrl = URL.createObjectURL(f);
                    preview.src = objectUrl;
                    // clear url input because file will take precedence
                    if (urlInput) urlInput.value = '';
                });
            }

            if (urlInput) {
                urlInput.addEventListener('input', function () {
                    const v = urlInput.value.trim();
                    if (!v) return;
                    // set preview to the typed URL and clear file input so server picks URL
                    preview.src = v;
                    if (fileInput) fileInput.value = '';
                });
            }
        })();
    </script>
}

























