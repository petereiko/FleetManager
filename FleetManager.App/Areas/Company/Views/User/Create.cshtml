@using FleetManager.Business.ViewModels
@model CompanyRegistrationViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Registration - FleetManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1e40af;
            --primary-light: #3b82f6;
            --secondary-color: #f1f5f9;
            --accent-color: #8b5cf6;
            --success-color: #059669;
            --danger-color: #dc2626;
            --warning-color: #d97706;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --border-color: #e2e8f0;
            --text-muted: #64748b;
            --glass-bg: rgba(255, 255, 255, 0.95);
            --shadow-soft: 0 2px 10px rgba(0, 0, 0, 0.08);
            --shadow-medium: 0 4px 15px rgba(0, 0, 0, 0.12);
            --shadow-strong: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: ghostwhite);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            position: relative;
        }

            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%23667eea;stop-opacity:0.3" /><stop offset="100%" style="stop-color:%23764ba2;stop-opacity:0.2" /></linearGradient></defs><circle cx="20" cy="20" r="1.5" fill="url(%23grad1)"/><circle cx="80" cy="40" r="1" fill="url(%23grad1)"/><circle cx="40" cy="80" r="1.2" fill="url(%23grad1)"/></svg>');
                pointer-events: none;
                z-index: 1;
            }

        .main-container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 750px;
        }

        .registration-card {
            background: var(--glass-bg);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-strong);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            position: relative;
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            padding: 25px 30px 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .card-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
                animation: rotate 20s linear infinite;
            }

        @@keyframes rotate {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        .brand-logo {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.2);
            position: relative;
            z-index: 2;
        }

            .brand-logo i {
                font-size: 1.5rem;
                color: white;
                filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
            }

        .card-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: white;
            margin-bottom: 8px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            position: relative;
            z-index: 2;
        }

        .card-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 400;
            position: relative;
            z-index: 2;
        }

        .card-body {
            padding: 25px 30px 30px;
            background: white;
        }

        .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--dark-color);
            margin-bottom: 20px;
            text-align: center;
            position: relative;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: -8px;
                left: 50%;
                transform: translateX(-50%);
                width: 40px;
                height: 2px;
                background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
                border-radius: 2px;
            }

        .form-group {
            margin-bottom: 18px;
            position: relative;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 6px;
            font-size: 0.9rem;
            letter-spacing: 0.3px;
        }

        .form-control {
            width: 100%;
            height: 45px;
            padding: 12px 45px 12px 16px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 500;
            background: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            color: var(--dark-color);
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        }

            .form-control:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1), 0 2px 8px rgba(0, 0, 0, 0.08);
                transform: translateY(-1px);
            }

            .form-control.is-valid {
                border-color: var(--success-color);
                background: rgba(5, 150, 105, 0.02);
            }

            .form-control.is-invalid {
                border-color: var(--danger-color);
                background: rgba(220, 38, 38, 0.02);
            }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            transition: all 0.3s ease;
            pointer-events: none;
            margin-top: 15px;
        }

        .form-group:has(.form-control:focus) .input-icon {
            color: var(--primary-color);
            transform: translateY(-50%) scale(1.05);
        }

        .form-group:has(.form-control.is-valid) .input-icon {
            color: var(--success-color);
        }

        .form-group:has(.form-control.is-invalid) .input-icon {
            color: var(--danger-color);
        }

        .validation-message {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--danger-color);
        }

            .validation-message i {
                font-size: 0.7rem;
            }

        .agreement-section {
            background: rgba(37, 99, 235, 0.03);
            border: 2px solid rgba(37, 99, 235, 0.1);
            border-radius: 12px;
            padding: 18px;
            margin: 20px 0 15px;
            position: relative;
            transition: all 0.3s ease;
        }

            .agreement-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(135deg, rgba(37, 99, 235, 0.02) 0%, rgba(139, 92, 246, 0.02) 100%);
                border-radius: 10px;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .agreement-section:has(.form-check-input:checked)::before {
                opacity: 1;
            }

            .agreement-section:has(.form-check-input:checked) {
                border-color: var(--primary-color);
                background: rgba(37, 99, 235, 0.05);
                box-shadow: 0 2px 12px rgba(37, 99, 235, 0.1);
            }

        .form-check {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .form-check-input {
            width: 20px;
            height: 20px;
            margin: 0;
            border: 2px solid var(--border-color);
            border-radius: 6px;
            background: white;
            transition: all 0.3s ease;
            cursor: pointer;
            flex-shrink: 0;
            margin-top: 1px;
        }

            .form-check-input:checked {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            }

                .form-check-input:checked::after {
                    content: '\f00c';
                    font-family: 'Font Awesome 6 Free';
                    font-weight: 900;
                    color: white;
                    font-size: 10px;
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                }

        .form-check-label {
            font-weight: 500;
            color: var(--dark-color);
            line-height: 1.5;
            cursor: pointer;
            user-select: none;
            font-size: 0.9rem;
        }

            .form-check-label a {
                color: var(--primary-color);
                text-decoration: none;
                font-weight: 600;
                transition: color 0.2s ease;
            }

                .form-check-label a:hover {
                    color: var(--primary-dark);
                    text-decoration: underline;
                }

        .submit-btn {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-medium);
            margin-top: 15px;
        }

            .submit-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .submit-btn:hover::before {
                left: 100%;
            }

            .submit-btn:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 12px 25px rgba(37, 99, 235, 0.3);
            }

            .submit-btn:active:not(:disabled) {
                transform: translateY(0px);
            }

            .submit-btn:disabled {
                background: linear-gradient(135deg, #94a3b8 0%, #cbd5e1 100%);
                cursor: not-allowed;
                transform: none;
                box-shadow: var(--shadow-soft);
            }

        .btn-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: opacity 0.3s ease;
        }

        .btn-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .submit-btn.loading .btn-content {
            opacity: 0;
        }

        .submit-btn.loading .btn-spinner {
            opacity: 1;
        }

        .alert {
            border: none;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-soft);
            border-left: 4px solid var(--danger-color);
            font-size: 0.9rem;
        }

        .alert-danger {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            color: var(--danger-color);
        }

        .floating-elements {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
        }

        .floating-element {
            position: absolute;
            width: 4px;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: float 15s infinite linear;
        }

            .floating-element:nth-child(1) {
                left: 10%;
                animation-delay: -5s;
            }

            .floating-element:nth-child(2) {
                left: 20%;
                animation-delay: -10s;
                animation-duration: 12s;
            }

            .floating-element:nth-child(3) {
                left: 30%;
                animation-delay: -2s;
                animation-duration: 18s;
            }

            .floating-element:nth-child(4) {
                left: 40%;
                animation-delay: -8s;
            }

            .floating-element:nth-child(5) {
                left: 50%;
                animation-delay: -15s;
                animation-duration: 14s;
            }

            .floating-element:nth-child(6) {
                left: 60%;
                animation-delay: -4s;
            }

        @@keyframes float {
            0%

        {
            opacity: 0;
            transform: translateY(100vh) rotate(0deg);
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            transform: translateY(-10vh) rotate(360deg);
        }

        }

        @@media (max-width: 768px) {
            .card-header

        {
            padding: 20px 25px 15px;
        }

        .card-title {
            font-size: 1.6rem;
        }

        .card-subtitle {
            font-size: 0.9rem;
        }

        .card-body {
            padding: 20px 25px 25px;
        }

        .brand-logo {
            width: 45px;
            height: 45px;
        }

            .brand-logo i {
                font-size: 1.3rem;
            }

        .main-container {
            max-width: 500px;
        }

        }

        .fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }
    </style>
</head>
<body>
    <div class="floating-elements">
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
    </div>

    <div class="main-container fade-in-up">
        <div class="registration-card">
            <div class="card-header">
                <div class="brand-logo">
                    <i class="fas fa-truck-moving"></i>
                </div>
                <h1 class="card-title">FleetManager</h1>
                <p class="card-subtitle">Register your company and take control of your fleet operations</p>
            </div>

            <div class="card-body">
                <h2 class="section-title">Company Information</h2>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                <form asp-action="Create" id="registrationForm" novalidate>
                    <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="FirstName">First Name</label>
                            <input type="text" class="form-control" asp-for="FirstName" placeholder="Enter your first name" required autocomplete="firstname" />
                            <i class="fas fa-user input-icon"></i>
                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "validation-message" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="LastName">Last Name</label>
                            <input type="text" class="form-control" asp-for="LastName" placeholder="Enter your last name" required autocomplete="lastname" />
                            <i class="fas fa-user input-icon"></i>
                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "validation-message" })
                        </div>
                    </div>
            </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Name">Company Name</label>
                                <input type="text" class="form-control" asp-for="Name" placeholder="Enter your company name" required autocomplete="organization" />
                                <i class="fas fa-building input-icon"></i>
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "validation-message" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Email">Email Address</label>
                                <input type="email" class="form-control" asp-for="Email" placeholder="company@example.com" required autocomplete="email" />
                                <i class="fas fa-envelope input-icon"></i>
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "validation-message" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="PhoneNumber">Phone Number</label>
                                <input type="tel" class="form-control" asp-for="PhoneNumber" placeholder="(555) 123-4567" required autocomplete="tel" />
                                <i class="fas fa-phone input-icon"></i>
                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "validation-message" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Address">Business Address</label>
                                <input asp-for="Address" class="form-control" placeholder="Enter your complete business address" required autocomplete="address-line1">
                                <i class="fas fa-map-marker-alt input-icon"></i>
                                @Html.ValidationMessageFor(model => model.Address, "", new { @class = "validation-message" })
                            </div>
                        </div>
                    </div>

                    <div class="agreement-section">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="HasAgreed" id="HasAgreed" required>
                            <label class="form-check-label" asp-for="HasAgreed">
                                I acknowledge that I have read, understood, and agree to be bound by the
                                <a href="#" target="_blank">Terms of Service</a> and
                                <a href="#" target="_blank">Privacy Policy</a>. I consent to the processing
                                of my company's information as described in these documents.
                            </label>
                        </div>
                        @Html.ValidationMessageFor(model => model.HasAgreed, "", new { @class = "validation-message" })
                    </div>

                    <button class="submit-btn" id="btn-submit" disabled type="submit">
                        <div class="btn-content">
                            <i class="fas fa-rocket"></i>
                            <span>Create Company Account</span>
                        </div>
                        <div class="btn-spinner">
                            <i class="fas fa-spinner fa-spin"></i>
                        </div>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registrationForm');
            const submitBtn = document.getElementById('btn-submit');
            const agreeCheckbox = document.getElementById('HasAgreed');
            const formInputs = form.querySelectorAll('.form-control');

            // Checkbox validation
            agreeCheckbox.addEventListener('change', function(e) {
                updateSubmitButtonState();
            });

            // Real-time input validation
            formInputs.forEach(input => {
                input.addEventListener('input', function() {
                    validateInput(this);
                    updateSubmitButtonState();
                });

                input.addEventListener('blur', function() {
                    validateInput(this);
                });

                input.addEventListener('focus', function() {
                    this.classList.remove('is-invalid');
                });
            });

            function validateInput(input) {
                const value = input.value.trim();
                const isValid = input.checkValidity() && value.length > 0;

                input.classList.remove('is-valid', 'is-invalid');

                if (value.length > 0) {
                    if (isValid) {
                        input.classList.add('is-valid');
                    } else {
                        input.classList.add('is-invalid');
                    }
                }
            }

            function updateSubmitButtonState() {
                const isFormValid = Array.from(formInputs).every(input => {
                    return input.value.trim().length > 0 && input.checkValidity();
                });
                const isAgreed = agreeCheckbox.checked;

                submitBtn.disabled = !(isFormValid && isAgreed);
            }

            // Enhanced form submission
            form.addEventListener('submit', function(e) {
                if (!form.checkValidity() || !agreeCheckbox.checked) {
                    e.preventDefault();

                    // Highlight invalid fields
                    formInputs.forEach(input => {
                        if (!input.checkValidity() || input.value.trim().length === 0) {
                            input.classList.add('is-invalid');
                        }
                    });

                    // Scroll to first invalid field
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstInvalid.focus();
                    }

                    return;
                }

                // Show loading state
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
            });

            // Phone number formatting
            const phoneInput = document.querySelector('input[type="tel"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length >= 6) {
                        value = value.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
                    } else if (value.length >= 3) {
                        value = value.replace(/(\d{3})(\d{0,3})/, '($1) $2');
                    }
                    e.target.value = value;
                });
            }

            // Add subtle hover effects to form fields
            formInputs.forEach(input => {
                input.addEventListener('mouseenter', function() {
                    if (!this.matches(':focus')) {
                        this.style.transform = 'translateY(-1px)';
                    }
                });

                input.addEventListener('mouseleave', function() {
                    if (!this.matches(':focus')) {
                        this.style.transform = 'translateY(0)';
                    }
                });
            });
        });
    </script>
</body>
</html>





















