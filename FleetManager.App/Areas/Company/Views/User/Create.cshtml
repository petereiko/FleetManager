@using FleetManager.Business.ViewModels
@model CompanyRegistrationViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png">
    <title>Create Company Account — Fleetalia</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">


    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #1B2856;
            --navy-deep: #0e1730;
            --navy-mid: #223068;
            --green: #00664c;
            --green-light: #00875f;
            --green-pale: #6ee7b7;
            --white: #ffffff;
            --surface: #f7f8fa;
            --border: #e2e4e8;
            --dark: #1a1c20;
            --dark-60: rgba(26,28,32,0.60);
            --dark-35: rgba(26,28,32,0.35);
            --danger: #c0392b;
            --danger-bg: #fdf2f2;
            --success: #00664c;
            --success-bg: #f0f9f5;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
            background: var(--surface);
        }

        /* ROOT */
        .reg-root {
            display: flex;
            min-height: 100vh;
        }

        /* LEFT PANEL */
        .reg-panel-left {
            flex: 0 0 44%;
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--navy-deep);
        }

        .rpl-photo {
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1200&q=80&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            opacity: 0.14;
        }

        .rpl-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 150deg, rgba(14,23,48,0.98) 0%, rgba(27,40,86,0.94) 50%, rgba(0,70,52,0.82) 100% );
        }

        .rpl-dots {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        .rpl-ring {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .rpl-ring-a {
            width: 480px;
            height: 480px;
            top: -160px;
            right: -140px;
            border: 1px solid rgba(0,135,95,0.10);
            animation: ring-spin 32s linear infinite;
        }

        .rpl-ring-b {
            width: 300px;
            height: 300px;
            bottom: -80px;
            left: -90px;
            border: 1px solid rgba(255,255,255,0.04);
            animation: ring-spin 22s linear infinite reverse;
        }

        @@keyframes ring-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .rpl-body {
            position: relative;
            z-index: 3;
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 40px 48px;
        }

        .rpl-logo img {
            height: 42px;
            width: auto;
            display: block;
            animation: logo-glow 3.5s ease-in-out infinite alternate;
        }

        @@keyframes logo-glow {
            from {
                filter: brightness(1.0) drop-shadow(0 2px 8px rgba(0,135,95,0.18));
            }

            to {
                filter: brightness(1.12) drop-shadow(0 4px 20px rgba(0,135,95,0.48));
            }
        }

        .rpl-hero {
            margin-top: auto;
        }

        .rpl-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(0,102,76,0.16);
            border: 1px solid rgba(0,135,95,0.28);
            border-radius: 99px;
            padding: 5px 13px;
            font-size: 10px;
            font-weight: 700;
            color: var(--green-pale);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

            .rpl-tag i {
                font-size: 9px;
            }

        .rpl-headline {
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 2.6rem;
            font-weight: 400;
            line-height: 1.2;
            color: #fff;
            margin-bottom: 16px;
            letter-spacing: -0.015em;
        }

            .rpl-headline em {
                font-style: italic;
                color: var(--green-pale);
            }

        .rpl-sub {
            font-size: 14px;
            color: rgba(255,255,255,0.52);
            line-height: 1.65;
            max-width: 400px;
            margin-bottom: 28px;
        }

        .rpl-steps {
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding: 22px 0;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .rpl-step {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .rpl-step-num {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(0,102,76,0.16);
            border: 1px solid rgba(0,135,95,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: var(--green-pale);
            flex-shrink: 0;
            font-family: 'DM Mono', monospace;
        }

        .rpl-step-text strong {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
            margin-bottom: 2px;
        }

        .rpl-step-text span {
            font-size: 11.5px;
            color: rgba(255,255,255,0.4);
            line-height: 1.4;
        }

        /* RIGHT PANEL */
        .reg-panel-right {
            flex: 0 0 56%;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-y: auto;
            position: relative;
        }

            .reg-panel-right::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle at top right, rgba(27,40,86,0.03), transparent 70%);
                pointer-events: none;
            }

        .reg-form-box {
            width: 100%;
            max-width: 540px;
            padding: 40px 28px;
        }

        /* FORM STYLES */
        .rf-logo {
            text-align: center;
            margin-bottom: 26px;
        }

            .rf-logo img {
                height: 38px;
                width: auto;
                display: inline-block;
            }

        .rf-welcome {
            text-align: center;
            margin-bottom: 28px;
        }

            .rf-welcome h1 {
                font-size: 24px;
                font-weight: 800;
                color: var(--navy);
                letter-spacing: -0.025em;
                margin: 0 0 7px;
            }

            .rf-welcome p {
                font-size: 13.5px;
                color: var(--dark-60);
                line-height: 1.5;
            }

        .rf-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .rf-divider-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .rf-divider-text {
            font-size: 11px;
            color: var(--dark-35);
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        /* Error alert */
        .rf-errors {
            background: var(--danger-bg);
            border: 1px solid #f5c6c3;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13px;
            color: var(--danger);
            margin-bottom: 18px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

            .rf-errors i {
                font-size: 14px;
                flex-shrink: 0;
                margin-top: 1px;
            }

            .rf-errors ul {
                margin: 0;
                padding-left: 18px;
            }

        /* Form row */
        .rf-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .rf-field {
            margin-bottom: 16px;
        }

            .rf-field label {
                display: block;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 6px;
                letter-spacing: -0.01em;
            }

            .rf-field .req {
                color: var(--danger);
                margin-left: 2px;
            }

        .rf-field-wrap {
            position: relative;
        }

        .rf-field-ico {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: rgba(26,28,32,0.28);
            pointer-events: none;
        }

        .rf-field input,
        .rf-field textarea {
            width: 100%;
            height: 46px;
            padding: 0 14px 0 40px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            color: var(--dark);
            background: #f9f9fb;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }

        .rf-field textarea {
            height: 60px;
            padding-top: 12px;
            padding-bottom: 12px;
            resize: none;
        }

            .rf-field input:focus,
            .rf-field textarea:focus {
                border-color: var(--green);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(0,102,76,0.12);
            }

            .rf-field input.is-valid,
            .rf-field textarea.is-valid {
                border-color: var(--success);
                background: var(--success-bg);
            }

            .rf-field input.is-invalid,
            .rf-field textarea.is-invalid {
                border-color: var(--danger);
                background: var(--danger-bg);
            }

            .rf-field input::placeholder,
            .rf-field textarea::placeholder {
                color: rgba(26,28,32,0.28);
            }

        .rf-field .text-danger {
            font-size: 11.5px;
            color: var(--danger);
            margin-top: 4px;
            display: block;
        }

        /* Agreement box */
        .rf-agreement {
            background: rgba(27,40,86,0.03);
            border: 1.5px solid rgba(27,40,86,0.1);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 20px;
            transition: all 0.2s ease;
        }

            .rf-agreement:has(input:checked) {
                border-color: var(--green);
                background: rgba(0,102,76,0.04);
                box-shadow: 0 0 0 3px rgba(0,102,76,0.08);
            }

        .rf-check {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

            .rf-check input[type="checkbox"] {
                width: 18px;
                height: 18px;
                accent-color: var(--green);
                cursor: pointer;
                border-radius: 4px;
                flex-shrink: 0;
                margin-top: 2px;
            }

            .rf-check label {
                font-size: 12.5px;
                color: var(--dark-60);
                line-height: 1.55;
                cursor: pointer;
                user-select: none;
            }

                .rf-check label a {
                    color: var(--green);
                    font-weight: 600;
                    text-decoration: none;
                }

                    .rf-check label a:hover {
                        color: var(--green-light);
                        text-decoration: underline;
                    }

        /* Submit button */
        .rf-btn {
            width: 100%;
            height: 50px;
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: -0.01em;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 16px rgba(27,40,86,0.22);
            position: relative;
            overflow: hidden;
        }

            .rf-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
                transition: left 0.5s;
            }

            .rf-btn:hover:not(:disabled)::before {
                left: 100%;
            }

            .rf-btn:hover:not(:disabled) {
                background: var(--navy-mid);
                transform: translateY(-1px);
                box-shadow: 0 6px 22px rgba(27,40,86,0.3);
            }

            .rf-btn:active:not(:disabled) {
                transform: translateY(0);
            }

            .rf-btn:disabled {
                background: #94a3b8;
                cursor: not-allowed;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            }

            .rf-btn.loading .btn-content {
                opacity: 0.4;
            }

        .rf-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .rf-btn.loading .rf-spinner {
            opacity: 1;
        }

        /* Sign in link */
        .rf-signin {
            text-align: center;
            font-size: 13px;
            color: var(--dark-60);
            margin-top: 20px;
        }

            .rf-signin a {
                font-weight: 700;
                color: var(--green);
                text-decoration: none;
            }

                .rf-signin a:hover {
                    color: var(--green-light);
                }

        /* RESPONSIVE */
        @@media (max-width: 960px) {
            .reg-root {
                flex-direction: column;
            }

            .reg-panel-left {
                flex: 0 0 auto;
                min-height: 280px;
            }

            .reg-panel-right {
                flex: 1;
                padding: 20px;
            }

            .rpl-body {
                padding: 28px 28px 32px;
            }

            .rpl-steps {
                display: none;
            }

            .rpl-headline {
                font-size: 2rem;
            }

            .reg-form-box {
                padding: 32px 20px;
            }
        }

        @@media (max-width: 768px) {
            .rf-row {
                grid-template-columns: 1fr;
                gap: 16px;
            }
        }
    </style>
</head>

<body>

    <div class="reg-root">

        <!-- LEFT PANEL -->
        <div class="reg-panel-left">
            <div class="rpl-photo"></div>
            <div class="rpl-overlay"></div>
            <div class="rpl-dots"></div>
            <div class="rpl-ring rpl-ring-a"></div>
            <div class="rpl-ring rpl-ring-b"></div>

            <div class="rpl-body">

                <div class="rpl-logo">
                    <img src="~/assets/img/FULL-WHITE-AND-GREEN-LOGO.png" alt="Fleetalia">
                </div>

                <div class="rpl-hero">

                    <div class="rpl-tag">
                        <i class="fa-solid fa-rocket"></i>
                        Get started in minutes
                    </div>

                    <h2 class="rpl-headline">
                        Start managing <em>your fleet</em> today.
                    </h2>

                    <p class="rpl-sub">
                        Join 150+ companies using Fleetalia to streamline fleet operations,
                        reduce costs, and gain real-time visibility across their entire vehicle network.
                    </p>

                    <div class="rpl-steps">
                        <div class="rpl-step">
                            <div class="rpl-step-num">1</div>
                            <div class="rpl-step-text">
                                <strong>Create your company account</strong>
                                <span>Set up in under 3 minutes, no credit/debit card required</span>
                            </div>
                        </div>
                        <div class="rpl-step">
                            <div class="rpl-step-num">2</div>
                            <div class="rpl-step-text">
                                <strong>Add your vehicles & drivers</strong>
                                <span>Enter Vehicles manually </span>
                            </div>
                        </div>
                        <div class="rpl-step">
                            <div class="rpl-step-num">3</div>
                            <div class="rpl-step-text">
                                <strong>Start tracking & managing</strong>
                                <span>Real-time GPS, fuel logs, maintenance schedules & more</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="reg-panel-right">
            <div class="reg-form-box">

                <div class="rf-logo">
                    <img src="~/assets/img/FULL-BLUE-AND-GREEN-LOGO.png" alt="Fleetalia">
                </div>

                <div class="rf-welcome">
                    <h1>Create Company Account</h1>
                    <p>Enter your company details to get started with Fleetalia</p>
                </div>

                <div class="rf-divider">
                    <span class="rf-divider-line"></span>
                    <span class="rf-divider-text">Company Registration</span>
                    <span class="rf-divider-line"></span>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                {
                    <div class="rf-errors">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <div>
                            @Html.ValidationSummary(false, "", new { @class = "" })
                        </div>
                    </div>
                }

                <form asp-action="Create" id="regForm" novalidate>

                    <!-- First name + Last name -->
                    <div class="rf-row">
                        <div class="rf-field">
                            <label asp-for="FirstName">First Name <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-user rf-field-ico"></i>
                                <input asp-for="FirstName" type="text" placeholder="Your first name" required autocomplete="given-name">
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="rf-field">
                            <label asp-for="LastName">Last Name <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-user rf-field-ico"></i>
                                <input asp-for="LastName" type="text" placeholder="Your last name" required autocomplete="family-name">
                            </div>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Company name + Email -->
                    <div class="rf-row">
                        <div class="rf-field">
                            <label asp-for="Name">Company Name <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-building rf-field-ico"></i>
                                <input asp-for="Name" type="text" placeholder="Acme Logistics Inc." required autocomplete="organization">
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="rf-field">
                            <label asp-for="Email">Email Address <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-envelope rf-field-ico"></i>
                                <input asp-for="Email" type="email" placeholder="admin@company.com" required autocomplete="email">
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Phone + Address -->
                    <div class="rf-row">
                        <div class="rf-field">
                            <label asp-for="PhoneNumber">Phone Number <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-phone rf-field-ico"></i>
                                <input asp-for="PhoneNumber" type="tel" placeholder="(555) 123-4567" required autocomplete="tel">
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="rf-field">
                            <label asp-for="Address">Business Address <span class="req">*</span></label>
                            <div class="rf-field-wrap">
                                <i class="fa-solid fa-map-marker-alt rf-field-ico"></i>
                                <input asp-for="Address" type="text" placeholder="123 Main St, City, State" required autocomplete="address-line1">
                            </div>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Agreement -->
                    <div class="rf-agreement">
                        <div class="rf-check">
                            <input asp-for="HasAgreed" type="checkbox" id="HasAgreed" required>
                            <label for="HasAgreed">
                                I have read and agree to the
                                <a href="#" target="_blank">Terms of Service</a> and
                                <a href="#" target="_blank">Privacy Policy</a>.
                            </label>
                        </div>
                        <span asp-validation-for="HasAgreed" class="text-danger"></span>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="rf-btn" id="submitBtn" disabled>
                        <span class="btn-content">
                            <i class="fa-solid fa-rocket"></i>
                            Create Company Account
                        </span>
                        <span class="rf-spinner">
                            <i class="fa-solid fa-spinner fa-spin"></i>
                        </span>
                    </button>

                </form>

                <p class="rf-signin">
                    Already have an account?
                    <a asp-area="" asp-controller="Account" asp-action="Login">Sign in here</a>
                </p>

            </div>
        </div>

    </div>

    <script src="~/assets/js/jquery-3.7.1.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('regForm');
            const submitBtn = document.getElementById('submitBtn');
            const agreeBox = document.getElementById('HasAgreed');
            const inputs = form.querySelectorAll('input[required]:not([type="checkbox"])');

            // Phone number auto-format
            const phoneInput = form.querySelector('input[type="tel"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function (e) {
                    let val = e.target.value.replace(/\D/g, '');
                    if (val.length >= 6) {
                        val = val.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
                    } else if (val.length >= 3) {
                        val = val.replace(/(\d{3})(\d{0,3})/, '($1) $2');
                    }
                    e.target.value = val;
                });
            }

            // Update submit button state
            function updateSubmitBtn() {
                const allValid = Array.from(inputs).every(inp => inp.value.trim().length > 0);
                const agreed = agreeBox.checked;
                submitBtn.disabled = !(allValid && agreed);
            }

            inputs.forEach(inp => {
                inp.addEventListener('input', function () {
                    validateField(this);
                    updateSubmitBtn();
                });
                inp.addEventListener('blur', function () { validateField(this); });
                inp.addEventListener('focus', function () { this.classList.remove('is-invalid'); });
            });

            agreeBox.addEventListener('change', updateSubmitBtn);

            function validateField(inp) {
                const val = inp.value.trim();
                inp.classList.remove('is-valid', 'is-invalid');
                if (val.length > 0) {
                    if (inp.checkValidity()) {
                        inp.classList.add('is-valid');
                    } else {
                        inp.classList.add('is-invalid');
                    }
                }
            }

            // Form submit
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity() || !agreeBox.checked) {
                    e.preventDefault();
                    inputs.forEach(inp => {
                        if (!inp.checkValidity() || inp.value.trim().length === 0) {
                            inp.classList.add('is-invalid');
                        }
                    });
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstInvalid.focus();
                    }
                    return;
                }

                // Show loading
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
            });
        });
    </script>

</body>
</html>
