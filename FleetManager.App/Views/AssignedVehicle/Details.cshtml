                            <i class="fas fa-calendar-times info-icon"></i>
                            <div>
                                <div class="info-label">Insurance Expiry:</div>
                                <div class="info-value">
                                    @if (Model?.InsuranceExpiryDate.HasValue == true)
                                    {
                                        @Model.InsuranceExpiryDate.Value.ToString("dd MMM yyyy")
                                        @if (Model.InsuranceExpiryDate.Value < DateTime.Now)
                                        {
                                            <small class="text-danger ms-2">
                                                <i class="fas fa-exclamation-circle"></i> Expired
                                            </small>
                                        }
                                        else if (Model.InsuranceExpiryDate.Value < DateTime.Now.AddDays(30))
                                        {
                                            <small class="text-danger ms-2">
                                                <i class="fas fa-exclamation-triangle"></i> Expires Soon
                                            </small>
                                        }
                                        else if (Model.InsuranceExpiryDate.Value < DateTime.Now.AddDays(90))
                                        {
                                            <small class="text-warning ms-2">
                                                <i class="fas fa-clock"></i> Expires in @((Model.InsuranceExpiryDate.Value - DateTime.Now).Days) days
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="info-item @(Model?.RoadWorthyExpiryDate.HasValue == true && Model.RoadWorthyExpiryDate.Value < DateTime.Now.AddDays(30) ? "expiry-danger" : Model?.RoadWorthyExpiryDate.HasValue == true && Model.RoadWorthyExpiryDate.Value < DateTime.Now.AddDays(90) ? "expiry-warning" : "")">
                            <i class="fas fa-road info-icon"></i>
                            <div>
                                <div class="info-label">Road-Worthy Expiry:</div>
                                <div class="info-value">
                                    @if (Model?.RoadWorthyExpiryDate.HasValue == true)
                                    {
                                        @Model.RoadWorthyExpiryDate.Value.ToString("dd MMM yyyy")
                                        @if (Model.RoadWorthyExpiryDate.Value < DateTime.Now)
                                        {
                                            <small class="text-danger ms-2">
                                                <i class="fas fa-exclamation-circle"></i> Expired
                                            </small>
                                        }
                                        else if (Model.RoadWorthyExpiryDate.Value < DateTime.Now.AddDays(30))
                                        {
                                            <small class="text-danger ms-2">
                                                <i class="fas fa-exclamation-triangle"></i> Expires Soon
                                            </small>
                                        }
                                        else if (Model.RoadWorthyExpiryDate.Value < DateTime.Now.AddDays(90))
                                        {
                                            <small class="text-warning ms-2">
                                                <i class="fas fa-clock"></i> Expires in @((Model.RoadWorthyExpiryDate.Value - DateTime.Now).Days) days
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Photos Section -->
            <div class="detail-section">
                <h5 class="section-header">
                    <i class="fas fa-camera me-2"></i>Vehicle Photos
                    @if (Model?.Photos != null && Model.Photos.Any())
                    {
                        <span class="badge bg-light text-dark ms-2">@Model.Photos.Count()</span>
                    }
                </h5>
                <div class="section-content">
                    @if (Model?.Photos != null && Model.Photos.Any())
                    {
                        <div class="photo-gallery">
                            @foreach (var photo in Model.Photos)
                            {
                                <div class="photo-item" onclick="viewPhoto('@Url.Content(photo.FilePath)', '@(photo.FileName ?? "Vehicle Photo")')">
                                    <img src="@Url.Content(photo.FilePath)" alt="@(photo.FileName ?? "Vehicle Photo")" loading="lazy" />
                                    <div class="photo-overlay">
                                        <div class="text-truncate">@(photo.FileName ?? "Vehicle Photo")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-camera"></i>
                            <h6>No Photos Available</h6>
                            <p class="mb-0">No photos have been uploaded for this vehicle.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Footer -->
    <div class="detail-section quick-actions-section">
        <div class="section-content">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="mb-1">Quick Actions</h6>
                    <p class="mb-0 text-muted small">Common actions for this vehicle</p>
                </div>
                <div class="col-md-4">
                    <div class="btn-group w-100" role="group">
                        <button id="showRepairHistoryBtn" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-history me-1"></i>Make a complain
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
        <div class="loading-spinner"></div>
        <h5 class="mb-2">Loading...</h5>
        <p class="mb-0 text-muted">Please wait while we fetch the repair history</p>
    </div>
</div>

<!-- Photo Viewer Modal -->
<div class="modal fade" id="photoViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: transparent; border: none;">
            <div class="modal-body p-0 text-center">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close" style="z-index: 1060;"></button>
                <img id="photoViewerImage" src="" alt="" class="img-fluid rounded" style="max-height: 80vh;" />
                <div class="mt-3 text-white">
                    <h5 id="photoViewerTitle"></h5>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetFileIcon(string fileName)
    {
        if (string.IsNullOrEmpty(fileName))
            return "alt";

        var extension = System.IO.Path.GetExtension(fileName)
                             .ToLowerInvariant();

        switch (extension)
        {
            case ".pdf":
                return "pdf";
            case ".doc":
            case ".docx":
                return "word";
            case ".xls":
            case ".xlsx":
                return "excel";
            case ".ppt":
            case ".pptx":
                return "powerpoint";
            case ".jpg":
            case ".jpeg":
            case ".png":
            case ".gif":
                return "image";
            case ".zip":
            case ".rar":
                return "archive";
            default:
                return "alt";
        }
    }

    public string GetFileExtension(string fileName)
    {
        if (string.IsNullOrEmpty(fileName))
            return "file";

        return System.IO.Path.GetExtension(fileName)
                     .TrimStart('.');
    }
}

<script>
    // Enhanced Alert System
    class AlertManager {
        static show(message, type = 'info', duration = 5000) {
            const alertId = 'alert-' + Date.now();
            const iconClass = this.getIconClass(type);

            const alertHtml = `
                <div id="${alertId}" class="custom-alert alert-${type}">
                    <div class="d-flex align-items-center p-3">
                        <div class="flex-shrink-0 me-3">
                            <i class="${iconClass}" style="font-size: 1.2rem;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold mb-1">${this.getAlertTitle(type)}</div>
                            <div>${message}</div>
                        </div>
                        <button type="button" class="btn-close ms-3" onclick="AlertManager.hide('${alertId}')" aria-label="Close"></button>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', alertHtml);

            // Auto-hide after duration
            if (duration > 0) {
                setTimeout(() => this.hide(alertId), duration);
            }

            return alertId;
        }

        static hide(alertId) {
            const alertElement = document.getElementById(alertId);
            if (alertElement) {
                alertElement.classList.add('hiding');
                setTimeout(() => {
                    if (alertElement.parentNode) {
                        alertElement.parentNode.removeChild(alertElement);
                    }
                }, 300);
            }
        }

        static getIconClass(type) {
            const icons = {
                'success': 'fas fa-check-circle',
                'error': 'fas fa-exclamation-circle',
                'warning': 'fas fa-exclamation-triangle',
                'info': 'fas fa-info-circle'
            };
            return icons[type] || icons['info'];
        }

        static getAlertTitle(type) {
            const titles = {
                'success': 'Success',
                'error': 'Error',
                'warning': 'Warning',
                'info': 'Information'
            };
            return titles[type] || titles['info'];
        }
    }

    // Loading Manager
    class LoadingManager {
        static show(message = 'Loading...') {
            const overlay = document.getElementById('loadingOverlay');
            const content = overlay.querySelector('.loading-content p');
            if (content) {
                content.textContent = message;
            }
            overlay.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Prevent scrolling
        }

        static hide() {
            const overlay = document.getElementById('loadingOverlay');
            overlay.style.display = 'none';
            document.body.style.overflow = ''; // Restore scrolling
        }
    }

    // Repair History Modal Manager
    (function () {
        const vehicleId = @System.Text.Json.JsonSerializer.Serialize(Model?.Id ?? 0);
        const modalId = 'repairHistoryModal';

        function ensureModal() {
            let el = document.getElementById(modalId);
            if (el) return el;

            const modalHtml = `
                <div class="modal fade" id="${modalId}" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">
                          <i class="fas fa-history me-2"></i>Repair History
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body p-3" id="${modalId}-body">
                        <div class="text-center py-4">
                          <div class="loading-spinner mx-auto mb-3"></div>
                          <p>Loading repair history...</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>`;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            return document.getElementById(modalId);
        }

        function buildUrlWithParams(baseUrl, params) {
            const sep = baseUrl.includes('?') ? '&' : '?';
            const qs = Object.keys(params)
                .map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k]))
                .join('&');
            return baseUrl + sep + qs;
        }

        async function loadRepairHistoryPage(page = 1, pageSize = 10) {
            try {
                // Show loading overlay
                LoadingManager.show('Loading repair history...');

                const baseUrl = '@Url.Action("VehicleRepairHistoryPartial", "AssignedVehicle", new { area = "User" })';

                if (!baseUrl || baseUrl.includes('undefined')) {
                    throw new Error('Repair history URL is not configured properly');
                }

                const url = buildUrlWithParams(baseUrl, { vehicleId, page, pageSize });

                const modalEl = ensureModal();
                const modalBody = document.getElementById(modalId + '-body');

                if (!modalBody) {
                    throw new Error('Modal body not found');
                }

                // Show loading in modal body as well
                modalBody.innerHTML = `
                    <div class="text-center py-4">
                        <div class="loading-spinner mx-auto mb-3"></div>
                        <h6>Loading repair history...</h6>
                        <p class="text-muted">Please wait while we fetch the data</p>
                    </div>`;

                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 30000); // 30 second timeout

                const resp = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: controller.signal
                });

                clearTimeout(timeoutId);

                if (!resp.ok) {
                    let errorMessage = `Failed to load repair history (${resp.status})`;

                    if (resp.status === 404) {
                        errorMessage = 'Repair history service not found. Please contact support.';
                    } else if (resp.status === 500) {
                        errorMessage = 'Server error occurred while loading repair history.';
                    } else if (resp.status === 403) {
                        errorMessage = 'You do not have permission to view this repair history.';
                    }

                    throw new Error(errorMessage);
                }

                const html = await resp.text();

                if (!html || html.trim().length === 0) {
                    throw new Error('No data received from server');
                }

                modalBody.innerHTML = html;

                // Wire up pagination links inside the partial (ajax)
                modalBody.querySelectorAll('.ajax-repair-history-page').forEach(a => {
                    a.addEventListener('click', function (ev) {
                        ev.preventDefault();
                        const p = parseInt(this.getAttribute('data-page') || '1', 10);
                        if (!isNaN(p) && p > 0) {
                            loadRepairHistoryPage(p, pageSize);
                        }
                    });
                });

                // Hide loading overlay
                LoadingManager.hide();

                // Show the modal
                const bsModal = new bootstrap.Modal(modalEl);
                bsModal.show();

                // Show success message
                AlertManager.show('Repair history loaded successfully', 'success', 3000);

            } catch (err) {
                console.error('Error loading repair history:', err);

                // Hide loading overlay
                LoadingManager.hide();

                let errorMessage = 'Failed to load repair history. Please try again.';

                if (err.name === 'AbortError') {
                    errorMessage = 'Request timed out. Please check your connection and try again.';
                } else if (err.message) {
                    errorMessage = err.message;
                }

                // Show error alert
                AlertManager.show(errorMessage, 'error', 7000);

                // Update modal body with error message
                const modalBody = document.getElementById(modalId + '-body');
                if (modalBody) {
                    modalBody.innerHTML = `
                        <div class="text-center py-5">
                            <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 3rem;"></i>
                            <h5 class="text-danger">Error Loading Repair History</h5>
                            <p class="text-muted">${errorMessage}</p>
                            <button class="btn btn-primary" onclick="location.reload()">
                                <i class="fas fa-refresh me-1"></i>Refresh Page
                            </button>
                        </div>`;
                }
            }
        }

        
    })();

    // Photo viewer functionality with error handling
    function viewPhoto(imageSrc, title) {
        try {
            if (!imageSrc) {
                AlertManager.show('Image source not found', 'error');
                return;
            }

            const photoImage = document.getElementById('photoViewerImage');
            const photoTitle = document.getElementById('photoViewerTitle');

            if (!photoImage || !photoTitle) {
                AlertManager.show('Photo viewer not available', 'error');
                return;
            }

            // Show loading state
            photoImage.style.opacity = '0.5';
            photoTitle.textContent = 'Loading...';

            // Handle image load errors
            photoImage.onerror = function() {
                AlertManager.show('Failed to load image', 'error');
                photoImage.style.opacity = '1';
                photoTitle.textContent = 'Image not available';
            };

            photoImage.onload = function() {
                photoImage.style.opacity = '1';
                photoTitle.textContent = title || 'Vehicle Photo';
            };

            photoImage.src = imageSrc;

            const photoModal = new bootstrap.Modal(document.getElementById('photoViewerModal'));
            photoModal.show();

        } catch (err) {
            console.error('Error viewing photo:', err);
            AlertManager.show('Failed to open photo viewer', 'error');
        }
    }

    // Global error handler for uncaught errors
    window.addEventListener('error', function(e) {
        console.error('Global error:', e.error);
        AlertManager.show('An unexpected error occurred. Please refresh the page if problems persist.', 'error');
    });

    // Handle unhandled promise rejections
    window.addEventListener('unhandledrejection', function(e) {
        console.error('Unhandled promise rejection:', e.reason);
        AlertManager.show('An unexpected error occurred. Please refresh the page if problems persist.', 'error');
    });

    // Page initialization
    document.addEventListener('DOMContentLoaded', function() {
        try {
            // Initialize tooltips if Bootstrap is available
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            // Show welcome message
            setTimeout(() => {
                AlertManager.show('Vehicle details loaded successfully', 'success', 3000);
            }, 500);

            // Check for expired documents and show warnings
            const expiredElements = document.querySelectorAll('.expiry-danger');
            if (expiredElements.length > 0) {
                setTimeout(() => {
                    AlertManager.show('Some vehicle documents have expired. Please check the details.', 'warning', 8000);
                }, 2000);
            }

            const expiringElements = document.querySelectorAll('.expiry-warning');
            if (expiringElements.length > 0 && expiredElements.length === 0) {
                setTimeout(() => {
                    AlertManager.show('Some vehicle documents are expiring soon. Please review them.', 'info', 6000);
                }, 3000);
            }

        } catch (err) {
            console.error('Error during page initialization:', err);
        }
    });

    // Cleanup function for when page is unloaded
    window.addEventListener('beforeunload', function() {
        LoadingManager.hide();
    });

    // Legacy compatibility function (if still needed elsewhere)
    function showToast(message, type) {
        const alertType = type === 'success' ? 'success' : 'error';
        AlertManager.show(message, alertType);
    }
</script> *@