@model VehicleRepairHistoryPartialViewModel
@using System.Text.Encodings.Web
@using FleetManager.Business.ViewModels.RepairHistoryViewModels

<style>
    .repair-history-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        margin: -15px -15px 1.5rem -15px;
        border-radius: 12px 12px 0 0;
    }

        .repair-history-header h5 {
            margin: 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

    .vehicle-info {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-top: 0.5rem;
    }

    .repair-table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .repair-table {
        margin: 0;
    }

        .repair-table thead th {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border: none;
            font-weight: 600;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
            border-bottom: 2px solid #dee2e6;
        }

        .repair-table tbody tr {
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .repair-table tbody tr:hover {
                background: linear-gradient(90deg, #f8f9ff 0%, #f1f3f4 100%);
                transform: translateX(2px);
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

        .repair-table tbody td {
            padding: 1rem 0.75rem;
            border: none;
            border-bottom: 1px solid #f1f3f4;
            vertical-align: middle;
        }

    .repair-id {
        font-weight: 700;
        color: #007bff;
        font-size: 0.9rem;
    }

    .repair-subject {
        font-weight: 600;
        color: #212529;
        margin-bottom: 0.25rem;
    }

    .repair-description {
        font-size: 0.8rem;
        color: #6c757d;
        line-height: 1.3;
    }

    .driver-name {
        font-weight: 500;
        color: #495057;
    }

    .priority-badge {
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .priority-Low {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    .priority-Medium {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
    }

    .priority-High {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }

    .priority-Urgent {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        animation: pulse-urgent 2s infinite;
    }

    @@keyframes pulse-urgent {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    .status-badge {
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-Pending {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        color: #856404;
    }

    .status-InProgress {
        background: linear-gradient(135deg, #cff4fc 0%, #9eeaf9 100%);
        color: #055160;
    }

    .status-Completed {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    .status-Cancelled {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }

    .date-display {
        font-size: 0.9rem;
        color: #495057;
        font-weight: 500;
    }

    .date-relative {
        font-size: 0.75rem;
        color: #6c757d;
        font-style: italic;
        margin-top: 0.25rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6c757d;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            opacity: 0.3;
            color: #007bff;
        }

        .empty-state h6 {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #495057;
        }

    .pagination-wrapper {
        padding: 1.5rem;
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
        display: flex;
        justify-content: between;
        align-items: center;
    }

    .pagination-info {
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 500;
    }

    .pagination {
        margin: 0;
    }

    .page-link {
        border: none;
        color: #495057;
        padding: 0.6rem 0.9rem;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.3s ease;
        margin: 0 0.1rem;
        border-radius: 8px;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
            color: #495057;
            transform: translateY(-1px);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        box-shadow: 0 3px 8px rgba(102, 126, 234, 0.3);
    }

    .alert-custom {
        border-radius: 12px;
        border: none;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .alert-custom i {
            font-size: 1.25rem;
        }

    .close-btn {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        transition: all 0.3s ease;
    }

        .close-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            color: white;
            transform: translateY(-1px);
        }
</style>

<div class="repair-history-modal-content">
    <!-- Header -->
    <div class="repair-history-header">
        <h5>
            <span>
                <i class="fas fa-tools me-2"></i>
                Repair History
            </span>
            <button type="button" class="close-btn" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i> Close
            </button>
        </h5>
        <div class="vehicle-info">
            <i class="fas fa-car me-1"></i>
            @Html.Encode(Model.VehicleDescription)
        </div>
    </div>

    <!-- Content -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning alert-custom">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <strong>Warning</strong><br>
                @Html.Encode(Model.ErrorMessage)
            </div>
        </div>
    }
    else if (Model.Repairs == null || !Model.Repairs.Any())
    {
        <div class="empty-state">
            <i class="fas fa-clipboard-list"></i>
            <h6>No Repair Records Found</h6>
            <p class="mb-0">This vehicle has no repair history on record.</p>
            <small class="text-muted">Repairs will appear here once they are logged in the system.</small>
        </div>
    }
    else
    {
        <div class="repair-table-container">
            <table class="table repair-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Subject</th>
                        <th style="width: 150px;">Driver</th>
                        <th style="width: 120px;">Priority</th>
                        <th style="width: 120px;">Status</th>
                        <th style="width: 140px;">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var repair in Model.Repairs)
                    {
                        <tr onclick="showRepairDetails(@repair.Id, '@Html.Raw(Html.Encode(repair.Subject))', '@Html.Raw(Html.Encode(repair.DriverName ?? "N/A"))', '@repair.Priority', '@repair.Status', '@repair.CreatedAt.ToString("MMM dd, yyyy")')">
                            <td>
                                <div class="repair-id">#@repair.Id</div>
                            </td>
                            <td>
                                <div class="repair-subject">@Html.Encode(repair.Subject)</div>
                                @* @if (!string.IsNullOrEmpty(repair.Description))
                                {
                                    <div class="repair-description">
                                        @Html.Encode(repair.Description.Length > 60 ? repair.Description.Substring(0, 60) + "..." : repair.Description)
                                    </div>
                                } *@
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(repair.DriverName))
                                {
                                    <div class="driver-name">@Html.Encode(repair.DriverName)</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="priority-badge priority-@repair.Priority">
                                    @if (repair.Priority.ToString() == "Urgent")
                                    {
                                        <i class="fas fa-exclamation-triangle"></i>
                                    }
                                    else if (repair.Priority.ToString() == "High")
                                    {
                                        <i class="fas fa-arrow-up"></i>
                                    }
                                    else if (repair.Priority.ToString() == "Medium")
                                    {
                                        <i class="fas fa-minus"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-arrow-down"></i>
                                    }
                                    @repair.Priority
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-@repair.Status.ToString().Replace(" ", "")">
                                    @repair.Status
                                </span>
                            </td>
                            <td>
                                <div class="date-display">@repair.CreatedAt.ToString("MMM dd, yyyy")</div>
                                <div class="date-relative">
                                    @{
                                        var days = (DateTime.Now - repair.CreatedAt).Days;
                                        var timeAgo = days == 0 ? "Today" :
                                        days == 1 ? "1 day ago" :
                                        days < 30 ? $"{days} days ago" :
                                        days < 365 ? $"{days / 30} months ago" :
                                        $"{days / 365} years ago";
                                    }
                                    @timeAgo
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Pagination.TotalPages > 1)
        {
            <div class="pagination-wrapper">
                <div class="pagination-info">
                    Showing @((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize + 1) to
                    @Math.Min(Model.Pagination.CurrentPage * Model.Pagination.PageSize, Model.Pagination.TotalItems)
                    of @Model.Pagination.TotalItems repairs
                </div>
                <nav aria-label="Repair history pagination">
                    <ul class="pagination">
                        @if (Model.Pagination.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link ajax-repair-history-page" href="#" data-page="@(Model.Pagination.CurrentPage - 1)" data-vehicle="@Model.VehicleId">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        @{
                            int startPage = Math.Max(1, Model.Pagination.CurrentPage - 2);
                            int endPage = Math.Min(Model.Pagination.TotalPages, Model.Pagination.CurrentPage + 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Pagination.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link ajax-repair-history-page" href="#" data-page="@p" data-vehicle="@Model.VehicleId">@p</a>
                                </li>
                            }
                        }

                        @if (Model.Pagination.CurrentPage < Model.Pagination.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link ajax-repair-history-page" href="#" data-page="@(Model.Pagination.CurrentPage + 1)" data-vehicle="@Model.VehicleId">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- Simple Modal for Repair Details -->
<div class="modal fade" id="repairDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h6 class="modal-title" id="repairDetailTitle">
                    <i class="fas fa-info-circle me-2"></i>Repair Details
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="repairDetailBody">
                <!-- Content will be populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<script>
    // Simple repair details modal
    function showRepairDetails(id, subject, driver, priority, status, createdDate) {
        const title = `Repair #${id} - ${subject}`;
        const content = `
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <h6 class="text-primary mb-2"><i class="fas fa-user me-1"></i> Driver</h6>
                        <p class="mb-0">${driver}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <h6 class="text-primary mb-2"><i class="fas fa-calendar me-1"></i> Created Date</h6>
                        <p class="mb-0">${createdDate}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <h6 class="text-primary mb-2"><i class="fas fa-flag me-1"></i> Priority</h6>
                        <span class="priority-badge priority-${priority}">
                            ${priority}
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <h6 class="text-primary mb-2"><i class="fas fa-info me-1"></i> Status</h6>
                        <span class="status-badge status-${status.replace(' ', '')}">
                            ${status}
                        </span>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('repairDetailTitle').innerHTML = `<i class="fas fa-info-circle me-2"></i>${title}`;
        document.getElementById('repairDetailBody').innerHTML = content;

        const modal = new bootstrap.Modal(document.getElementById('repairDetailModal'));
        modal.show();
    }
</script>













