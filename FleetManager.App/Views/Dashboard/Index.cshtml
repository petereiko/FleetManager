									<p>No achievements yet.<br />Keep driving!</p>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		(function() {
			// Dynamic Greeting
			const name = "@userName";
			const hour = new Date().getHours();
			let greeting, subMessage;

			if (hour < 12) {
				greeting = "Good Morning";
				subMessage = "Ready for another safe day on the road. Drive smart, deliver excellence!";
			} else if (hour < 17) {
				greeting = "Good Afternoon";
				subMessage = "Keeping the wheels turning! Stay focused and safe out there.";
			} else {
				greeting = "Good Evening";
				subMessage = "Another productive day completed. Rest well for tomorrow's journey.";
			}

			const container = document.getElementById('greeting-container');
			container.innerHTML = `
				<h1 class="dd-greeting">${greeting}, <span class="dd-greeting-name">${name}</span></h1>
				<p class="dd-subtext">${subMessage}</p>
				<p class="dd-glance">Here's your day at a glance</p>
			`;

			// Weekly Performance Chart
			const weeklyLabels = @Html.Raw(JsonSerializer.Serialize(Model?.WeeklyPerformance?.Labels ?? new List<string>()));
			const weeklyData = @Html.Raw(JsonSerializer.Serialize(Model?.WeeklyPerformance?.Distances ?? new List<double>()));

			const ctx1 = document.getElementById('weeklyChart')?.getContext('2d');
			if (ctx1) {
				new Chart(ctx1, {
					type: 'line',
					data: {
						labels: weeklyLabels,
						datasets: [{
							label: 'Miles Driven',
							data: weeklyData,
							borderColor: '#00664c',
							backgroundColor: 'rgba(0,102,76,0.08)',
							fill: true,
							tension: 0.4,
							borderWidth: 3,
							pointRadius: 5,
							pointBackgroundColor: '#00664c',
							pointBorderColor: '#fff',
							pointBorderWidth: 2,
							pointHoverRadius: 7
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: true, position: 'top' },
							tooltip: { backgroundColor: 'rgba(27,40,86,0.9)' }
						},
						scales: {
							y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } },
							x: { grid: { display: false } }
						}
					}
				});
			}

			// Monthly Performance Chart
			const monthlyLabels = @Html.Raw(JsonSerializer.Serialize(Model?.MonthlyPerformance?.Labels ?? new List<string>()));
			const monthlyData = @Html.Raw(JsonSerializer.Serialize(Model?.MonthlyPerformance?.Distances ?? new List<double>()));

			const ctx2 = document.getElementById('monthlyChart')?.getContext('2d');
			if (ctx2) {
				new Chart(ctx2, {
					type: 'bar',
					data: {
						labels: monthlyLabels,
						datasets: [{
							label: 'Miles Driven',
							data: monthlyData,
							backgroundColor: 'rgba(0,102,76,0.85)',
							borderColor: '#00664c',
							borderWidth: 2,
							borderRadius: 8,
							borderSkipped: false
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: true, position: 'top' },
							tooltip: { backgroundColor: 'rgba(27,40,86,0.9)' }
						},
						scales: {
							y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } },
							x: { grid: { display: false } }
						}
					}
				});
			}

			// Animate progress bars
			setTimeout(() => {
				document.querySelectorAll('.dd-progress-bar, .status-bar-fill').forEach(bar => {
					const width = bar.style.width;
					bar.style.width = '0%';
					setTimeout(() => { bar.style.width = width; }, 100);
				});
			}, 500);
		})();
	</script>
}






