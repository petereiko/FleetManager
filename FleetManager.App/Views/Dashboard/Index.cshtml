<!-- Chart.js Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
	(function(){
	  const name = "@userName";          // injected by Razor
	  const hour = new Date().getHours();
	  let greeting, subMessage;
	  if (hour < 12) {
		greeting   = "Good Morning";
		subMessage = "Ready for another safe day on the road. Drive smart, deliver excellence!";
	  } else if (hour < 17) {
		greeting   = "Good Afternoon";
		subMessage = "Keeping the wheels turning! Stay focused and safe out there.";
	  } else {
		greeting   = "Good Evening";
		subMessage = "Another productive day completed. Rest well for tomorrow's journey.";
	  }
	  const container = document.querySelector('.morning-user');
	  container.innerHTML = `
		<h2>${greeting}, <span>${name}</span></h2>
		<p>${subMessage}</p>
	  `;
	})();

	// Weekly Performance Chart
	document.addEventListener('DOMContentLoaded', function() {
		const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
		new Chart(weeklyCtx, {
			type: 'line',
			data: {
				labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
				datasets: [{
					label: 'Miles Driven',
					data: [420, 380, 450, 390, 470, 320, 0],
					borderColor: '#007bff',
					backgroundColor: 'rgba(0, 123, 255, 0.1)',
					tension: 0.4
				}, {
					label: 'Hours Worked',
					data: [10.5, 9.2, 11.0, 8.8, 10.8, 7.5, 0],
					borderColor: '#28a745',
					backgroundColor: 'rgba(40, 167, 69, 0.1)',
					tension: 0.4,
					yAxisID: 'y1'
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				scales: {
					y: {
						type: 'linear',
						display: true,
						position: 'left',
						title: { display: true, text: 'Miles' }
					},
					y1: {
						type: 'linear',
						display: true,
						position: 'right',
						title: { display: true, text: 'Hours' },
						grid: { drawOnChartArea: false }
					}
				}
			}
		});

		// Fuel Efficiency Chart
		const fuelCtx = document.getElementById('fuelChart').getContext('2d');
		new Chart(fuelCtx, {
			type: 'bar',
			data: {
				labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
				datasets: [{
					label: 'MPG',
					data: [5.8, 6.1, 6.4, 6.2],
					backgroundColor: ['#ffc107', '#17a2b8', '#28a745', '#007bff'],
					borderRadius: 5
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				scales: {
					y: {
						beginAtZero: true,
						max: 8,
						title: { display: true, text: 'Miles per Gallon' }
					}
				}
			}
		});

		// Monthly Performance Chart
		const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
		new Chart(monthlyCtx, {
			type: 'doughnut',
			data: {
				labels: ['Completed', 'In Progress', 'Scheduled'],
				datasets: [{
					data: [43, 5, 12],
					backgroundColor: ['#28a745', '#ffc107', '#6c757d'],
					borderWidth: 0
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						position: 'bottom'
					}
				}
			}
		});
	});
</script>

