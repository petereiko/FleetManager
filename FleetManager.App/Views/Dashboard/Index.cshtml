				<div class="stats-label">Total Miles Driven</div>
				<div class="stats-progress">
					<div class="stats-progress-bar progress-primary" style="width:@((Model?.Stats?.TotalMilesDriven ?? 0) > 10000 ? 100 : Math.Min(100, (Model?.Stats?.TotalMilesDriven ?? 0) / 100))%"></div>
				</div>
			</div>
		</div>

		<div class="col-xl-3 col-sm-6 mb-3">
			<div class="stats-card">
				<div class="stats-icon icon-success">
					<i class="fe fe-clock"></i>
				</div>
				<div class="stats-value">@(Model?.Stats?.HoursThisMonth ?? 0)</div>
				<div class="stats-label">Hours This Month</div>
				<div class="stats-progress">
					<div class="stats-progress-bar progress-success" style="width:@(Math.Min(100, (Model?.Stats?.HoursThisMonth ?? 0) / 200.0 * 100))%"></div>
				</div>
			</div>
		</div>

		<div class="col-xl-3 col-sm-6 mb-3">
			<div class="stats-card">
				<div class="stats-icon icon-danger">
					<i class="fe fe-target"></i>
				</div>
				<div class="stats-value">@FmtPercent(Model?.Stats?.SafetyScorePercent)</div>
				<div class="stats-label">Safety Score</div>
				<div class="stats-progress">
					<div class="stats-progress-bar progress-danger" style="width:@(Math.Min(100, Model?.Stats?.SafetyScorePercent ?? 0))%"></div>
				</div>
			</div>
		</div>

		<div class="col-xl-3 col-sm-6 mb-3">
			<div class="stats-card">
				<div class="stats-icon icon-warning">
					<i class="fe fe-check-circle"></i>
				</div>
				<div class="stats-value">@(Model?.Stats?.DeliveriesCompleted ?? 0)</div>
				<div class="stats-label">Deliveries Completed</div>
				<div class="stats-progress">
					<div class="stats-progress-bar progress-warning" style="width:@(Math.Min(100, (Model?.Stats?.DeliveriesCompleted ?? 0) / 50.0 * 100))%"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- Vehicle Status & Performance Charts -->
	<div class="row mb-4">
		<!-- Assigned Vehicle -->
		<div class="col-md-6 col-lg-4 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-truck mr-2"></i>Assigned Vehicle</h5>
				</div>
				<div class="modern-card-body">
					<div class="vehicle-showcase">
						<h4 class="vehicle-model">@(Model?.AssignedVehicle?.MakeModel ?? "No vehicle assigned")</h4>
						<div class="mb-3">
							<span class="vehicle-detail"><strong>Plate:</strong> @(Model?.AssignedVehicle?.PlateNo ?? "—")</span>
							<span class="vehicle-detail"><strong>License:</strong> @(Model?.AssignedVehicle?.FleetId ?? "—")</span>
							<span class="vehicle-detail"><strong>Mileage:</strong> @(Model?.AssignedVehicle?.Mileage?.ToString("N0") ?? "—")</span>
						</div>

						<div class="status-metric">
							<div class="status-metric-header">
								<span class="status-metric-label">Fuel Level</span>
								<span class="status-metric-value text-success">@((Model?.AssignedVehicle?.FuelLevelPercent ?? 0))%</span>
							</div>
							<div class="status-bar">
								<div class="status-bar-fill progress-success" style="width:@(Model?.AssignedVehicle?.FuelLevelPercent ?? 0)%"></div>
							</div>
						</div>

						<div class="status-metric">
							<div class="status-metric-header">
								<span class="status-metric-label">Engine Health</span>
								<span class="status-metric-value text-warning">@(!string.IsNullOrWhiteSpace(Model?.AssignedVehicle?.EngineHealth) ? Model.AssignedVehicle.EngineHealth : "Unknown")</span>
							</div>
							<div class="status-bar">
								<div class="status-bar-fill progress-warning" style="width:@(Model?.AssignedVehicle != null ? 85 : 10)%"></div>
							</div>
						</div>

						<div class="status-metric">
							<div class="status-metric-header">
								<span class="status-metric-label">Tire Condition</span>
								<span class="status-metric-value text-success">@(!string.IsNullOrWhiteSpace(Model?.AssignedVehicle?.TireCondition) ? Model.AssignedVehicle.TireCondition : "Unknown")</span>
							</div>
							<div class="status-bar">
								<div class="status-bar-fill progress-success" style="width:@(Model?.AssignedVehicle != null ? 95 : 10)%"></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Weekly Performance Chart -->
		<div class="col-md-6 col-lg-8 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-trending-up mr-2"></i>Weekly Performance</h5>
				</div>
				<div class="modern-card-body">
					<div class="chart-container">
						<canvas id="weeklyChart"></canvas>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Today's Schedule & Recent Activities -->
	<div class="row mb-4">
		<div class="col-md-6 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-calendar mr-2"></i>Today's Schedule</h5>
				</div>
				<div class="modern-card-body">
					<div class="schedule-list">
						@if (Model?.TodaysSchedule != null && Model.TodaysSchedule.Any())
						{
							foreach (var item in Model.TodaysSchedule)
							{
								var badgeClass = item.Status != null && item.Status.Contains("Completed") ? "badge-success-custom" :
								item.Status != null && item.Status.Contains("InProgress") ? "badge-warning-custom" :
								"badge-primary-custom";
								<div class="schedule-item">
									<span class="schedule-time-badge @badgeClass">@item.TimeDisplay</span>
									<div class="schedule-details">
										<div class="schedule-title">@item.Title</div>
										<div class="schedule-description">@item.ShortDescription</div>
										<div class="schedule-location"><i class="fe fe-map-pin"></i> @item.Location</div>
									</div>
								</div>
							}
						}
						else
						{
							<div class="empty-state">
								<i class="fe fe-calendar"></i>
								<p>No scheduled jobs for today.</p>
							</div>
						}
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-6 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-activity mr-2"></i>Recent Activities</h5>
				</div>
				<div class="modern-card-body">
					<div class="activity-list">
						@if (Model?.RecentActivities != null && Model.RecentActivities.Any())
						{
							foreach (var act in Model.RecentActivities)
							{
								var iconBg = act.Category switch
								{
									"Fuel" => "background: var(--warning-gradient);",
									"Trip" => "background: var(--primary-gradient);",
									"Violation" => "background: var(--danger-gradient);",
									"Message" => "background: var(--info-gradient);",
									_ => "background: var(--success-gradient);"
								};
								var iconClass = act.Category switch
								{
									"Fuel" => "fe-droplet",
									"Trip" => "fe-truck",
									"Violation" => "fe-alert-triangle",
									"Message" => "fe-message-square",
									_ => "fe-check-circle"
								};
								<div class="activity-item">
									<div class="activity-icon" style="@iconBg">
										<i class="fe @iconClass"></i>
									</div>
									<div class="activity-details">
										<div class="activity-title">@act.Title</div>
										<div class="activity-message">@act.Message</div>
										<div class="activity-time"><i class="fe fe-clock"></i> @act.OccurredAt.ToLocalTime().ToString("g")</div>
									</div>
								</div>
							}
						}
						else
						{
							<div class="empty-state">
								<i class="fe fe-activity"></i>
								<p>No recent activity.</p>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Safety Metrics & Monthly Performance -->
	<div class="row mb-4">
		<div class="col-md-4 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-shield mr-2"></i>Safety Metrics</h5>
				</div>
				<div class="modern-card-body">
					<div class="metric-item">
						<div class="metric-header">
							<span class="metric-label">Safe Driving Score</span>
							<span class="metric-value text-success">@FmtPercent(Model?.SafetyMetrics?.SafeDrivingScore)</span>
						</div>
						<div class="stats-progress">
							<div class="stats-progress-bar progress-success" style="width:@(Math.Min(100, Model?.SafetyMetrics?.SafeDrivingScore ?? 0))%"></div>
						</div>
					</div>

					<div class="metric-item">
						<div class="metric-header">
							<span class="metric-label">Speed Compliance</span>
							<span class="metric-value text-primary">@FmtPercent(Model?.SafetyMetrics?.SpeedCompliancePercent)</span>
						</div>
						<div class="stats-progress">
							<div class="stats-progress-bar progress-primary" style="width:@(Math.Min(100, Model?.SafetyMetrics?.SpeedCompliancePercent ?? 0))%"></div>
						</div>
					</div>

					<div class="metric-item">
						<div class="metric-header">
							<span class="metric-label">On-Time Delivery</span>
							<span class="metric-value text-warning">@FmtPercent(Model?.SafetyMetrics?.OnTimeDeliveryPercent)</span>
						</div>
						<div class="stats-progress">
							<div class="stats-progress-bar progress-warning" style="width:@(Math.Min(100, Model?.SafetyMetrics?.OnTimeDeliveryPercent ?? 0))%"></div>
						</div>
					</div>

					<div class="safety-stats-grid">
						<div class="stat-box">
							<div class="stat-box-value text-success">@((Model?.SafetyMetrics?.DaysAccidentFree ?? 0))</div>
							<div class="stat-box-label">Days Accident Free</div>
						</div>
						<div class="stat-box">
							<div class="stat-box-value text-danger">@((Model?.SafetyMetrics?.ViolationsCount ?? 0))</div>
							<div class="stat-box-label">Violations</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Monthly Performance Summary -->
		<div class="col-md-8 mb-3">
			<div class="modern-card">
				<div class="modern-card-header">
					<h5><i class="fe fe-bar-chart-2 mr-2"></i>Monthly Performance Summary</h5>
				</div>
				<div class="modern-card-body">
					<div class="row">
						<div class="col-lg-8">
							<div class="chart-container-tall">
								<canvas id="monthlyChart"></canvas>
							</div>
						</div>
						<div class="col-lg-4">
							<h6 class="mb-3" style="font-weight: 600; color: #2d3436;"><i class="fe fe-award mr-2"></i>Key Achievements</h6>
							@if (Model?.MonthlyPerformance?.Achievements != null && Model.MonthlyPerformance.Achievements.Any())
							{
								foreach (var a in Model.MonthlyPerformance.Achievements)
								{
									<div class="achievement-item">
										<div class="achievement-icon">
											<i class="fe fe-award"></i>
										</div>
										<div>
											<div class="achievement-title">@a.Title</div>
											<div class="achievement-subtitle">@a.SubText</div>
										</div>
									</div>
								}
							}
							else
							{
								<div class="empty-state">
									<i class="fe fe-award"></i>
									<p>No achievements yet. Keep driving!</p>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		(function() {
			// Dynamic Greeting
			const name = "@userName";
			const hour = new Date().getHours();
			let greeting, subMessage, emoji;

			if (hour < 12) {
				greeting = "Good Morning";
				subMessage = "Ready for another safe day on the road. Drive smart, deliver excellence!";
				emoji = "☀️";
			} else if (hour < 17) {
				greeting = "Good Afternoon";
				subMessage = "Keeping the wheels turning! Stay focused and safe out there.";
				emoji = "🚚";
			} else {
				greeting = "Good Evening";
				subMessage = "Another productive day completed. Rest well for tomorrow's journey.";
				emoji = "🌙";
			}

			const container = document.getElementById('greeting-container');
			container.innerHTML = `
				<h1>${greeting}, <span class="greeting-name">${name}</span> ${emoji}</h1>
				<p>${subMessage}</p>
				<p style="opacity: 0.9; font-size: 1rem;">Here's your day at a glance</p>
			`;

			// Weekly Performance Chart
			const weeklyLabels = @Html.Raw(JsonSerializer.Serialize(Model?.WeeklyPerformance?.Labels ?? new List<string>()));
			const weeklyData = @Html.Raw(JsonSerializer.Serialize(Model?.WeeklyPerformance?.Distances ?? new List<double>()));

			const ctx1 = document.getElementById('weeklyChart')?.getContext('2d');
			if (ctx1) {
				new Chart(ctx1, {
					type: 'line',
					data: {
						labels: weeklyLabels,
						datasets: [{
							label: 'Miles Driven',
							data: weeklyData,
							borderColor: '#667eea',
							backgroundColor: 'rgba(102, 126, 234, 0.1)',
							fill: true,
							tension: 0.4,
							borderWidth: 3,
							pointRadius: 5,
							pointBackgroundColor: '#667eea',
							pointBorderColor: '#fff',
							pointBorderWidth: 2,
							pointHoverRadius: 7,
							pointHoverBackgroundColor: '#667eea',
							pointHoverBorderColor: '#fff',
							pointHoverBorderWidth: 3
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: true,
								position: 'top',
								labels: {
									usePointStyle: true,
									padding: 15,
									font: {
										size: 12,
										weight: '600'
									}
								}
							},
							tooltip: {
								backgroundColor: 'rgba(0, 0, 0, 0.8)',
								padding: 12,
								borderColor: '#667eea',
								borderWidth: 1,
								titleFont: {
									size: 14,
									weight: 'bold'
								},
								bodyFont: {
									size: 13
								},
								displayColors: true,
								callbacks: {
									label: function(context) {
										return ' ' + context.parsed.y.toLocaleString() + ' miles';
									}
								}
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								grid: {
									color: 'rgba(0, 0, 0, 0.05)',
									drawBorder: false
								},
								ticks: {
									font: {
										size: 11
									},
									padding: 10,
									callback: function(value) {
										return value.toLocaleString();
									}
								}
							},
							x: {
								grid: {
									display: false,
									drawBorder: false
								},
								ticks: {
									font: {
										size: 11
									},
									padding: 10
								}
							}
						},
						interaction: {
							intersect: false,
							mode: 'index'
						}
					}
				});
			}

			// Monthly Performance Chart
			const monthlyLabels = @Html.Raw(JsonSerializer.Serialize(Model?.MonthlyPerformance?.Labels ?? new List<string>()));
			const monthlyData = @Html.Raw(JsonSerializer.Serialize(Model?.MonthlyPerformance?.Distances ?? new List<double>()));

			const ctx2 = document.getElementById('monthlyChart')?.getContext('2d');
			if (ctx2) {
				new Chart(ctx2, {
					type: 'bar',
					data: {
						labels: monthlyLabels,
						datasets: [{
							label: 'Miles Driven',
							data: monthlyData,
							backgroundColor: function(context) {
								const chart = context.chart;
								const {ctx, chartArea} = chart;
								if (!chartArea) return 'rgba(102, 126, 234, 0.8)';

								const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
								gradient.addColorStop(0, 'rgba(102, 126, 234, 0.7)');
								gradient.addColorStop(1, 'rgba(118, 75, 162, 0.9)');
								return gradient;
							},
							borderColor: '#667eea',
							borderWidth: 2,
							borderRadius: 8,
							borderSkipped: false
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: true,
								position: 'top',
								labels: {
									usePointStyle: true,
									padding: 15,
									font: {
										size: 12,
										weight: '600'
									}
								}
							},
							tooltip: {
								backgroundColor: 'rgba(0, 0, 0, 0.8)',
								padding: 12,
								borderColor: '#667eea',
								borderWidth: 1,
								titleFont: {
									size: 14,
									weight: 'bold'
								},
								bodyFont: {
									size: 13
								},
								displayColors: true,
								callbacks: {
									label: function(context) {
										return ' ' + context.parsed.y.toLocaleString() + ' miles';
									}
								}
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								grid: {
									color: 'rgba(0, 0, 0, 0.05)',
									drawBorder: false
								},
								ticks: {
									font: {
										size: 11
									},
									padding: 10,
									callback: function(value) {
										return value.toLocaleString();
									}
								}
							},
							x: {
								grid: {
									display: false,
									drawBorder: false
								},
								ticks: {
									font: {
										size: 11
									},
									padding: 10
								}
							}
						}
					}
				});
			}

			// Animate progress bars on load
			setTimeout(() => {
				document.querySelectorAll('.stats-progress-bar, .status-bar-fill').forEach(bar => {
					const width = bar.style.width;
					bar.style.width = '0%';
					setTimeout(() => {
						bar.style.width = width;
					}, 100);
				});
			}, 500);
		})();
	</script>
}









 *@