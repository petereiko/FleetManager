@using FleetManager.Business.DataObjects
@model FineAndTollDto

@{
	ViewData["Title"] = "Fine & Toll Details";

	// Determine status styling
	var statusClass = "";
	var statusIcon = "";

	if (Model.Status.ToString().ToLower() == "paid" || Model.Status.ToString().ToLower() == "resolved")
	{
		statusClass = "status-paid";
		statusIcon = "check-circle";
	}
	else if (Model.Status.ToString().ToLower() == "pending")
	{
		statusClass = "status-pending";
		statusIcon = "clock";
	}
	else if (Model.Status.ToString().ToLower() == "overdue")
	{
		statusClass = "status-overdue";
		statusIcon = "alert-triangle";
	}
	else
	{
		statusClass = "status-unpaid";
		statusIcon = "alert-circle";
	}

	// Determine type styling
	var typeClass = Model.Type.ToString().ToLower() == "fine" ? "type-fine" : "type-toll";
	var typeIcon = Model.Type.ToString().ToLower() == "fine" ? "alert-octagon" : "navigation";
}

<style>
	/* ══════════════════════════════════════════════════════
		   FINE & TOLL DETAILS — Fleetalia v4 Theme
		   Professional, clean, enterprise-grade
		══════════════════════════════════════════════════════ */

	.fine-details-wrapper {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Hero Header */
	.fine-hero {
		background: #1B2856;
		border-radius: 14px;
		padding: 32px;
		margin-bottom: 24px;
		box-shadow: 0 4px 16px rgba(27,40,86,0.15);
		position: relative;
		overflow: hidden;
	}

		.fine-hero::before {
			content: '';
			position: absolute;
			top: -70px;
			right: -70px;
			width: 220px;
			height: 220px;
			border-radius: 50%;
			background: rgba(0,102,76,0.06);
		}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 16px;
		margin-bottom: 20px;
	}

	.hero-title-section h1 {
		font-size: 28px;
		font-weight: 800;
		color: #fff;
		margin-bottom: 8px;
		letter-spacing: -0.5px;
	}

	.hero-vehicle {
		font-size: 15px;
		color: rgba(255,255,255,0.7);
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 500;
	}

		.hero-vehicle i {
			color: #6ee7b7;
		}

	.hero-badges {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		align-items: center;
	}

	.status-badge {
		padding: 10px 18px;
		border-radius: 99px;
		font-size: 13px;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		background: #fff;
	}

	.status-paid {
		color: #00664c;
	}

	.status-pending {
		color: #c07800;
	}

	.status-overdue, .status-unpaid {
		color: #c0392b;
	}

	.type-badge {
		padding: 10px 18px;
		border-radius: 99px;
		font-size: 13px;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.type-fine {
		background: rgba(192,57,43,0.15);
		color: #c0392b;
		border: 1px solid rgba(192,57,43,0.3);
	}

	.type-toll {
		background: rgba(0,102,76,0.15);
		color: #00664c;
		border: 1px solid rgba(0,102,76,0.3);
	}

	.amount-display {
		background: rgba(255,255,255,0.12);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.2);
		border-radius: 12px;
		padding: 16px 24px;
		display: inline-flex;
		flex-direction: column;
		gap: 4px;
	}

	.amount-label {
		font-size: 12px;
		color: rgba(255,255,255,0.7);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		font-weight: 600;
	}

	.amount-value {
		font-size: 32px;
		font-weight: 800;
		color: #fff;
		font-family: 'DM Mono', monospace;
	}

	/* Action Buttons */
	.action-buttons {
		display: flex;
		gap: 12px;
		margin-bottom: 24px;
		flex-wrap: wrap;
	}

	.btn-back {
		background: #fff;
		color: #1B2856;
		border: 1.5px solid #1B2856;
		padding: 10px 20px;
		border-radius: 10px;
		font-weight: 600;
		font-size: 14px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		transition: all 0.2s;
	}

		.btn-back:hover {
			background: #1B2856;
			color: #fff;
		}

	.btn-edit {
		background: #00664c;
		color: #fff;
		border: none;
		padding: 10px 20px;
		border-radius: 10px;
		font-weight: 600;
		font-size: 14px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		transition: all 0.2s;
	}

		.btn-edit:hover {
			background: #00875f;
			color: #fff;
			transform: translateY(-1px);
		}

	/* Info Grid */
	.info-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 20px;
		margin-bottom: 24px;
	}

	.info-card {
		background: #fff;
		border: 1px solid #e2e4e8;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(0,0,0,0.04);
		transition: all 0.2s;
	}

		.info-card:hover {
			box-shadow: 0 6px 20px rgba(0,0,0,0.08);
			transform: translateY(-2px);
		}

	.info-card-header {
		background: #f7f8fa;
		border-bottom: 1px solid #e2e4e8;
		padding: 18px 22px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.card-icon {
		width: 44px;
		height: 44px;
		border-radius: 11px;
		background: #00664c;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-size: 18px;
	}

	.card-title {
		font-size: 16px;
		font-weight: 700;
		color: #1a1c20;
		margin: 0;
	}

	.info-card-body {
		padding: 22px;
	}

	.info-item {
		margin-bottom: 18px;
	}

		.info-item:last-child {
			margin-bottom: 0;
		}

	.info-label {
		font-size: 11px;
		color: rgba(26,28,32,0.6);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 6px;
		font-weight: 600;
	}

	.info-value {
		color: #1a1c20;
		font-size: 15px;
		font-weight: 600;
		line-height: 1.5;
	}

	/* Attachments Section */
	.attachments-section {
		background: #fff;
		border: 1px solid #e2e4e8;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(0,0,0,0.04);
	}

	.attachments-header {
		background: #f7f8fa;
		border-bottom: 1px solid #e2e4e8;
		padding: 18px 22px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.attachments-body {
		padding: 22px;
	}

	.attachments-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 14px;
	}

	.attachment-card {
		background: #f7f8fa;
		border: 1.5px solid #e2e4e8;
		border-radius: 12px;
		padding: 16px;
		text-align: center;
		transition: all 0.2s;
		cursor: pointer;
		text-decoration: none;
		display: block;
	}

		.attachment-card:hover {
			border-color: #00664c;
			background: #fff;
			box-shadow: 0 4px 12px rgba(0,102,76,0.1);
			transform: translateY(-2px);
		}

	.attachment-icon {
		width: 60px;
		height: 60px;
		margin: 0 auto 12px;
		background: #fff;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28px;
		color: #00664c;
	}

	.attachment-name {
		font-size: 13px;
		font-weight: 600;
		color: #1a1c20;
		word-break: break-word;
		margin-bottom: 6px;
	}

	.attachment-action {
		font-size: 11px;
		color: #00664c;
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
	}

	.empty-attachments {
		text-align: center;
		padding: 40px 20px;
		color: rgba(26,28,32,0.35);
	}

		.empty-attachments i {
			font-size: 3rem;
			margin-bottom: 12px;
			opacity: 0.2;
		}

		.empty-attachments p {
			font-size: 14px;
			color: rgba(26,28,32,0.6);
			margin: 0;
		}

	/* Responsive */
	@@media (max-width: 768px) {
		.hero-top {
			flex-direction: column;
		}

		.amount-display {
			width: 100%;
		}

		.info-grid {
			grid-template-columns: 1fr;
		}

		.attachments-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<div class="content">
	<!-- Page Header -->
	<div class="page-header">
		<div class="row">
			<div class="col-sm-12">
				<ul class="breadcrumb">
					<li class="breadcrumb-item"><a href="index.html">Dashboard</a></li>
					<li class="breadcrumb-item"><i class="feather-chevron-right"></i></li>
					<li class="breadcrumb-item"><a asp-action="Index">Fines & Tolls</a></li>
					<li class="breadcrumb-item"><i class="feather-chevron-right"></i></li>
					<li class="breadcrumb-item active">Details</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="fine-details-wrapper">
		<!-- Hero Header -->
		<div class="fine-hero">
			<div class="hero-content">
				<div class="hero-top">
					<div class="hero-title-section">
						<h1>@Model.Title</h1>
						<div class="hero-vehicle">
							<i class="fe fe-truck"></i>
							@Model.VehicleDescription
						</div>
					</div>

					<div class="amount-display">
						<div class="amount-label">Amount</div>
						<div class="amount-value">₦@Model.Amount.ToString("N2")</div>
					</div>
				</div>

				<div class="hero-badges">
					<span class="status-badge @statusClass">
						<i class="fe fe-@statusIcon"></i>
						@Model.Status
					</span>
					<span class="type-badge @typeClass">
						<i class="fe fe-@typeIcon"></i>
						@Model.Type
					</span>
				</div>
			</div>
		</div>

		<!-- Action Buttons -->
		<div class="action-buttons">
			<a class="btn-back" asp-action="Index">
				<i class="fe fe-arrow-left"></i>
				Back to List
			</a>
			<a class="btn-edit" asp-action="Edit" asp-protect-route-id="@Model.Id">
				<i class="fe fe-edit"></i>
				Edit Details
			</a>
		</div>

		<!-- Info Grid -->
		<div class="info-grid">
			<!-- Details Card -->
			<div class="info-card">
				<div class="info-card-header">
					<div class="card-icon">
						<i class="fe fe-info"></i>
					</div>
					<h3 class="card-title">Fine/Toll Details</h3>
				</div>
				<div class="info-card-body">
					<div class="info-item">
						<div class="info-label">Type</div>
						<div class="info-value">@Model.Type</div>
					</div>
					<div class="info-item">
						<div class="info-label">Status</div>
						<div class="info-value">@Model.Status</div>
					</div>
					<div class="info-item">
						<div class="info-label">Amount</div>
						<div class="info-value">₦@Model.Amount.ToString("N2")</div>
					</div>
				</div>
			</div>

			<!-- Vehicle Card -->
			<div class="info-card">
				<div class="info-card-header">
					<div class="card-icon">
						<i class="fe fe-truck"></i>
					</div>
					<h3 class="card-title">Vehicle Information</h3>
				</div>
				<div class="info-card-body">
					<div class="info-item">
						<div class="info-label">Vehicle</div>
						<div class="info-value">@Model.VehicleDescription</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Reason & Notes -->
		@if (!string.IsNullOrWhiteSpace(Model.Reason) || !string.IsNullOrWhiteSpace(Model.Notes))
		{
			<div class="info-grid">
				@if (!string.IsNullOrWhiteSpace(Model.Reason))
				{
					<div class="info-card">
						<div class="info-card-header">
							<div class="card-icon">
								<i class="fe fe-file-text"></i>
							</div>
							<h3 class="card-title">Reason</h3>
						</div>
						<div class="info-card-body">
							<div class="info-value">@Model.Reason</div>
						</div>
					</div>
				}

				@if (!string.IsNullOrWhiteSpace(Model.Notes))
				{
					<div class="info-card">
						<div class="info-card-header">
							<div class="card-icon">
								<i class="fe fe-message-square"></i>
							</div>
							<h3 class="card-title">Additional Notes</h3>
						</div>
						<div class="info-card-body">
							<div class="info-value">@Model.Notes</div>
						</div>
					</div>
				}
			</div>
		}

		<!-- Attachments Section -->
		<div class="attachments-section">
			<div class="attachments-header">
				<div class="card-icon">
					<i class="fe fe-paperclip"></i>
				</div>
				<h3 class="card-title">
					Attachments
					@if (Model.AttachmentPaths?.Any() == true)
					{
						<span style="font-size:13px;font-weight:600;color:rgba(26,28,32,0.6);margin-left:8px;">(@Model.AttachmentPaths.Count())</span>
					}
				</h3>
			</div>
			<div class="attachments-body">
				@if (Model.AttachmentPaths?.Any() == true)
				{
					<div class="attachments-grid">
						@foreach (var file in Model.AttachmentPaths)
						{
							var fileName = System.IO.Path.GetFileName(file);
							var extension = System.IO.Path.GetExtension(file).ToLower();
							var fileIcon = "file";

							if (extension == ".pdf")
							{
								fileIcon = "file-text";
							}
							else if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif")
							{
								fileIcon = "image";
							}
							else if (extension == ".doc" || extension == ".docx")
							{
								fileIcon = "file-text";
							}
							else if (extension == ".xls" || extension == ".xlsx")
							{
								fileIcon = "file-text";
							}

							<a href="@file" target="_blank" class="attachment-card">
								<div class="attachment-icon">
									<i class="fe fe-@fileIcon"></i>
								</div>
								<div class="attachment-name">@fileName</div>
								<div class="attachment-action">
									<i class="fe fe-external-link"></i>
									View File
								</div>
							</a>
						}
					</div>
				}
				else
				{
					<div class="empty-attachments">
						<i class="fe fe-paperclip"></i>
						<p>No attachments uploaded</p>
					</div>
				}
			</div>
		</div>
	</div>
</div>





