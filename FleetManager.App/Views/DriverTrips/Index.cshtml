@using FleetManager.Business.DataObjects.TripsDto
@model List<TripListDto>
@{
    ViewData["Title"] = "My Trips";
    var sortedTrips = Model?.OrderByDescending(t => t.ScheduledStartDate).ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .trips-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .trips-header h1 {
            margin: 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

    .trip-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border-left: 4px solid #e0e0e0;
    }

        .trip-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }

        .trip-card.status-assigned {
            border-left-color: #3b82f6;
        }

        .trip-card.status-inprogress {
            border-left-color: #f59e0b;
        }

        .trip-card.status-completed {
            border-left-color: #10b981;
        }

    .trip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .trip-number {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status-badge {
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-assigned {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .status-inprogress {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status-completed {
        background-color: #d1fae5;
        color: #065f46;
    }

    .trip-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .detail-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .detail-icon {
        width: 36px;
        height: 36px;
        background: #f3f4f6;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        flex-shrink: 0;
    }

    .detail-content {
        flex: 1;
    }

    .detail-label {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        color: #1f2937;
        font-weight: 500;
    }

    .route-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .location {
        font-weight: 600;
    }

    .route-arrow {
        color: #9ca3af;
    }

    .trip-actions {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
    }

    .btn-details {
        background: #667eea;
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
    }

        .btn-details:hover {
            background: #5568d3;
            color: white;
            transform: translateX(3px);
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

        .empty-state i {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            color: #6b7280;
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: #9ca3af;
        }

    .refresh-btn {
        background: white;
        color: #667eea;
        border: 2px solid white;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .refresh-btn:hover {
            background: rgba(255,255,255,0.2);
            color: white;
            border-color: white;
        }

    .date-display {
        font-size: 0.9rem;
    }

    .date-end {
        font-size: 0.85rem;
        color: #6b7280;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .trip-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .trip-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container mt-4">
    <div class="trips-header">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <h1>
                <i class="fas fa-route"></i>
                My Trips
            </h1>
            <a class="refresh-btn" asp-action="Index">
                <i class="fas fa-sync-alt"></i>
                Refresh
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (sortedTrips == null || !sortedTrips.Any())
    {
        <div class="empty-state">
            <i class="fas fa-clipboard-list"></i>
            <h3>No Trips Assigned</h3>
            <p>You don't have any trips assigned at the moment. Check back later!</p>
        </div>
    }
    else
    {
        @foreach (var trip in sortedTrips)
        {
            var statusClass = "";
            var statusIcon = "";

            if (trip.StatusDisplay?.ToLower().Contains("assigned") == true)
            {
                statusClass = "assigned";
                statusIcon = "fa-calendar-check";
            }
            else if (trip.StatusDisplay?.ToLower().Contains("progress") == true)
            {
                statusClass = "inprogress";
                statusIcon = "fa-truck-moving";
            }
            else if (trip.StatusDisplay?.ToLower().Contains("completed") == true)
            {
                statusClass = "completed";
                statusIcon = "fa-circle-check";
            }

            <div class="trip-card status-@statusClass">
                <div class="trip-header">
                    <div class="trip-number">
                        <i class="fas fa-hashtag"></i>
                        @trip.TripNumber
                    </div>
                    <span class="status-badge status-@statusClass">
                        <i class="fas @statusIcon"></i>
                        @trip.StatusDisplay
                    </span>
                </div>

                <div class="trip-details">
                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-car"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Vehicle</div>
                            <div class="detail-value">@trip.VehiclePlateNo</div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Route</div>
                            <div class="detail-value route-display">
                                <span class="location">@trip.Origin</span>
                                <i class="fas fa-arrow-right route-arrow"></i>
                                <span class="location">@trip.Destination</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-label">Schedule</div>
                            <div class="detail-value">
                                <div class="date-display">
                                    <i class="fas fa-calendar-day"></i>
                                    @trip.ScheduledStartDate.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                                </div>
                                <div class="date-end">
                                    <i class="fas fa-flag-checkered"></i>
                                    @trip.ScheduledEndDate.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="trip-actions">
                    <a class="btn-details" asp-action="Details" asp-protect-route-id="@trip.Id">
                        View Details
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
    }
</div>
























