                    if (!resp.ok) return null;
                    const data = await resp.json();
                    return data.display_name || null;
                } catch (e) { console.warn('Reverse geocode failed', e); return null; }
            }

            async function attemptGeolocationLocalComplete($container) {
                const $lat = $container.find('.geo-lat');
                const $lon = $container.find('.geo-lon');
                const $acc = $container.find('.geo-acc');

                if (!navigator.geolocation) { setGeoStatus('Geolocation not supported', true, 'Complete'); setGeoAccuracyText('No location', true, 'Complete'); return; }
                setGeoSpinner(true, 'Complete'); setGeoStatus('Requesting location…', false, 'Complete');

                navigator.geolocation.getCurrentPosition(async function (pos) {
                    const lat = pos.coords.latitude; const lon = pos.coords.longitude; const acc = pos.coords.accuracy || 0;
                    if ($lat.length) $lat.val(lat);
                    if ($lon.length) $lon.val(lon);
                    if ($acc.length) $acc.val(acc);
                    setGeoSpinner(false, 'Complete'); setGeoAccuracyText(`±${Math.round(acc)} m`, false, 'Complete'); setGeoStatus('Location captured', false, 'Complete');
                    const addr = await reverseGeocodeNominatim(lat, lon);
                    if (addr) setGeoAddress(addr, 'Complete');
                }, function (err) {
                    setGeoSpinner(false, 'Complete');
                    let msg = 'Could not get location';
                    if (err && typeof err.code !== 'undefined') {
                        if (err.code === 1) msg = 'Permission denied. Enable location in browser settings and retry.';
                        else if (err.code === 2) msg = 'Position unavailable. Try again outdoors.';
                        else if (err.code === 3) msg = 'Timeout. Try again.';
                    }
                    setGeoStatus(msg, true, 'Complete'); setGeoAccuracyText('No location', true, 'Complete');
                }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
            }

            $(document).off('click.completeGeo', '#fillLocationBtnComplete').on('click.completeGeo', '#fillLocationBtnComplete', function (e) {
                e.preventDefault();
                var $form = $(this).closest('form');
                attemptGeolocationLocalComplete($form);
            });

            if ($('#completeForm').length) {
                setTimeout(function () { attemptGeolocationLocalComplete($('#completeForm')); }, 250);
            }

            window.bindCompleteForm = function () { console.log('bindCompleteForm called'); };
        })(jQuery);
    </script>
}
 *@