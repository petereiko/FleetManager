    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <div id="completeFormAlert"></div>

    <div class="text-end">
        <button type="submit" class="btn btn-primary">Complete Trip</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

@section Scripts {
    <script>
        (function($) {
            if (!window.jQuery) return;

            function showCompleteAlert(html) { $('#completeFormAlert').html('<div class="alert alert-danger">' + html + '</div>'); }

            if (!$(document).data('completeFormHandlerAttached')) {
                $(document).on('submit.completeForm', '#completeForm', function (e) {
                    e.preventDefault();
                    var $form = $(this);
                    var url = $form.attr('action') || '@Url.Action("Complete", "DriverTrips", new { area = "User" })';
                    var token = $form.find('input[name="__RequestVerificationToken"]').val();

                    // client validation
                    var endOdo = $form.find('[name="EndOdometer"]').val();
                    if (!endOdo || isNaN(Number(endOdo))) {
                        showCompleteAlert('End odometer is required and must be numeric.');
                        return;
                    }

                    var data = $form.serialize();
                    var $submit = $form.find('button[type="submit"]');
                    $submit.prop('disabled', true);
                    $('#completeFormAlert').html('');

                    $.ajax({
                        url: url,
                        method: 'POST',
                        data: data,
                        headers: {
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        success: function (resp) {
                            if (resp && resp.success) {
                                var modalEl = document.getElementById('completeModal');
                                if (modalEl) {
                                    var inst = bootstrap.Modal.getInstance(modalEl);
                                    if (inst) inst.hide();
                                }
                                location.reload();
                            } else {
                                var msg = (resp && resp.message) ? resp.message : 'Unable to complete trip';
                                showCompleteAlert(msg);
                            }
                        },
                        error: function (xhr) {
                            var message = 'Failed to complete trip';
                            try {
                                if (xhr && xhr.responseJSON && xhr.responseJSON.message) message = xhr.responseJSON.message;
                                else if (xhr && xhr.responseText) message = xhr.responseText;
                            } catch (ex) { message = 'Server error'; }
                            showCompleteAlert(message);
                        },
                        complete: function () { $submit.prop('disabled', false); }
                    });
                });

                $(document).data('completeFormHandlerAttached', true);
            }

            // geolocation (same pattern as start partial)
            function setGeoSpinner(on, suffix) { $('#geoBtnSpinner' + suffix).toggleClass('visually-hidden', !on); $('#geoBtnText' + suffix).text(on ? 'Locating…' : 'Use my location'); }
            function setGeoAccuracyText(txt, isErr, suffix) { $('#geoAccuracy' + suffix).text(txt).toggleClass('bg-danger', isErr).toggleClass('bg-secondary', !isErr); }
            function setGeoStatus(txt, isErr, suffix) { $('#geoStatus' + suffix).text(txt).toggleClass('text-danger', isErr).toggleClass('text-muted', !isErr); }
            function setGeoAddress(txt, suffix) { $('#geoAddress' + suffix).text(txt || ''); }

            async function reverseGeocodeNominatim(lat, lon) {
                try {
                    const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`;
