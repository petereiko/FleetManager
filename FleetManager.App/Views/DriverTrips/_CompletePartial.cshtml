                <button type="button" class="btn btn-outline-secondary geo-fill-btn" id="fillLocationBtnComplete">
                    <span id="geoBtnSpinnerComplete" class="spinner-border spinner-border-sm visually-hidden" role="status" aria-hidden="true"></span>
                    <span id="geoBtnTextComplete">Use my location</span>
