    }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
}

$(function () {
    attemptGeolocation(); // one attempt on modal load
    $('#fillLocationBtn').on('click', function (e) { e.preventDefault(); attemptGeolocation(); });
