@using FleetManager.Business.ViewModels.TripsViewModels
@model StartTripViewModel

<style>
    .start-form-container {
        padding: 1rem;
    }

    .form-group-enhanced {
        margin-bottom: 1.5rem;
    }

    .form-label-enhanced {
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control-enhanced {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control-enhanced:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
            outline: none;
        }

    .location-card {
        background: #f9fafb;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .location-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .location-title {
        font-weight: 600;
        color: #1f2937;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-get-location {
        background: #10b981;
        color: white;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-get-location:hover:not(:disabled) {
            background: #059669;
            transform: translateY(-1px);
        }

        .btn-get-location:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .location-status {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-top: 1rem;
    }

    .accuracy-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .accuracy-excellent {
        background: #d1fae5;
        color: #065f46;
        border: 2px solid #10b981;
    }

    .accuracy-good {
        background: #dbeafe;
        color: #1e40af;
        border: 2px solid #3b82f6;
    }

    .accuracy-fair {
        background: #fef3c7;
        color: #92400e;
        border: 2px solid #f59e0b;
    }

    .accuracy-poor {
        background: #fee2e2;
        color: #991b1b;
        border: 2px solid #ef4444;
    }

    .accuracy-none {
        background: #f3f4f6;
        color: #6b7280;
        border: 2px solid #d1d5db;
    }

    .location-address {
        flex: 1;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        font-size: 0.95rem;
        color: #4b5563;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 46px;
    }

        .location-address i {
            color: #10b981;
        }

    .location-message {
        font-size: 0.9rem;
        margin-top: 0.75rem;
        padding: 0.75rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .location-message.info {
            background: #dbeafe;
            color: #1e40af;
        }

        .location-message.error {
            background: #fee2e2;
            color: #991b1b;
        }

        .location-message.success {
            background: #d1fae5;
            color: #065f46;
        }

    .modal-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
        padding-top: 1rem;
        border-top: 2px solid #f3f4f6;
        margin-top: 1.5rem;
    }

    .btn-submit-start {
        background: #10b981;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .btn-submit-start:hover {
            background: #059669;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background: #f3f4f6;
        color: #4b5563;
        border: 2px solid #e5e7eb;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

    .spinner-inline {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-rotate 0.75s linear infinite;
    }

    @@keyframes spinner-rotate {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 576px) {
        .location-status {
            flex-direction: column;
        }

        .location-address {
            width: 100%;
        }
    }
</style>

<form id="startForm" asp-action="Start" asp-controller="DriverTrips" asp-area="User" method="post" novalidate class="start-form-container">
    @Html.AntiForgeryToken()
    <input asp-for="TripId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-group-enhanced">
        <label asp-for="StartOdometer" class="form-label-enhanced">
            <i class="fas fa-tachometer-alt"></i>
            Start Odometer Reading (km)
        </label>
        <input asp-for="StartOdometer" class="form-control form-control-enhanced" type="number" step="0.1" placeholder="Enter current odometer reading" value="@(Model?.PreferredStartOdometer ?? Model?.StartOdometer ?? 0)" />
        <span asp-validation-for="StartOdometer" class="text-danger"></span>
        @if (Model?.CurrentVehicleMileage.HasValue == true)
        {
            <small class="form-text text-muted mt-2" style="display: block;">
                <i class="fas fa-info-circle"></i>
                Current vehicle mileage: <strong>@Model.CurrentVehicleMileage.Value km</strong> — enter a reading greater than or equal to this.
            </small>
        }
    </div>

    <div class="location-card">
        <div class="location-header">
            <div class="location-title">
                <i class="fas fa-map-marker-alt"></i>
                Current Location
            </div>
            <button type="button" class="btn-get-location" id="fillLocationBtn">
                <span id="geoBtnSpinner" class="spinner-inline" style="display: none;"></span>
                <i id="geoBtnIcon" class="fas fa-crosshairs"></i>
                <span id="geoBtnText">Get My Location</span>
            </button>
        </div>

        <div class="location-status">
            <span id="geoAccuracy" class="accuracy-badge accuracy-none">
                <i class="fas fa-circle-question"></i>
                No Location
            </span>
            <div id="geoAddress" class="location-address">
                <i class="fas fa-map-pin"></i>
                <span>Click "Get My Location" to capture your current position</span>
            </div>
        </div>

        <div id="geoMessage" class="location-message info" style="display: none;">
            <i class="fas fa-info-circle"></i>
            <span></span>
        </div>

        <input asp-for="Latitude" type="hidden" id="lat" />
        <input asp-for="Longitude" type="hidden" id="lon" />
        <input type="hidden" name="LatitudeAccuracy" id="latAcc" />
    </div>

    <div class="form-group-enhanced">
        <label asp-for="Notes" class="form-label-enhanced">
            <i class="fas fa-sticky-note"></i>
            Notes (Optional)
        </label>
        <textarea asp-for="Notes" class="form-control form-control-enhanced" rows="3" placeholder="Add any notes about trip start..."></textarea>
    </div>

    <div class="modal-actions">
        <button type="button" class="btn-cancel" data-bs-dismiss="modal">
            <i class="fas fa-times"></i>
            Cancel
        </button>
        <button type="submit" class="btn-submit-start">
            <i class="fas fa-play"></i>
            Start Trip Now
        </button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            let isLocating = false;

            function setGeoSpinner(on) {
                isLocating = on;
                $('#geoBtnSpinner').toggle(on);
                $('#geoBtnIcon').toggle(!on);
                $('#geoBtnText').text(on ? 'Locating...' : 'Get My Location');
                $('#fillLocationBtn').prop('disabled', on);
            }

            function setGeoAccuracy(accuracy) {
                const $badge = $('#geoAccuracy');
                $badge.removeClass('accuracy-excellent accuracy-good accuracy-fair accuracy-poor accuracy-none');

                if (accuracy === null) {
                    $badge.addClass('accuracy-none');
                    $badge.html('<i class="fas fa-circle-question"></i> No Location');
                } else if (accuracy <= 10) {
                    $badge.addClass('accuracy-excellent');
                    $badge.html('<i class="fas fa-check-circle"></i> Excellent (±' + Math.round(accuracy) + 'm)');
                } else if (accuracy <= 50) {
                    $badge.addClass('accuracy-good');
                    $badge.html('<i class="fas fa-check-circle"></i> Good (±' + Math.round(accuracy) + 'm)');
                } else if (accuracy <= 100) {
                    $badge.addClass('accuracy-fair');
                    $badge.html('<i class="fas fa-exclamation-circle"></i> Fair (±' + Math.round(accuracy) + 'm)');
                } else {
                    $badge.addClass('accuracy-poor');
                    $badge.html('<i class="fas fa-exclamation-triangle"></i> Poor (±' + Math.round(accuracy) + 'm)');
                }
            }

            function setGeoAddress(address) {
                const $addressDiv = $('#geoAddress');
                if (address) {
                    $addressDiv.html('<i class="fas fa-map-pin"></i> <span>' + address + '</span>');
                } else {
                    $addressDiv.html('<i class="fas fa-map-pin"></i> <span>Address unavailable</span>');
                }
            }

            function showGeoMessage(text, type) {
                const $msg = $('#geoMessage');
                const icons = {
                    'info': 'fa-info-circle',
                    'error': 'fa-exclamation-triangle',
                    'success': 'fa-check-circle'
                };

                $msg.removeClass('info error success').addClass(type);
                $msg.find('i').removeClass().addClass('fas ' + icons[type]);
                $msg.find('span').text(text);
                $msg.show();
            }

            function hideGeoMessage() {
                $('#geoMessage').hide();
            }

            async function reverseGeocode(lat, lon) {
                try {
                    const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`;
                    const resp = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'User-Agent': 'FleetManager/1.0'
                        }
                    });
                    if (!resp.ok) return null;
                    const data = await resp.json();
                    console.log('Reverse geocode data:', data);
                    return data.display_name || null;
                } catch (e) {
                    console.error('Reverse geocode failed:', e);
                    return null;
                }
            }

            async function attemptGeolocation() {
                if (!navigator.geolocation) {
                    showGeoMessage('Geolocation is not supported by your browser', 'error');
                    return;
                }

                setGeoSpinner(true);
                showGeoMessage('Requesting your location...', 'info');

                navigator.geolocation.getCurrentPosition(
                    async function (pos) {
                        const lat = pos.coords.latitude;
                        const lon = pos.coords.longitude;
                        const acc = pos.coords.accuracy || 0;

                        $('#lat').val(lat);
                        $('#lon').val(lon);
                        $('#latAcc').val(acc);

                        setGeoSpinner(false);
                        setGeoAccuracy(acc);

                        showGeoMessage('Location captured successfully!', 'success');

                        setGeoAddress('Loading address...');
                        const address = await reverseGeocode(lat, lon);
                        setGeoAddress(address || 'Address lookup failed');

                        setTimeout(hideGeoMessage, 3000);
                    },
                    function (err) {
                        setGeoSpinner(false);
                        setGeoAccuracy(null);

                        let msg = 'Could not get your location';
                        if (err.code === 1) msg = 'Location permission denied. Please enable location access.';
                        else if (err.code === 2) msg = 'Location unavailable. Make sure GPS is enabled and try again.';
                        else if (err.code === 3) msg = 'Location request timed out. Please try again.';

                        showGeoMessage(msg, 'error');
                        setGeoAddress('Click "Get My Location" to capture your current position');
                    },
                    { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
                );
            }

            // ✅ This is what gets called from your parent view
            window.bindStartForm = function () {
                console.log('bindStartForm called — initializing geolocation');

                // Automatically trigger first location attempt
                setTimeout(attemptGeolocation, 500);

                // Bind click event for manual location refresh
                $(document)
                    .off('click.startGeo', '#fillLocationBtn')
                    .on('click.startGeo', '#fillLocationBtn', function (e) {
                        e.preventDefault();
                        if (!isLocating) attemptGeolocation();
                    });
            };
        })();
    </script>
}
























