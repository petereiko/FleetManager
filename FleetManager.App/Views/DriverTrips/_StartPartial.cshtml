function setGeoSpinner(on) { $('#geoBtnSpinner').toggleClass('visually-hidden', !on); $('#geoBtnText').text(on ? 'Locating…' : 'Use my location'); }
function setGeoAccuracyText(txt, isErr) { $('#geoAccuracy').text(txt).toggleClass('bg-danger', isErr).toggleClass('bg-secondary', !isErr); }
function setGeoStatus(txt, isErr) { $('#geoStatus').text(txt).toggleClass('text-danger', isErr).toggleClass('text-muted', !isErr); }
