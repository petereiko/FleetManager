        font-weight: 600;
        color: #1e293b;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .documents-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .document-item {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 1px solid #f1f5f9;
    }

        .document-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
        }

    .document-preview {
        height: 200px;
        background: #f8fafc;
        display: flex;
        align-items: center;
