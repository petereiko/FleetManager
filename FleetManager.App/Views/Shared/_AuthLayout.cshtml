@using FleetManager.Business.ViewModels;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    @await Html.PartialAsync("_Favicons")
    <title>Fleetalia - Your solution to manage your fleet of vehicles</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/feather.css">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:        #1B2856;
            --navy-deep:   #0e1730;
            --navy-mid:    #223068;
            --green:       #00664c;
            --green-light: #00875f;
            --green-pale:  #6ee7b7;
            --white:       #ffffff;
            --surface:     #f7f8fa;
            --border:      #e2e4e8;
            --border-mid:  #d0d4dc;
            --dark:        #1a1c20;
            --dark-60:     rgba(26,28,32,0.60);
            --dark-35:     rgba(26,28,32,0.35);
            --danger:      #c0392b;
            --danger-bg:   #fdf2f2;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
            background: var(--surface);
        }

        /* ════════════════════════════════
           ROOT — two columns, full height
        ════════════════════════════════ */
        .auth-root {
            display: flex;
            min-height: 100vh;
        }

        /* ════════════════════════════════
           LEFT PANEL — marketing / brand
        ════════════════════════════════ */
        .auth-panel-left {
            flex: 0 0 54%;
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--navy-deep);
        }

        /* Background photo */
        .apl-photo {
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=1400&q=80&auto=format&fit=crop&crop=center');
            background-size: cover;
            background-position: center;
            opacity: 0.17;
        }

        /* Deep gradient over photo */
        .apl-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                150deg,
                rgba(14,23,48,0.98)   0%,
                rgba(27,40,86,0.93)   48%,
                rgba(0,70,52,0.78)   100%
            );
        }

        /* Dot grid */
        .apl-dots {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.035) 1px, transparent 1px);
            background-size: 26px 26px;
            pointer-events: none;
        }

        /* Decorative rings */
        .apl-ring {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .apl-ring-a {
            width: 560px; height: 560px;
            top: -190px; right: -170px;
            border: 1px solid rgba(0,135,95,0.12);
            animation: ring-rotate 35s linear infinite;
        }

        .apl-ring-b {
            width: 340px; height: 340px;
            bottom: -100px; left: -110px;
            border: 1px solid rgba(255,255,255,0.05);
            animation: ring-rotate 24s linear infinite reverse;
        }

        .apl-ring-c {
            width: 130px; height: 130px;
            top: 44%; right: 10%;
            background: rgba(0,102,76,0.09);
            border: 1px solid rgba(0,135,95,0.18);
            animation: ring-float 7s ease-in-out infinite;
        }

        @@keyframes ring-rotate { to { transform: rotate(360deg); } }
        @@keyframes ring-float  {
            0%,100% { transform: translateY(0) rotate(0deg);    }
            50%     { transform: translateY(-16px) rotate(9deg); }
        }

        /* Content */
        .apl-body {
            position: relative;
            z-index: 3;
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 44px 52px 48px;
        }

        /* Logo */
        .apl-logo img {
            height: 46px;
            width: auto;
            display: block;
            animation: logo-pulse 3.5s ease-in-out infinite alternate;
        }

        @@keyframes logo-pulse {
            from { filter: brightness(1.0) drop-shadow(0 2px 8px  rgba(0,135,95,0.20)); }
            to   { filter: brightness(1.14) drop-shadow(0 4px 22px rgba(0,135,95,0.52)); }
        }

        /* Push hero down */
        .apl-hero { margin-top: auto; }

        /* Tag pill */
        .apl-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(0,102,76,0.18);
            border: 1px solid rgba(0,135,95,0.30);
            border-radius: 99px;
            padding: 5px 14px 5px 10px;
            font-size: 10.5px;
            font-weight: 700;
            color: var(--green-pale);
            letter-spacing: 0.09em;
            text-transform: uppercase;
            margin-bottom: 22px;
        }

        .apl-tag .dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            background: #22c55e;
            animation: dot-blink 1.8s ease-in-out infinite;
        }

        @@keyframes dot-blink {
            0%,100% { opacity: 1; }
            50%      { opacity: 0.3; }
        }

        /* Headline */
        .apl-headline {
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 3rem;
            font-weight: 400;
            line-height: 1.18;
            color: #fff;
            margin-bottom: 18px;
            letter-spacing: -0.015em;
        }

        .apl-headline em {
            font-style: italic;
            color: var(--green-pale);
        }

        /* Sub text */
        .apl-subtext {
            font-size: 14.5px;
            color: rgba(255,255,255,0.55);
            line-height: 1.68;
            max-width: 440px;
            margin-bottom: 32px;
            font-weight: 400;
        }

        /* Photo strip */
        .apl-strip {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
        }

        .apl-thumb {
            flex: 1;
            height: 80px;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(255,255,255,0.07);
        }

        .apl-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.72;
            transition: opacity 0.3s ease, transform 0.4s ease;
            display: block;
        }

        .apl-thumb:hover img { opacity: 0.92; transform: scale(1.07); }

        .apl-thumb-lbl {
            position: absolute;
            bottom: 7px; left: 9px;
            font-size: 9px;
            font-weight: 700;
            color: rgba(255,255,255,0.88);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            text-shadow: 0 1px 4px rgba(0,0,0,0.6);
        }

        /* Feature rows */
        .apl-features {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 36px;
        }

        .apl-feat {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .apl-feat-ico {
            width: 36px; height: 36px;
            border-radius: 9px;
            background: rgba(0,102,76,0.18);
            border: 1px solid rgba(0,135,95,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .apl-feat-ico i {
            font-size: 14px;
            color: var(--green-pale);
        }

        .apl-feat-text strong {
            display: block;
            font-size: 13.5px;
            font-weight: 600;
            color: #fff;
            line-height: 1.25;
        }

        .apl-feat-text span {
            font-size: 12px;
            color: rgba(255,255,255,0.43);
        }

        /* Stats bar */
        .apl-stats {
            display: flex;
            gap: 32px;
            padding-top: 26px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .apl-stat-val {
            display: block;
            font-family: 'DM Mono', monospace;
            font-size: 21px;
            font-weight: 500;
            color: #fff;
            line-height: 1;
            margin-bottom: 4px;
        }

        .apl-stat-lbl {
            font-size: 10.5px;
            color: rgba(255,255,255,0.38);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 600;
        }

        /* ════════════════════════════════
           RIGHT PANEL — form slot
        ════════════════════════════════ */
        .auth-panel-right {
            flex: 0 0 46%;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-y: auto;
            position: relative;
        }

        /* Subtle corner accent */
        .auth-panel-right::before {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 220px; height: 220px;
            background: radial-gradient(circle at top right, rgba(27,40,86,0.04), transparent 70%);
            pointer-events: none;
        }

        .auth-form-slot {
            width: 100%;
            max-width: 408px;
            padding: 48px 24px;
        }

        /* ════════════════════════════════
           FLASH TOASTS (TempData)
        ════════════════════════════════ */
        .auth-flash {
            position: fixed;
            top: 18px;
            right: 18px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 340px;
        }

        .auth-flash .alert {
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13.5px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 9px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.12);
            animation: flash-slide 0.3s ease both;
        }

        @@keyframes flash-slide {
            from { opacity: 0; transform: translateX(24px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ════════════════════════════════
           RESPONSIVE
        ════════════════════════════════ */
        @@media (max-width: 960px) {
            body, html { height: auto; overflow: auto; }
            .auth-root          { flex-direction: column; min-height: 100vh; }
            .auth-panel-left    { flex: 0 0 auto; min-height: 320px; }
            .auth-panel-right   { flex: 1; padding: 20px; }
            .apl-body           { padding: 28px 28px 36px; }
            .apl-stats          { display: none; }
            .apl-strip          { display: none; }
            .apl-headline       { font-size: 2.2rem; }
            .auth-form-slot     { padding: 32px 16px; }
        }

        @@media (max-width: 576px) {
            .apl-features       { gap: 10px; }
            .apl-subtext        { font-size: 13.5px; }
            .auth-form-slot     { padding: 24px 12px; }
        }
    </style>
</head>

<body>

    <!-- Flash messages -->
    <div class="auth-flash">
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="alert-success" class="alert alert-success alert-dismissible d-flex align-items-center" role="alert">
                <i class="fas fa-check-circle"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="alert-error" class="alert alert-danger alert-dismissible d-flex align-items-center" role="alert">
                <i class="fas fa-times-circle"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div id="alert-warning" class="alert alert-warning alert-dismissible d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div id="alert-info" class="alert alert-info alert-dismissible d-flex align-items-center" role="alert">
                <i class="fas fa-info-circle"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <div class="auth-root">

        <!-- ══════════════════════════
             LEFT  — Brand / Marketing
        ══════════════════════════ -->
        <div class="auth-panel-left">
            <div class="apl-photo"></div>
            <div class="apl-overlay"></div>
            <div class="apl-dots"></div>
            <div class="apl-ring apl-ring-a"></div>
            <div class="apl-ring apl-ring-b"></div>
            <div class="apl-ring apl-ring-c"></div>

            <div class="apl-body">

                <!-- Logo top-left -->
                <div class="apl-logo">
                    <img src="~/assets/img/FULL-WHITE-AND-GREEN-LOGO.png" alt="Fleetalia">
                </div>

                <!-- Hero block anchored to bottom -->
                <div class="apl-hero">

                    <div class="apl-tag">
                        <span class="dot"></span>
                        Trusted Fleet Management Platform
                    </div>

                    <h2 class="apl-headline">
                        Your entire fleet,<br>
                        <em>perfectly managed.</em>
                    </h2>

                    <p class="apl-subtext">
                        From driver assignments to live tracking, fuel logs to maintenance records.
                        Fleetalia gives you complete visibility and control over every vehicle in your
                        fleet, all from one powerful dashboard.
                    </p>

                    <!-- 3 real stock photo thumbnails -->
                    <div class="apl-strip">
                        <div class="apl-thumb">
                            <img src="~/assets/img/track.jpg" alt="Live Tracking">
                            <span class="apl-thumb-lbl">Live Tracking</span>
                        </div>
                        <div class="apl-thumb">
                            <img src="~/assets/img/fleet.jpg" alt="Fleet Vehicles">
                            <span class="apl-thumb-lbl">Fleet Vehicles</span>
                        </div>
                        <div class="apl-thumb">
                            <img src="~/assets/img/analytics.jpg" alt="Analytics">
                            <span class="apl-thumb-lbl">Analytics</span>
                        </div>
                    </div>

                    <!-- 4 feature rows -->
                    <div class="apl-features">
                        <div class="apl-feat">
                            <div class="apl-feat-ico"><i class="fa-solid fa-location-dot"></i></div>
                            <div class="apl-feat-text">
                                <strong>Real-time GPS Tracking</strong>
                                <span>Monitor every vehicle live via web or mobile app</span>
                            </div>
                        </div>
                        <div class="apl-feat">
                            <div class="apl-feat-ico"><i class="fa-solid fa-id-card"></i></div>
                            <div class="apl-feat-text">
                                <strong>Driver Management</strong>
                                <span>Assign trips, track duty hours and compliance</span>
                            </div>
                        </div>
                        <div class="apl-feat">
                            <div class="apl-feat-ico"><i class="fa-solid fa-gas-pump"></i></div>
                            <div class="apl-feat-text">
                                <strong>Fuel & Expense Logs</strong>
                                <span>Automated cost tracking and vendor billing</span>
                            </div>
                        </div>
                        <div class="apl-feat">
                            <div class="apl-feat-ico"><i class="fa-solid fa-wrench"></i></div>
                            <div class="apl-feat-text">
                                <strong>Maintenance Scheduling</strong>
                                <span>Service reminders, repair tickets and history</span>
                            </div>
                        </div>
                    </div>

                    <!-- Stats row -->
                    <div class="apl-stats">
                        <div>
                            <span class="apl-stat-val">2,400+</span>
                            <span class="apl-stat-lbl">Vehicles Managed</span>
                        </div>
                        <div>
                            <span class="apl-stat-val">99.9%</span>
                            <span class="apl-stat-lbl">Uptime SLA</span>
                        </div>
                        <div>
                            <span class="apl-stat-val">150+</span>
                            <span class="apl-stat-lbl">Companies</span>
                        </div>
                    </div>

                </div><!-- /apl-hero -->
            </div><!-- /apl-body -->
        </div><!-- /auth-panel-left -->

        <!-- ══════════════════════════
             RIGHT — Form (view renders here)
        ══════════════════════════ -->
        <div class="auth-panel-right">
            <div class="auth-form-slot">
                @RenderBody()
            </div>
        </div>

    </div><!-- /auth-root -->

    <!-- jQuery must come before Bootstrap + validation -->
    <script src="~/assets/js/jquery-3.7.1.min.js"></script>

    <!-- jQuery validation (needed for asp-for form validation) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/feather.min.js"></script>
    <script src="~/assets/js/app.js"></script>

    <script>
        window.addEventListener('DOMContentLoaded', function () {
            // Auto-dismiss flash alerts
            ['success','error','warning','info'].forEach(function (t) {
                var el = document.getElementById('alert-' + t);
                if (el) setTimeout(function () {
                    bootstrap.Alert.getOrCreateInstance(el).close();
                }, 5000);
            });

            // Feather icons
            if (typeof feather !== 'undefined') feather.replace();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
