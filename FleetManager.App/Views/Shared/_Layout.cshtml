    <script>
                (function () {

            // 30 minutes
            const inactivityLimit = 30 * 60 * 1000;
            let inactivityTimer;

            function logout(reason) {
                window.location.href = "/Account/Login?sessionExpired=true";
            }

            function resetTimer() {
                clearTimeout(inactivityTimer);
                inactivityTimer = setTimeout(logout, inactivityLimit);
            }

            ["click","mousemove","keydown","scroll"].forEach(evt =>
                document.addEventListener(evt, resetTimer)
            );

            resetTimer();

            // Server-side enforcement (every 60s)
            setInterval(() => {
                fetch('/Account/ValidateSession')
                    .then(r => {
                        if (!r.ok) logout();
                    })
                    .catch(logout);
            }, 60000);

        })();
    </script>



